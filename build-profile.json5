{
  "app": {
    // Signing materials live under ./signing/ (gitignored). DevEco-compatible
    // encrypted debug passwords are stored here because hvigorw does not resolve
    // ${VAR} placeholders in signingConfigs.material. Regenerate local debug
    // materials and ciphertext with scripts/gen-debug-signing.sh plus
    // scripts/encrypt-signing-pwds.mjs; production signing uses separate assets.
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "/Users/minliny/.ohos/config/default_Reader-for-HarmonyOS_g2wzCxdhuuosQAHMRq5n3M-e6Kwm_JwC4MxeHjSHNMI=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001B1CE0255F69DD37C0BE1CCFFF1E54726147C44C8EC8D2D445BD20348A19879B252010CE17A81DA2",
          "profile": "/Users/minliny/.ohos/config/default_Reader-for-HarmonyOS_g2wzCxdhuuosQAHMRq5n3M-e6Kwm_JwC4MxeHjSHNMI=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "/Users/minliny/.ohos/config/default_Reader-for-HarmonyOS_g2wzCxdhuuosQAHMRq5n3M-e6Kwm_JwC4MxeHjSHNMI=.p12",
          "storePassword": "0000001B445B0EC4459C85C329A8B96D92D0C26C458B36903D0F09FF4099920FA299D70E2262B5C4E56926"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "targetSdkVersion": "6.0.2(22)",
        "compatibleSdkVersion": "6.0.2(22)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    "capabilities": [
      {
        "bundleName": "com.minliny.reader",
        "config": [
          {
            "name": "Push Kit",
            "capability": "com.huawei.service.push.base_service"
          },
          {
            "name": "Device status detection",
            "capability": "com.huawei.service.device_security.device_verify"
          }
        ]
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "reader_ui_runtime",
      "srcPath": "../Reader-UI/packages/arkts/reader-ui-runtime",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
