{
  "name": "reader-for-harmonyos",
  "version": "1.0.0",
  "ohos": {
    "org": "huawei",
    "buildTool": "hvigor",
    "directoryLevel": "project"
  },
  "description": "Reader for HarmonyOS — ArkUI native host with Reader UI mixed rollout and Core NAPI integration",
  "repository": {},
  "license": "ISC",
  "scripts": {
    "gen:contracts": "node scripts/gen_contracts.mjs",
    "sync:screen-graph": "node scripts/sync_reader_ui_screen_graph.mjs",
    "check:screen-graph": "node scripts/sync_reader_ui_screen_graph.mjs --check",
    "test:reader-ui-release-lock": "node --test scripts/reader_ui_release_lock.test.mjs",
    "test:slice9-host": "node --test scripts/slice9_host_contract.test.mjs",
    "test:slice10": "node --test scripts/slice10_contract.test.mjs",
    "test:slice11": "node --test scripts/slice11_contract.test.mjs",
    "test:slice12": "node --test scripts/slice12_contract.test.mjs",
    "lint:tokens": "node scripts/lint_tokens.mjs",
    "check:figma-live-source": "node scripts/verify_figma_live_source_snapshot.mjs",
    "check:figma-shadow-allowlist": "node scripts/check_figma_shadow_allowlist.mjs",
    "check:reader-ui-consumer": "node ../Reader-UI/tools/runtime/check-host-consumers.mjs --host harmonyos && node scripts/check_reader_ui_shadow_allowlist.mjs && node scripts/check_figma_shadow_allowlist.mjs && npm run check:figma-live-source && npm run test:reader-ui-release-lock && npm run check:screen-graph",
    "build": "hvigorw assembleHap --no-daemon",
    "test:arkts-compile": "node scripts/test.mjs",
    "test:arkts-device": "node scripts/run_ohos_device_tests.mjs",
    "test:static": "npm run lint:tokens && node --test scripts/test_contracts.mjs && npm run check:reader-ui-consumer && npm run test:device-evidence-script && npm run test:arkts-compile",
    "test": "npm run test:static && npm run test:arkts-device",
    "test:host": "npm run test:static",
    "check:device-signing": "node scripts/check_device_signing_profile.mjs --require-device",
    "test:device": "npm run check:device-signing && node scripts/collect_device_evidence.mjs --install --require-core-napi",
    "test:device-evidence-script": "node --test scripts/device_evidence_install_result.test.mjs scripts/device_signing_profile.test.mjs",
    "test:raw": "hvigorw onDeviceTest --mode module -p module=entry@default --no-daemon",
    "evidence": "node scripts/collect_device_evidence.mjs",
    "provenance:prepare": "node scripts/generate_hap_provenance.mjs --prepare",
    "provenance:finalize": "node scripts/generate_hap_provenance.mjs --finalize",
    "provenance:verify": "node scripts/generate_hap_provenance.mjs --verify"
  },
  "dependencies": {
    "@ohos/hvigor": "6.22.7",
    "@ohos/hvigor-ohos-plugin": "6.22.7"
  }
}
