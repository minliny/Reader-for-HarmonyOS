{
  "$id": "reader-ui-phase0-v1",
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9._:-]{1,128}$" },
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["path","bytes","sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "id-list": {
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" }
    },
    "predicate-list": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": {
          "kind": { "$ref": "#/$defs/id" },
          "match": { "enum": ["occurrence", "latest"] },
          "channel": { "enum": ["input", "business", "motion", "probe"] },
          "fields": {
            "type": "object", "minProperties": 1,
            "propertyNames": { "pattern": "^payload(\\.[a-zA-Z][a-zA-Z0-9_]*)+$" },
            "additionalProperties": {
              "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }, { "type": "null" }]
            }
          }
        }
      }
    },
    "drag-speed": { "type": "integer", "minimum": 200, "maximum": 40000 },
    "point-fraction": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 }
    },
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["id","description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "inputWord": { "const": "Reader" },
        "publicSources": { "const": true },
        "publicDocument": {
          "type": "object", "additionalProperties": false, "required": ["basename","sha256"],
          "properties": {
            "basename": {"const": "reader-phase1-status-research-source.json"},
            "sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "inputs": {
          "type": "object", "minProperties": 1, "maxProperties": 12,
          "propertyNames": { "$ref": "#/$defs/id" },
          "properties": {
            "reserved-source-host": { "const": "source-01.reader-phase1.invalid" }
          },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[\\p{L}\\p{N}]{1,64}$" }
        },
        "bookTitle": { "type": "string", "minLength": 1, "maxLength": 128 },
        "onlineResultTitles": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["cedar","maple"],
              "properties": {
                "cedar": {"const": "Reader Phase 1 Online Cedar"},
                "maple": {"const": "Reader Phase 1 Online Maple"}
              }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["recovery"],
              "properties": {
                "recovery": {"const": "Reader Phase 1 公共长目录（重试恢复）"}
              }
            }
          ]
        },
        "bookTitles": {
          "type": "object", "minProperties": 1, "maxProperties": 8,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,23}$" },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id","kind","anchors"],
          "properties": {
            "kind": { "enum": ["sample","locate"] }, "id": { "$ref": "#/$defs/id" },
            "anchors": { "$ref": "#/$defs/id-list" }, "anyAnchor": { "$ref": "#/$defs/id-list" },
            "focus": { "$ref": "#/$defs/id" }, "keyboard": { "type": "boolean" },
            "book": { "type": "boolean" },
            "afterAction": { "$ref": "#/$defs/id" }, "waitFor": { "$ref": "#/$defs/predicate-list" },
            "captureGuard": { "enum": ["search-active-stop","source-document-picker","source-transient-status"] },
            "nativeImeKey": { "enum": ["huawei-search-1280x2832","huawei-directory-hide"] },
            "quietMs": { "type": "integer", "minimum": 125, "maximum": 3000 },
            "stateWaitMs": { "type": "integer", "minimum": 20000, "maximum": 120000 },
            "stateWaitSource": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id","kind","op","from"],
          "properties": {
            "id": { "$ref": "#/$defs/id" }, "kind": { "const": "action" },
            "op": { "enum": ["click","inputText","keyEvent","swipe","drag","grabberReversal","clickThenBack","clickThenReaderCenter","tapImeSearch","tapImeHide"] }, "from": { "$ref": "#/$defs/id" },
            "target": {
              "oneOf": [
                { "$ref": "#/$defs/id" },
                { "$ref": "#/$defs/id-list" },
                {
                  "type": "object", "additionalProperties": false, "required": ["id"],
                  "properties": { "id": { "$ref": "#/$defs/id" }, "ancestors": { "$ref": "#/$defs/id-list" } }
                },
                {
                  "type": "object", "additionalProperties": false, "required": ["publicBookTitle"],
                  "properties": { "publicBookTitle": { "type": "string", "minLength": 1, "maxLength": 128 } }
                }
              ]
            },
            "gesture": { "type": "boolean" }, "wait": { "$ref": "#/$defs/id-list" },
            "tapEdge": { "enum": ["top","bottom","left","right"] },
            "requireFullContainment": { "const": true },
            "buttonSemantic": { "enum": ["search", "stop"] },
            "waitFor": { "$ref": "#/$defs/predicate-list" },
            "beforeEvent": { "$ref": "#/$defs/predicate-list" },
            "inputRole": { "$ref": "#/$defs/id" }, "key": { "enum": ["Back","Enter"] },
            "reversalReference": { "$ref": "#/$defs/id" },
            "path": {
              "oneOf": [
                {
                  "type": "object", "additionalProperties": false, "required": ["from","to","speed"],
                  "properties": {
                    "from": { "$ref": "#/$defs/point-fraction" }, "to": { "$ref": "#/$defs/point-fraction" },
                    "endTarget": { "$ref": "#/$defs/id" }, "speed": { "$ref": "#/$defs/drag-speed" }
                  }
                },
                {
                  "type": "object", "additionalProperties": false, "required": ["calibrationSample","speed"],
                  "properties": {
                    "calibrationSample": { "$ref": "#/$defs/id" }, "speed": { "$ref": "#/$defs/drag-speed" }
                  }
                },
                {
                  "type": "object", "additionalProperties": false, "required": ["calibrationSample","transport","keepMs","moveMs"],
                  "properties": {
                    "calibrationSample": { "$ref": "#/$defs/id" }, "transport": { "const": "uinput" },
                    "keepMs": { "const": 100 }, "moveMs": { "const": 900 }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id","version","pageId","fixture","steps","assertions","ownerSources"],
      "properties": {
        "phase": { "enum": [1, 2] },
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "pageId": { "$ref": "#/$defs/id" },
        "fixture": { "$ref": "#/$defs/fixture" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
        "structure": {
          "type":"object", "minProperties":1,
          "propertyNames": { "$ref":"#/$defs/id" },
          "additionalProperties": { "$ref":"#/$defs/id" }
        },
        "ownerSources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^entry/src/main/ets/" } },
        "assertions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id","evaluator","kind","expected","source","sources"],
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "kind": { "$ref": "#/$defs/id" },
              "evaluator": { "enum": ["layout","search","motion","source"] },
              "source": { "type": "string", "minLength": 1 },
              "expected": true,
              "required": { "type": "boolean" }, "condition": { "type": "string", "minLength": 1 },
              "sources": {
                "type": "array", "minItems": 1, "uniqueItems": true,
                "items": { "enum": ["native-tree","window-metrics","app-input","app-owner","debug-frame"] }
              }
            }
          }
        }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["instanceId","eventSeq","semanticSeq","deviceMonoMs","windowRevision","kind","channel","payload"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/id" },
        "eventSeq": { "type": "integer", "minimum": 1 },
        "semanticSeq": { "type": "integer", "minimum": 0 },
        "deviceMonoMs": { "type": "number", "minimum": 0 },
        "windowRevision": { "type": "integer", "minimum": 0 },
        "kind": { "$ref": "#/$defs/id" },
        "channel": { "enum": ["input","business","motion","probe"] },
        "payload": { "type": "object" }
      }
    },
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["runId","platform","instanceId","result","commands","chain","reason","fixture"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "platform": { "const": "harmonyos" },
        "instanceId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "result": { "enum": ["COMPLETED","INCOMPLETE"] },
        "reason": { "type": ["string","null"] },
        "commands": { "$ref": "#/$defs/ref" },
        "fixture": { "$ref": "#/$defs/ref" },
        "runner": {
          "type": "object", "additionalProperties": false, "required": ["manifest","verification","deployment"],
          "properties": {
            "manifest": { "$ref": "#/$defs/ref" },
            "verification": { "$ref": "#/$defs/ref" },
            "deployment": { "$ref": "#/$defs/ref" }
          }
        },
        "chain": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["index","previous","entry","sha256"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "previous": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
              "entry": { "type": "object" },
              "sha256": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema","runId","case","caseId","caseVersion","caseSha256","tool","candidate","session","chainTail",
        "assertions","observations","behavior","execution","page","capabilities","coverage","diagnostics","measurement"],
      "properties": {
        "schema": { "const": "reader-ui-receipt-v1" },
        "runId": { "$ref": "#/$defs/id" },
        "case": { "$ref": "#/$defs/ref" },
        "caseId": { "$ref": "#/$defs/id" },
        "caseVersion": { "type": "integer", "minimum": 1 },
        "caseSha256": { "$ref": "#/$defs/digest" },
        "tool": { "type": "object", "required": ["version","sha256"], "properties": {
          "version": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/digest" }
        } },
        "candidate": { "type": "object", "required": ["manifest","deployment","snapshot","ownerSources","identity"],
          "properties": {
            "manifest": { "$ref": "#/$defs/ref" }, "deployment": { "$ref": "#/$defs/ref" },
            "snapshot": { "$ref": "#/$defs/ref" },
            "ownerSources": { "type": "object", "additionalProperties": { "$ref": "#/$defs/ref" } },
            "identity": {
              "type": "object", "additionalProperties": false,
              "required": ["appBuildId","appContentHash","hapSha256","sourceFingerprint","buildRunId","hdcServer","targetRef","targetKind"],
              "properties": {
                "appBuildId": { "$ref": "#/$defs/id" },
                "appContentHash": { "$ref": "#/$defs/digest" },
                "hapSha256": { "$ref": "#/$defs/digest" },
                "sourceFingerprint": { "$ref": "#/$defs/digest" },
                "buildRunId": { "$ref": "#/$defs/id" },
                "hdcServer": { "enum": ["127.0.0.1:8710","192.168.1.10:8710"] },
                "targetRef": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
                "targetKind": { "enum": ["vm","physical"] }
              }
            }
          }
        },
        "session": { "$ref": "#/$defs/ref" },
        "chainTail": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "assertions": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id","actual","expected","verdict","reason","evidenceRefs"],
            "properties": {
              "id": { "$ref": "#/$defs/id" }, "actual": true, "expected": true,
              "verdict": { "enum": ["PASS","FAIL","NOT_RUN"] }, "reason": { "type": "string" },
              "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
            }
          }
        },
        "structure": {
          "type":"object", "additionalProperties":false,
          "required":["definitionSha256","bindingSha256","observations","behavior","states"],
          "properties":{
            "definitionSha256":{"$ref":"#/$defs/digest"},
            "bindingSha256":{"$ref":"#/$defs/digest"},
            "observations":{"enum":["COMPLETE","INCOMPLETE"]},
            "behavior":{"enum":["PASS","FAIL","NOT_RUN"]},
            "states":{"type":"array","minItems":1,"items":{
              "type":"object", "additionalProperties":false,
              "required":["role","ruleId","sampleId","actionId","verdict","observationsComplete","checks"],
              "properties":{
                "role":{"$ref":"#/$defs/id"},"ruleId":{"$ref":"#/$defs/id"},"sampleId":{"$ref":"#/$defs/id"},
                "actionId":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},
                "conditionId":{"$ref":"#/$defs/id"},
                "verdict":{"enum":["PASS","FAIL","NOT_RUN"]},"observationsComplete":{"type":"boolean"},
                "checks":{"type":"array","minItems":1,"items":{
                  "type":"object", "additionalProperties":false,
                  "required":["ruleId","requiredRuleIds","verdict","observationsComplete","actual","expected","reason","evidenceRefs"],
                  "properties":{
                    "ruleId":{"$ref":"#/$defs/id"},
                    "requiredRuleIds":{"$ref":"#/$defs/id-list"},
                    "verdict":{"enum":["PASS","FAIL","NOT_RUN"]},"observationsComplete":{"type":"boolean"},
                    "actual":true,"expected":true,"reason":{"type":"string"},
                    "evidenceRefs":{"type":"array","items":{"$ref":"#/$defs/ref"}}
                  }
                }}
              }
            }}
          }
        },
        "conditions": {
          "type":"object",
          "propertyNames":{"$ref":"#/$defs/id"},
          "additionalProperties":{
            "type":"object","additionalProperties":false,"required":["status","required","reason"],
            "properties":{
              "status":{"enum":["APPLIES","DOES_NOT_APPLY","UNKNOWN"]},
              "required":{"type":"boolean"},"reason":{"type":"string"},"sampleApplies":{"type":"boolean"}
            }
          }
        },
        "observations": { "enum": ["COMPLETE","INCOMPLETE"] },
        "behavior": { "enum": ["PASS","FAIL","NOT_RUN"] },
        "execution": { "enum": ["PASS","FAIL","INCOMPLETE"] },
        "page": { "type": "object" },
        "capabilities": { "type": "object" },
        "coverage": { "type": "object" },
        "measurement": { "type": "object" },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
