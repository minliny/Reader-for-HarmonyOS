      "keyboard": false,
      "afterAction": "leave-fixture-ime",
      "quietMs": 500
    },
    {
      "id": "scroll-shallow",
      "kind": "action",
      "op": "swipe",
      "from": "fixture-sources-ready",
      "target": "reader-source-list",
      "waitFor": [
        {
          "kind": "source.scroll",
          "fields": {
            "payload.trigger": "settled"
          }
        }
      ],
      "path": {
        "from": [
          0.48,
          0.4
        ],
        "to": [
          0.48,
          0.32
        ],
        "speed": 200
      }
    },
