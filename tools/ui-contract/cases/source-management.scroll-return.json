{
  "id": "source-management.scroll-return",
  "version": 5,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-catalog-v1",
    "description": "Isolated public VM with the phase-1 source fixture imported through the usual flow. Only its common public name prefix is selected for the bounded native long-list and tail use case. Preexisting book sources may remain in the database.",
    "publicSources": true,
    "inputs": {
      "public-source-prefix": "Phase1"
    }
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-content",
        "reader-source-search",
        "reader-source-editor",
        "reader-source-stats",
        "reader-source-category-filter",
        "reader-source-status-filter",
        "reader-source-group-filter",
        "reader-source-filter-block"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current"
          }
        }
      ],
      "quietMs": 500
    },
    {
      "kind": "action",
      "id": "focus-fixture-query",
      "op": "click",
      "from": "source-ready",
      "target": "reader-source-editor",
      "gesture": true
    },
    {
      "kind": "locate",
      "id": "fixture-query-ime",
      "anchors": [
        "reader-source-editor"
      ],
      "focus": "reader-source-editor",
      "keyboard": true,
      "afterAction": "focus-fixture-query"
    },
    {
      "kind": "action",
      "id": "select-public-fixture",
      "op": "inputText",
      "from": "fixture-query-ime",
      "target": "reader-source-editor",
      "inputRole": "public-source-prefix",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "edit",
            "payload.projected": 18,
            "payload.queryLength": 6
          }
        }
      ]
    },
    {
      "kind": "locate",
      "id": "fixture-query-edited",
      "anchors": [
        "reader-source-editor"
      ],
      "focus": "reader-source-editor",
      "keyboard": true,
      "afterAction": "select-public-fixture"
    },
    {
      "kind": "action",
      "id": "leave-fixture-ime",
      "op": "keyEvent",
      "key": "Back",
      "from": "fixture-query-edited"
    },
    {
      "kind": "sample",
      "id": "fixture-sources-ready",
      "anchors": [
        "reader-source-back",
        "reader-source-list",
        "reader-source-filter-block",
        "reader-source-editor",
        "source-category-novel",
        "reader-source-footer"
