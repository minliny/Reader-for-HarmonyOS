{
  "id": "source-management.tool-return-filters",
  "version": 2,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-tools-return-v2",
    "description": "Use the existing public catalogue without changing its rows. Search public names and domains for com, select Unchecked, Novel and the first non-default group 小说 书源, and confirm at least 15 results. Use the actual header Tools button and system Back to verify unchanged filters, scroll anchor, offset and focus.",
    "publicSources": true,
    "inputs": {
      "public-source-prefix": "com"
    }
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-content",
        "reader-source-search",
        "reader-source-editor",
        "reader-source-stats",
        "reader-source-category-filter",
        "reader-source-status-filter",
        "reader-source-group-filter",
        "reader-source-filter-block"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.queryLength": 0,
            "payload.status": "all",
            "payload.category": "all",
            "payload.groupIndex": 0,
            "payload.allGroups": true
          },
          "channel": "business",
          "match": "latest"
        }
      ],
      "quietMs": 500
    },
    {
      "kind": "action",
      "id": "focus-fixture-query",
      "op": "click",
      "from": "source-ready",
      "target": "reader-source-editor",
      "gesture": true
    },
    {
      "kind": "locate",
      "id": "fixture-query-ime",
      "anchors": [
        "reader-source-editor"
      ],
      "focus": "reader-source-editor",
      "keyboard": true,
      "afterAction": "focus-fixture-query"
    },
    {
      "kind": "action",
      "id": "select-public-fixture",
      "op": "inputText",
      "from": "fixture-query-ime",
      "target": "reader-source-editor",
      "inputRole": "public-source-prefix",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "edit",
            "payload.queryLength": 3,
            "payload.state": "rows",
            "payload.readFact": "current"
          },
          "channel": "business"
        }
      ]
    },
    {
      "kind": "locate",
      "id": "fixture-query-edited",
      "anchors": [
        "reader-source-editor"
      ],
      "focus": "reader-source-editor",
      "keyboard": true,
      "afterAction": "select-public-fixture"
    },
    {
      "kind": "action",
      "id": "leave-fixture-ime",
      "op": "keyEvent",
      "key": "Back",
      "from": "fixture-query-edited"
    },
    {
      "kind": "locate",
      "id": "query-ready",
      "afterAction": "leave-fixture-ime",
      "anchors": [
        "reader-source-status-unchecked",
        "source-category-novel"
      ],
      "keyboard": false,
      "quietMs": 250
    },
    {
      "kind": "action",
      "id": "select-unchecked",
      "op": "click",
      "from": "query-ready",
      "target": "reader-source-status-unchecked",
      "gesture": true,
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "status",
            "payload.status": "unchecked",
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.queryLength": 3
          },
          "channel": "business"
        }
      ]
    },
    {
      "kind": "locate",
      "id": "unchecked",
      "afterAction": "select-unchecked",
      "anchors": [
        "source-category-novel"
      ],
      "keyboard": false,
      "quietMs": 250
    },
    {
      "kind": "action",
      "id": "select-novel",
      "op": "click",
      "from": "unchecked",
      "target": "source-category-novel",
      "gesture": true,
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "category",
            "payload.category": "novel",
            "payload.status": "unchecked",
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.queryLength": 3
          },
          "channel": "business"
        }
      ]
    },
    {
      "kind": "locate",
      "id": "novel",
      "afterAction": "select-novel",
      "anchors": [
        "reader-source-group-trigger"
      ],
      "keyboard": false,
      "quietMs": 250
    },
    {
      "kind": "action",
      "id": "open-group",
      "op": "click",
      "from": "novel",
      "target": "reader-source-group-trigger",
      "gesture": true,
      "waitFor": [
        {
          "kind": "source.overlay",
          "fields": {
            "payload.phase": "open",
            "payload.overlay": "group"
          }
        }
      ]
    },
    {
      "kind": "sample",
      "id": "group-open",
      "afterAction": "open-group",
      "anchors": [
        "reader-source-group-panel",
        "reader-source-group-option-1"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "kind": "action",
      "id": "select-group",
      "op": "click",
      "from": "group-open",
      "target": {
        "id": "reader-source-group-option-1",
        "ancestors": [
          "reader-source-group-panel"
        ]
      },
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "group",
            "payload.groupIndex": 1,
            "payload.allGroups": false,
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.queryLength": 3
          },
          "channel": "business"
        },
        {
          "kind": "source.overlay",
          "fields": {
            "payload.phase": "dismiss",
            "payload.overlay": "group"
          }
        }
      ]
    },
    {
      "kind": "sample",
      "id": "filtered",
      "afterAction": "select-group",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-header-tools",
        "reader-source-list",
        "reader-source-content",
        "reader-source-editor",
        "reader-source-filter-block",
        "reader-source-status-filter",
        "reader-source-category-filter",
        "reader-source-group-trigger",
        "reader-source-group-filter"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "scroll-list",
      "kind": "action",
      "op": "swipe",
      "from": "filtered",
      "target": "reader-source-list",
      "waitFor": [
        {
          "kind": "source.scroll",
          "fields": {
            "payload.trigger": "settled"
          }
        }
      ],
      "path": {
        "from": [
          0.48,
          0.78
        ],
        "to": [
          0.48,
          0.25
        ],
        "speed": 1100
      }
    },
    {
      "kind": "sample",
      "id": "scrolled",
      "afterAction": "scroll-list",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-header-tools",
        "reader-source-list",
        "reader-source-header-tools-button"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "open-tools",
      "kind": "action",
      "op": "click",
      "from": "scrolled",
      "target": {
        "id": "reader-source-header-tools-button",
        "ancestors": [
          "reader-source-header-tools"
        ]
      },
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "tools",
            "payload.to": "sourceTools"
          }
        }
      ]
    },
    {
      "id": "tools",
      "kind": "sample",
      "anchors": [
        "reader-source-tools-back"
      ],
      "keyboard": false,
      "afterAction": "open-tools",
      "quietMs": 500
    },
    {
      "id": "tools-back",
      "kind": "action",
      "op": "keyEvent",
      "from": "tools",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "tools-back",
            "payload.to": "source"
          }
        }
      ],
      "key": "Back"
    },
    {
      "kind": "sample",
      "id": "restored",
      "afterAction": "tools-back",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-header-tools",
        "reader-source-list",
        "reader-source-header-tools-button"
      ],
      "keyboard": false,
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current"
          }
        },
        {
          "kind": "source.scroll",
          "fields": {
            "payload.trigger": "restored"
          }
        }
      ]
    }
  ],
