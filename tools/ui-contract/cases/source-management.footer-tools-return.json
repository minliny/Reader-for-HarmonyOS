      "kind": "action",
      "op": "keyEvent",
      "from": "tools",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "tools-back",
            "payload.to": "source"
          }
        }
      ],
      "key": "Back"
