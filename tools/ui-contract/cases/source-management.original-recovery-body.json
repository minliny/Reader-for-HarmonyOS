{
  "id": "source-management.original-recovery-body",
  "version": 1,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-read-v1",
    "description": "Enter Source Management from ordinary Settings on a public test target already retaining the blocked original operation. Observe the mounted notice when the actual native notice is folded at the current width, then use only its local Expand control. Leave the business operation untouched. Do not manufacture a recovery state or override the system font.",
    "publicSources": true
  },
  "ownerSources": [
    "entry/src/main/ets/app/ReaderOperationFacts.ts",
    "entry/src/main/ets/app/composition/ReaderSourceJourney.ets",
    "entry/src/main/ets/app/diagnostics/ReaderUIVerificationProbe.ts",
    "entry/src/main/ets/app/navigation/ReaderNavigation.ts",
    "entry/src/main/ets/features/settings/ui/SettingsPage.ets",
    "entry/src/main/ets/features/source/application/SourceGateway.ts",
    "entry/src/main/ets/features/source/application/SourceHost.ets",
    "entry/src/main/ets/features/source/application/SourceOrchestrator.ets",
    "entry/src/main/ets/features/source/presentation/SourceJourneyPresentation.ets",
    "entry/src/main/ets/features/source/ui/SourceJourneySurface.ets",
    "entry/src/main/ets/features/source/ui/SourceManagementPage.ets",
    "entry/src/main/ets/features/source/ui/SourceManagementVerification.ts",
    "entry/src/main/ets/ui/layout/ReaderPageScaffold.ets",
    "entry/src/main/ets/ui/patterns/ReaderBottomTabBar.ets",
    "entry/src/main/ets/app/ReaderPersistedReceiptProjection.ts",
    "entry/src/main/ets/app/ReaderRecoveryProjection.ts",
    "entry/src/main/ets/ui/feedback/ReaderRecoveryAction.ets",
    "entry/src/main/ets/ui/feedback/ReaderRecoveryNotice.ets",
    "entry/src/main/ets/pages/ReaderSourceTextMetrics.ets"
  ],
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "recovery-collapsed",
      "kind": "sample",
      "afterAction": "open-sources",
      "keyboard": false,
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list"
      ],
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.state": "recovery",
            "payload.recovery.branch": "original"
          }
        },
        {
          "kind": "source.recovery-title",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.branch": "original"
          }
        }
      ],
      "quietMs": 600
    },
    {
      "id": "expand-recovery",
      "kind": "action",
      "op": "click",
      "from": "recovery-collapsed",
      "target": "reader-source-original-expand",
      "beforeEvent": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.state": "recovery",
            "payload.recovery.branch": "original"
          }
        },
        {
          "kind": "source.recovery-title",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.branch": "original",
            "payload.title": "clipped"
          }
        }
      ],
      "waitFor": [
        {
          "kind": "source.recovery-body-state",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.branch": "original",
            "payload.phase": "expanded"
          }
        }
      ]
    },
    {
      "id": "recovery-expanded",
      "kind": "sample",
      "afterAction": "expand-recovery",
      "keyboard": false,
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list"
      ],
      "waitFor": [
        {
          "kind": "source.recovery-body-state",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.branch": "original",
            "payload.phase": "expanded"
          }
        },
        {
          "kind": "source.surface-text-layout",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.scope": "operation-recovery-body",
            "payload.branch": "original",
            "payload.presentation": "expanded"
          }
        }
      ],
      "quietMs": 500
    }
  ],
  "assertions": [
    {
      "id": "source.recovery.original.body-expand-target",
      "evaluator": "source",
      "kind": "recovery-native-control",
      "required": false,
      "condition": "The current source opening shows a blocked original operation with a title that needs folding at the measured native width.",
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#originalRecovery",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "action": "open-sources",
      "sample": "recovery-collapsed",
      "expected": {
        "target": "reader-source-original-expand",
        "requireNativeTouchTarget": true
      }
    },
    {
      "id": "source.recovery.original.body",
      "evaluator": "source",
      "kind": "recovery-body-text",
      "required": false,
      "condition": "The current original Source recovery notice is folded in the native window and presents its current Expand control.",
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#originalRecovery",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "entryAction": "open-sources",
      "baseline": "recovery-collapsed",
      "action": "expand-recovery",
      "sample": "recovery-expanded",
      "expected": {
        "branch": "original"
      }
    }
  ],
  "structure": {
    "recovery-collapsed": "recovery-collapsed",
    "recovery-expanded": "recovery-expanded"
  }
}
