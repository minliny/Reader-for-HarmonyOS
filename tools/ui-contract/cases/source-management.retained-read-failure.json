      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "channel": "business",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "retained-before",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-list",
        "reader-source-filter-block",
        "reader-source-footer"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current"
          }
        }
      ]
    },
    {
      "id": "return-settings",
      "kind": "action",
      "op": "keyEvent",
      "from": "retained-before",
      "key": "Back",
      "waitFor": [
        {
          "kind": "source.route",
          "channel": "business",
          "fields": {
            "payload.action": "close",
            "payload.from": "source",
            "payload.to": "settings"
          }
        }
      ]
    },
    {
      "id": "settings-return",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "return-settings"
    },
    {
      "id": "reopen-sources",
      "kind": "action",
      "op": "click",
      "from": "settings-return",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "channel": "business",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "retained-failure",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-list",
        "reader-source-filter-block",
        "reader-source-footer",
        "reader-source-retained-read-retry"
      ],
      "keyboard": false,
      "afterAction": "reopen-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.readFact": "refreshFailed"
          }
        },
        {
          "kind": "source.surface-text-layout",
          "fields": {
            "payload.scope": "retained-read-failed"
          },
          "match": "latest",
          "channel": "business"
        }
      ],
      "captureGuard": "source-transient-status"
