          "fields": {
            "payload.overlay": "group",
            "payload.phase": "open"
          }
        }
      ]
    },
    {
      "id": "group-open",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-content",
        "reader-source-group-panel",
        "reader-source-group-selected"
      ],
      "keyboard": false,
      "afterAction": "open-group",
      "quietMs": 500
    },
    {
      "id": "close-group",
      "kind": "action",
      "op": "keyEvent",
      "from": "group-open",
      "key": "Back",
      "waitFor": [
        {
          "kind": "source.overlay",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.overlay": "group",
            "payload.phase": "dismiss"
          }
        }
