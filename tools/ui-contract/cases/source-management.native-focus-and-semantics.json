          "kind": "source.route",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-content",
        "reader-source-editor",
        "reader-source-list",
        "reader-source-footer",
        "reader-source-group-trigger"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.status": "all",
            "payload.category": "all",
            "payload.groupIndex": 0,
            "payload.queryLength": 0
