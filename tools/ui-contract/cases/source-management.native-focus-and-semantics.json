      "kind": "action",
      "op": "keyEvent",
      "from": "query-ime",
      "key": "Back"
    },
    {
      "id": "query-back",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-content",
        "reader-source-editor",
        "reader-source-list",
        "reader-source-footer",
        "reader-source-group-trigger"
