      "kind": "locate",
      "keyboard": false,
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ]
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
