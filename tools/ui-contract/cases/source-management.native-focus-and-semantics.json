{
  "id": "source-management.native-focus-and-semantics",
  "phase": 1,
  "version": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-native-focus-and-semantics-v1",
    "description": "Use the isolated public Source catalog with one or more named groups, default filters and an available system IME. Focus the native query with a click, dismiss the IME, open the native group, and use system Back to verify restored focus. Send one native Enter to the already focused group trigger and verify its current selected option and a final Back. Read accessibility properties on the observed controls only. No query edit, source mutation, external request or screen reader is needed for these focus and property measurements.",
    "publicSources": true
  },
  "ownerSources": [
    "entry/src/main/ets/app/ReaderWindowCoordinator.ts",
    "entry/src/main/ets/app/composition/ReaderSourceJourney.ets",
    "entry/src/main/ets/app/diagnostics/ReaderUIVerificationProbe.ts",
    "entry/src/main/ets/app/navigation/ReaderNavigation.ts",
    "entry/src/main/ets/features/settings/ui/SettingsPage.ets",
    "entry/src/main/ets/features/source/application/SourceGateway.ts",
    "entry/src/main/ets/features/source/application/SourceHost.ets",
    "entry/src/main/ets/features/source/application/SourceOrchestrator.ets",
