{
  "id": "bookshelf.search-detail-return",
  "version": 5,
  "phase": 1,
  "pageId": "bookshelf",
  "fixture": {
    "id": "public-search-detail-return-directory-v3",
    "description": "Use the confirmed public local directory TXT and stop ongoing online work through the real in-page Stop. Open the public result in Detail, then use Back to restore the same query, native list owner and public row position.",
    "inputs": {
      "a": "公共长目录"
    },
    "bookTitle": "Reader Phase 1 公共长目录",
    "publicSources": true
  },
  "steps": [
    {
      "id": "before",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "book": true
    },
    {
      "id": "open-search",
      "kind": "action",
      "op": "click",
      "from": "before",
      "target": "reader-bookshelf-search-entry",
      "waitFor": [
        {
          "kind": "search-open-accepted"
        }
      ]
    },
    {
      "id": "ime-ready",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-field",
        "reader-bookshelf-search-submit"
      ],
      "afterAction": "open-search",
      "waitFor": [
        {
          "kind": "search-surface-settled",
          "fields": {
            "payload.mode": "input"
          },
          "match": "latest",
          "channel": "business"
        }
      ],
      "keyboard": true,
      "focus": "reader-book-search-input",
      "quietMs": 125
    },
    {
      "id": "type-a",
      "kind": "action",
      "op": "inputText",
      "from": "ime-ready",
      "target": "reader-book-search-input",
      "waitFor": [
        {
          "kind": "search-editor-edit",
          "fields": {
            "payload.length": 5
          }
        },
        {
          "kind": "search-editor-selection",
          "fields": {
            "payload.start": 5,
            "payload.end": 5
          }
        },
        {
          "kind": "search-draft-accepted",
          "fields": {
            "payload.length": 5
          }
        }
      ],
      "inputRole": "a"
    },
    {
      "id": "submit-a-ready",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-submit"
      ],
      "afterAction": "type-a",
      "keyboard": true,
      "focus": "reader-book-search-input"
    },
    {
      "id": "submit-a",
      "kind": "action",
      "op": "click",
      "from": "submit-a-ready",
      "target": "reader-bookshelf-search-submit",
      "waitFor": [
        {
          "kind": "search-button-intent"
