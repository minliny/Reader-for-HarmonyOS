          "kind": "search-page-projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.projection": "results",
            "payload.searchActive": false,
            "payload.stopped": true,
            "payload.operation": "cancelled"
          }
        }
      ],
      "keyboard": false,
      "quietMs": 3000,
      "anyAnchor": [
        "reader-bookshelf-search-results",
        "reader-bookshelf-search-empty",
        "reader-bookshelf-search-pending"
      ],
      "stateWaitMs": 30000,
      "stateWaitSource": "entry/src/main/ets/features/search/application/SearchGateway.ts#SEARCH_SOURCE_REQUEST_TIMEOUT_MS"
    },
    {
      "id": "open-detail",
      "kind": "action",
      "op": "click",
      "from": "results-a",
      "target": "reader-search-public-local-result",
      "waitFor": [
        {
          "kind": "search-detail-accepted",
          "channel": "business",
          "fields": {
            "payload.route": "detail"
          }
        }
      ]
    },
    {
      "id": "detail",
      "kind": "sample",
      "anchors": [
        "reader-book-detail-verification"
