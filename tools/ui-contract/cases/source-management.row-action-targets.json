{
  "id": "source-management.row-action-targets",
  "version": 2,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-row-action-targets-v1",
    "description": "Open an isolated public Source catalog from Settings in a compact nominal 366vp window with verified system font 1.00x. The only row is the normally imported, disabled Reader Phase 1 Row Actions fixture in its unchecked state. Observe native Detect and Login targets, category and action text ranges, and the unchecked status vector. The case opens Settings and the catalog without dispatching any row action.",
    "publicSources": true
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-content",
        "reader-source-list",
        "reader-source-footer",
        "reader-source-row-detect-control",
        "reader-source-row-login-control",
        "reader-source-text-row-category",
        "reader-source-text-row-login",
        "reader-source-row-status-unchecked"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.count": 1,
            "payload.projected": 1,
            "payload.status": "all",
            "payload.category": "all",
            "payload.groupIndex": 0,
            "payload.queryLength": 0,
            "payload.allGroups": true,
            "payload.rowActions.checkState": "unchecked"
          }
        },
        {
          "kind": "source.text-layout",
          "channel": "business"
        }
      ],
      "quietMs": 500
    }
  ],
  "assertions": [
    {
      "id": "source.route.entry",
      "evaluator": "source",
      "kind": "route",
      "expected": {
        "action": "open",
        "from": "settings",
        "to": "source",
        "anchor": "reader-source-back"
      },
      "source": "entry/src/main/ets/app/composition/ReaderSourceJourney.ets#ReaderSourceJourney",
      "required": true,
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "sample": "source-ready",
      "action": "open-sources"
    },
    {
      "id": "source.row.detect.native-target",
      "evaluator": "source",
      "kind": "native-control-target",
      "required": true,
      "expected": {
        "target": "reader-source-row-detect-control"
      },
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#detectButton",
      "action": "open-sources",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "sample": "source-ready"
    },
    {
      "id": "source.row.actions.text",
      "evaluator": "source",
      "kind": "adaptation-text",
      "required": true,
      "expected": {
        "textScope": "row-actions",
        "requireNativeFontReadback": true,
        "requireCurrentTextProjection": true,
        "expanded": false,
        "minWidthVp": 365.4,
        "maxWidthVp": 366.1,
        "minFontScale": 1,
        "maxFontScale": 1.01,
        "statsLineHeightFp": 18,
        "tolerancePx": 1
      },
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#scheduleVerificationTextLayout",
      "action": "open-sources",
      "sources": ["native-tree", "window-metrics", "app-owner"],
      "sample": "source-ready"
    },
    {
      "id": "source.row.status.badge",
      "evaluator": "source",
      "kind": "row-status-badge",
      "required": true,
      "expected": {"state": "unchecked"},
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#statusBadge",
      "action": "open-sources",
      "sources": ["native-tree", "window-metrics", "app-owner"],
      "sample": "source-ready"
    },
    {
      "id": "source.row.login.native-target",
      "evaluator": "source",
      "kind": "native-control-target",
      "required": true,
      "expected": {
        "target": "reader-source-row-login-control"
      },
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#loginButton",
      "action": "open-sources",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "sample": "source-ready"
    }
  ],
  "ownerSources": [
    "entry/src/main/ets/features/source/ui/SourceManagementPage.ets",
