{
  "id": "bookshelf.search-input-ime",
  "version": 2,
  "pageId": "bookshelf",
  "fixture": {
    "id": "public-search-v1",
    "inputWord": "Reader",
    "description": "Empty entry editor; public test books, history, results and keyboard candidates; one or more reachable enabled public test sources."
  },
  "steps": [
    {
      "id": "before",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-search",
      "kind": "action",
      "op": "click",
      "target": "reader-bookshelf-search-entry",
      "from": "before",
      "wait": [
        "search-open-accepted",
        "search-editor-focus"
      ]
    },
    {
      "id": "ime-ready",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-field",
        "reader-bookshelf-search-submit"
      ],
      "keyboard": true,
      "focus": "reader-book-search-input"
    },
    {
      "id": "input-search",
      "kind": "action",
      "op": "inputText",
      "target": "reader-book-search-input",
      "from": "ime-ready",
      "wait": [
        "search-editor-edit",
        "search-editor-selection"
      ]
    },
    {
      "id": "submit-ready",
      "kind": "locate",
      "anchors": [
        "reader-bookshelf-search-submit",
        "reader-book-search-input"
      ],
      "keyboard": true,
      "focus": "reader-book-search-input"
    },
    {
      "id": "submit-search",
      "kind": "action",
      "op": "click",
      "target": "reader-bookshelf-search-submit",
      "from": "submit-ready",
      "wait": [
        "search-button-intent",
        "search-submit-accepted"
      ]
    },
    {
      "id": "results-settled",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-search-bar",
        "reader-library-search-back",
        "reader-bookshelf-search-field",
        "reader-bookshelf-search-submit"
      ],
      "anyAnchor": [
        "reader-bookshelf-search-results",
        "reader-bookshelf-search-empty"
      ],
      "keyboard": false
    }
  ],
  "ownerSources": [
    "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets",
    "entry/src/main/ets/app/composition/ReaderLibraryJourney.ets",
    "entry/src/main/ets/ui/controls/ReaderSearchField.ets",
    "entry/src/main/ets/features/search/ui/SearchPage.ets",
    "entry/src/main/ets/app/ReaderWindowCoordinator.ts",
    "entry/src/main/ets/pages/Index.ets",
    "entry/src/main/ets/features/search/presentation/ReaderLibrarySearchModel.ets",
    "entry/src/main/ets/app/diagnostics/ReaderUIVerificationProbe.ts"
  ],
  "assertions": [
    {
      "id": "search.entry",
      "evaluator": "search",
      "kind": "entry",
      "expected": {
        "route": "search"
      },
      "source": "ReaderLibraryJourney#openSearch",
      "sources": [
        "native-tree",
        "app-owner",
        "window-metrics"
      ]
    },
    {
      "id": "search.focus",
      "evaluator": "search",
      "kind": "focus",
      "expected": {
        "focused": true,
        "length": 0
      },
      "source": "ReaderSearchField#onFocus",
      "sources": [
        "native-tree",
        "app-owner",
        "app-input"
      ]
    },
    {
      "id": "search.ime-before-input",
      "evaluator": "search",
      "kind": "ime-before-input",
      "expected": {
        "visible": true,
        "beforeInput": true
      },
      "source": "ReaderWindowCoordinator#keyboardAreaVp",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner",
        "app-input"
      ]
    },
    {
      "id": "search.edit-selection",
      "evaluator": "search",
      "kind": "edit-selection",
      "expected": {
        "length": 6,
        "start": 6,
        "end": 6
      },
      "source": "ReaderSearchField#onTextSelectionChange",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner",
        "app-input"
      ]
    },
    {
      "id": "search.submit",
      "evaluator": "search",
      "kind": "submit",
      "expected": {
        "length": 6,
        "semantic": "search"
      },
      "source": "ReaderLibraryJourney#search",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner",
        "app-input"
      ]
    },
    {
      "id": "search.results-settled",
      "evaluator": "search",
      "kind": "results-settled",
      "expected": {
        "mode": "results",
        "terminalProjection": [
          "results",
          "empty"
        ]
      },
      "source": "ReaderLibrarySearchSurface#onSettled",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner",
        "app-input"
      ]
    },
    {
      "id": "search.layout.gap",
      "evaluator": "layout",
      "kind": "gap",
      "expected": 5,
      "source": "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets#searchControlLane",
      "sources": [
        "native-tree",
        "window-metrics"
      ],
      "sample": "results-settled",
      "a": "reader-bookshelf-search-field",
      "b": "reader-bookshelf-search-submit",
      "branch": "row",
      "axis": "x",
      "tolerancePx": 1
    },
    {
      "id": "search.layout.align",
      "evaluator": "layout",
      "kind": "align",
      "expected": 0,
      "source": "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets#searchControlLane",
      "sources": [
        "native-tree",
        "window-metrics"
      ],
      "sample": "results-settled",
      "a": "reader-bookshelf-search-field",
      "b": "reader-bookshelf-search-submit",
      "branch": "row",
      "axis": "y",
      "tolerancePx": 1
    },
    {
      "id": "search.layout.back-field",
      "evaluator": "layout",
      "kind": "nonOverlap",
      "expected": {
        "maxOverlapAreaVp2": 0
      },
      "source": "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets#searchControlLane",
      "sources": [
        "native-tree",
        "window-metrics"
      ],
      "sample": "results-settled",
      "a": "reader-library-search-back",
      "b": "reader-bookshelf-search-field"
    },
    {
      "id": "search.layout.submit-visible",
      "evaluator": "layout",
      "kind": "visibleFraction",
      "expected": {
        "minFraction": 1
      },
      "source": "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets#searchControlLane",
      "sources": [
        "native-tree",
        "window-metrics"
      ],
      "sample": "ime-ready",
      "a": "reader-bookshelf-search-submit",
      "basis": "rectangular",
      "includeKeyboard": true
    },
    {
      "id": "search.layout.editor-ime",
      "evaluator": "layout",
      "kind": "keyboardAvoidance",
      "expected": {
        "maxOverlapAreaVp2": 0
      },
      "source": "ReaderWindowCoordinator#keyboardAreaVp",
      "sources": [
        "native-tree",
        "window-metrics"
      ],
      "sample": "ime-ready",
      "a": "reader-book-search-input"
    },
    {
      "id": "search.layout.submit-ime",
      "evaluator": "layout",
      "kind": "keyboardAvoidance",
      "expected": {
        "maxOverlapAreaVp2": 0
      },
      "source": "ReaderWindowCoordinator#keyboardAreaVp",
      "sources": [
        "native-tree",
        "window-metrics"
      ],
      "sample": "ime-ready",
      "a": "reader-bookshelf-search-submit"
    },
    {
      "id": "search.layout.field-delta",
      "evaluator": "layout",
      "kind": "relativeDelta",
      "expected": {
        "dx": 0,
        "dy": 0
      },
      "source": "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets#searchControlLane",
      "sources": [
        "native-tree",
        "window-metrics"
      ],
      "sample": "results-settled",
      "a": "reader-bookshelf-search-field",
      "baseline": "ime-ready",
      "anchor": "reader-bookshelf-search-bar",
      "branch": "row",
      "tolerancePx": 1,
      "sameContinuity": true
    }
  ]
}
