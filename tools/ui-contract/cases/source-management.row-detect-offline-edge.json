{
  "id": "source-management.row-detect-offline-edge",
  "version": 2,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-row-detect-offline-v1",
    "description": "Use a separately prepared isolated public catalog containing the exact disabled, as yet unchecked Offline Detect fixture without searchUrl or login. Open Source Management from Settings and tap the measured upper edge of the real native Detect Button. Require L1 to pass and L2 to fail before HTTP on that same row. Do not reset a previous result to prepare this case.",
    "publicSources": true
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-content",
        "reader-source-list",
        "reader-source-footer",
        "reader-source-row-detect-control",
        "reader-source-offline-detect-ready"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.count": 1,
            "payload.projected": 1,
            "payload.status": "all",
            "payload.category": "all",
            "payload.groupIndex": 0,
            "payload.queryLength": 0,
            "payload.allGroups": true
          }
        },
        {
          "kind": "source.row-detect",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.phase": "ready",
            "payload.definition": "missing-search-url"
          }
        }
      ],
      "quietMs": 500
    },
    {
      "kind": "action",
      "id": "detect-source-top",
      "op": "click",
      "from": "source-ready",
      "target": "reader-source-row-detect-control",
      "beforeEvent": [
        {
          "kind": "source.row-detect",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.phase": "ready",
            "payload.definition": "missing-search-url"
          }
        }
      ]
    },
    {
      "id": "check-dialog",
      "kind": "locate",
      "anchors": [
        "reader-source-v9-check-run",
        "reader-source-v9-check-close"
      ],
      "keyboard": false,
      "afterAction": "detect-source-top"
    },
    {
      "id": "start-check",
      "kind": "action",
      "op": "click",
      "from": "check-dialog",
      "target": "reader-source-v9-check-run"
    },
    {
      "id": "check-complete",
      "kind": "locate",
      "anchors": [
        "reader-source-v9-check-run",
        "reader-source-v9-check-close"
      ],
      "keyboard": false,
      "afterAction": "start-check",
      "waitFor": [
        {
          "kind": "source.row-detect",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.phase": "settled"
          }
        }
      ]
    },
    {
      "id": "close-check",
      "kind": "action",
      "op": "click",
      "from": "check-complete",
      "target": "reader-source-v9-check-close"
    },
    {
      "kind": "sample",
      "id": "detect-settled",
      "afterAction": "close-check",
      "anchors": [
        "reader-source-back",
        "reader-source-content",
        "reader-source-list",
        "reader-source-row-detect-control",
        "reader-source-offline-detect-failed"
      ],
      "keyboard": false,
      "quietMs": 500
    }
  ],
  "assertions": [
    {
      "id": "source.route.entry",
      "evaluator": "source",
      "kind": "route",
      "expected": {
        "action": "open",
        "from": "settings",
        "to": "source",
        "anchor": "reader-source-back"
      },
      "source": "entry/src/main/ets/app/composition/ReaderSourceJourney.ets#ReaderSourceJourney",
      "required": true,
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "sample": "source-ready",
      "action": "open-sources"
    },
    {
      "id": "source.row.detect.offline-top",
      "evaluator": "source",
      "kind": "source-offline-detect",
      "expected": {
        "target": "reader-source-row-detect-control",
        "l1": "pass",
        "l2": "pre-request-fail",
        "position": "top"
      },
      "source": "entry/src/main/ets/features/source/application/SourceOrchestrator.ets#runSourceCheck",
      "entryAction": "open-sources",
      "action": "detect-source-top",
      "baseline": "source-ready",
      "sample": "detect-settled",
      "required": true,
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "runAction": "start-check",
      "returnAction": "close-check"
    }
  ],
