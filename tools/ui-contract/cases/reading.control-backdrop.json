    {
      "id": "reading-book-entry",
      "kind": "locate",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "book": true
    },
    {
      "id": "enter-reading",
      "kind": "action",
      "op": "click",
      "from": "reading-book-entry",
      "target": {
        "publicBookTitle": "Reader Phase 0 公共测试书"
      },
      "waitFor": [
        {
          "kind": "reading.ready",
          "fields": {
            "payload.localBook": true,
            "payload.reduceMotion": false
          }
        }
      ]
    },
    {
      "id": "reading-before",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "enter-reading",
      "quietMs": 500,
      "anyAnchor": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ]
    },
    {
      "id": "open",
      "kind": "action",
      "op": "click",
      "from": "reading-before",
      "target": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ],
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        },
        {
          "kind": "reading.control-motion",
          "fields": {
            "payload.finalBlock": true,
            "payload.endReason": "completed"
          }
        }
      ],
      "gesture": true
    },
    {
      "id": "open-state",
