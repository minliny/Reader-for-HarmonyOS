        {
          "kind": "reading.control-transition-committed"
        },
        {
          "kind": "reading.control-motion",
          "fields": {
            "payload.finalBlock": true,
            "payload.endReason": "completed"
          }
        }
      ]
    },
    {
      "id": "tap-backdrop",
      "kind": "action",
      "op": "click",
      "from": "open-state",
