        {
          "kind": "search-page-anchor",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.action": "user-scroll-settled",
            "payload.anchorAtStart": false
          }
        }
      ],
      "path": {
        "from": [
          0.55,
          0.87
        ],
        "to": [
          0.55,
          0.14
        ],
        "speed": 450
      }
    },
    {
      "id": "results-scrolled",
      "kind": "sample",
      "afterAction": "scroll-results",
      "anchors": [
        "reader-bookshelf-search-results",
        "reader-search-result-viewport",
        "reader-search-public-local-result"
      ],
      "waitFor": [
        {
          "kind": "search-page-anchor",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.action": "user-scroll-settled",
            "payload.anchorAtStart": false
