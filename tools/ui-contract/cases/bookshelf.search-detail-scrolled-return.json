      "afterAction": "open-detail",
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "detail-back",
      "kind": "action",
      "op": "keyEvent",
      "from": "detail",
      "waitFor": [
        {
          "kind": "search-detail-returned",
          "channel": "business",
          "fields": {
            "payload.route": "search"
          }
        }
      ],
      "key": "Back"
    },
    {
      "id": "result-returned",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-library-search-back",
        "reader-search-public-local-result",
        "reader-search-result-viewport"
      ],
      "afterAction": "detail-back",
      "waitFor": [
        {
          "kind": "search-page-anchor",
          "channel": "business",
          "fields": {
            "payload.action": "anchor-restored"
          }
        }
      ],
      "keyboard": false,
      "quietMs": 1500
    },
    {
      "id": "back-to-shelf",
      "kind": "action",
      "op": "keyEvent",
      "from": "result-returned",
      "waitFor": [
        {
          "kind": "search-back-consumed"
        }
      ],
      "key": "Back"
    },
    {
      "id": "bookshelf-again",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "afterAction": "back-to-shelf",
      "waitFor": [
        {
          "kind": "search-route-released",
          "fields": {
            "payload.route": "bookshelf"
          }
        }
      ],
      "keyboard": false,
      "quietMs": 125,
      "book": true
    }
