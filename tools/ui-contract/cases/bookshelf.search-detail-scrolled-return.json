        {
          "kind": "search-detail-accepted",
          "channel": "business",
          "fields": {
            "payload.route": "detail"
          }
        }
      ],
      "beforeEvent": [
        {
          "kind": "search-page-anchor",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.action": "user-scroll-settled",
            "payload.anchorAtStart": false
          }
