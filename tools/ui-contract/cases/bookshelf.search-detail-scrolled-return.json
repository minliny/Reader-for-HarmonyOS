      "afterAction": "submit-a",
      "waitFor": [
        {
          "kind": "search-page-projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.projection": "results",
            "payload.searchActive": false,
            "payload.stopped": false,
            "payload.operation": "current",
            "payload.resultCount": 8
          }
        }
      ],
      "keyboard": false,
      "quietMs": 750
    },
    {
      "id": "scroll-results",
      "kind": "action",
      "op": "swipe",
      "from": "results-a",
      "target": "reader-search-result-viewport",
      "beforeEvent": [
        {
          "kind": "search-page-projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.projection": "results",
            "payload.searchActive": false,
            "payload.stopped": false,
            "payload.operation": "current",
            "payload.resultCount": 8
          }
        }
