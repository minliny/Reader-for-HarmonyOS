{
  "id": "bookshelf.search-detail-scrolled-return",
  "version": 3,
  "phase": 1,
  "pageId": "bookshelf",
  "fixture": {
    "id": "public-search-detail-scrolled-return-local-corpus",
    "description": "Use the isolated empty-source phone window and the exact eight public local books. Verify the focused no-source recovery with IME hidden, then tap the editor and type the public word. Swipe to the last book, open its Detail and return to the same off-start position.",
    "inputs": {
      "a": "移窗样本"
    },
    "bookTitle": "终点移窗样本",
    "publicSources": true
  },
  "steps": [
    {
      "id": "before",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "book": true
    },
    {
      "id": "open-search",
      "kind": "action",
      "op": "click",
      "from": "before",
      "target": "reader-bookshelf-search-entry",
      "waitFor": [
        {
          "kind": "search-open-accepted"
        }
      ]
    },
    {
      "id": "search-entry",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-field",
        "reader-bookshelf-search-submit",
        "reader-bookshelf-search-sourceRequired",
        "reader-search-source-recovery-primary"
      ],
      "afterAction": "open-search",
      "waitFor": [
        {
          "kind": "search-surface-settled",
          "fields": {
            "payload.mode": "input"
          },
          "match": "latest",
          "channel": "business"
        },
        {
          "kind": "search-page-projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.projection": "sourceRequired",
            "payload.sourceRequiredReason": "noSources",
            "payload.searchActive": false
          }
        }
      ],
      "keyboard": false,
      "focus": "reader-book-search-input",
      "quietMs": 125
    },
    {
      "id": "focus-editor",
      "kind": "action",
      "op": "click",
      "from": "search-entry",
      "target": "reader-book-search-input"
    },
    {
      "id": "ime-ready",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-field",
        "reader-bookshelf-search-submit",
        "reader-bookshelf-search-sourceRequired"
      ],
      "afterAction": "focus-editor",
      "keyboard": true,
      "focus": "reader-book-search-input",
      "quietMs": 125
    },
    {
      "id": "type-a",
      "kind": "action",
      "op": "inputText",
      "from": "ime-ready",
      "target": "reader-book-search-input",
      "waitFor": [
        {
          "kind": "search-editor-edit",
          "fields": {
            "payload.length": 4
          }
        },
        {
          "kind": "search-editor-selection",
          "fields": {
            "payload.start": 4,
            "payload.end": 4
          }
        },
        {
          "kind": "search-draft-accepted",
          "fields": {
            "payload.length": 4
          }
        }
      ],
      "inputRole": "a"
    },
    {
      "id": "submit-a-ready",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-submit"
