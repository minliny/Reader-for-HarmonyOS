  "pageId": "source-management",
  "fixture": {
    "id": "public-source-group-options-v1",
    "description": "Use the isolated public Phase 1 source catalog and its normal all-groups view. Open the group panel with the top edge of the actual trigger Button. Tap the current selected option center, keeping its scope and closing this opening. Reopen, dispatch the existing selected bottom and alternative top edges in their own openings, and verify acceptance and dismissal. This case changes no catalog data.",
    "publicSources": true
  },
