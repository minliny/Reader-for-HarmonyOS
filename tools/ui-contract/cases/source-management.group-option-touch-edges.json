          "fields": {
            "payload.trigger": "group",
            "payload.groupIndex": 0,
            "payload.allGroups": true
          }
        },
        {
          "kind": "source.overlay",
          "fields": {
            "payload.overlay": "group",
            "payload.phase": "dismiss"
          }
        }
