{
  "id": "bookshelf.search-task-back",
  "version": 5,
  "phase": 1,
  "pageId": "bookshelf",
  "fixture": {
    "id": "public-search-task-back-directory-v2",
    "description": "Use the confirmed public local directory TXT and drop ongoing online work through the real in-page Stop before capturing the full settled result. Open the normal result Task sheet after Stop. Use Back to release it and preserve the same query, then Back again to return to the bookshelf.",
    "inputs": {
      "a": "公共长目录"
    },
    "bookTitle": "Reader Phase 1 公共长目录",
    "publicSources": true
  },
  "steps": [
    {
      "id": "before",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "book": true
    },
    {
      "id": "open-search",
      "kind": "action",
      "op": "click",
      "from": "before",
      "target": "reader-bookshelf-search-entry",
      "waitFor": [
        {
          "kind": "search-open-accepted"
        }
      ]
    },
    {
      "id": "ime-ready",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-field",
        "reader-bookshelf-search-submit"
      ],
      "afterAction": "open-search",
      "waitFor": [
        {
          "kind": "search-surface-settled",
          "fields": {
            "payload.mode": "input"
          },
          "match": "latest",
          "channel": "business"
        }
      ],
      "keyboard": true,
      "focus": "reader-book-search-input",
      "quietMs": 125
    },
    {
      "id": "type-a",
      "kind": "action",
      "op": "inputText",
      "from": "ime-ready",
      "target": "reader-book-search-input",
      "waitFor": [
        {
          "kind": "search-editor-edit",
          "fields": {
            "payload.length": 5
          }
        },
        {
          "kind": "search-editor-selection",
          "fields": {
            "payload.start": 5,
            "payload.end": 5
          }
        },
        {
          "kind": "search-draft-accepted",
          "fields": {
            "payload.length": 5
          }
        }
      ],
      "inputRole": "a"
    },
    {
      "id": "submit-a-ready",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-submit"
      ],
      "afterAction": "type-a",
      "keyboard": true,
      "focus": "reader-book-search-input"
    },
    {
      "id": "submit-a",
      "kind": "action",
      "op": "click",
      "from": "submit-a-ready",
      "target": "reader-bookshelf-search-submit",
      "waitFor": [
        {
          "kind": "search-button-intent"
        },
        {
          "kind": "search-submit-accepted"
        }
      ],
      "buttonSemantic": "search"
    },
    {
      "id": "running-a",
      "kind": "locate",
      "anchors": [
        "reader-bookshelf-search-bar",
        "reader-bookshelf-search-submit",
        "reader-search-public-local-result"
      ],
      "keyboard": false,
      "afterAction": "submit-a",
      "waitFor": [
        {
          "kind": "search-surface-settled",
          "fields": {
            "payload.mode": "results"
          },
          "match": "latest",
          "channel": "business"
        },
        {
          "kind": "search-page-projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.projection": "results",
            "payload.searchActive": true
          }
        }
      ],
      "quietMs": 1000,
      "stateWaitMs": 45000,
      "stateWaitSource": "entry/src/main/ets/features/search/application/SearchGateway.ts#SEARCH_SOURCE_REQUEST_TIMEOUT_MS",
      "captureGuard": "search-active-stop"
    },
    {
      "id": "stop-a",
      "kind": "action",
      "op": "click",
      "target": "reader-bookshelf-search-submit",
      "from": "running-a",
      "buttonSemantic": "stop",
      "beforeEvent": [
        {
          "kind": "search-page-projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.projection": "results",
            "payload.searchActive": true
          }
        }
      ],
      "waitFor": [
        {
          "kind": "search-stop-intent",
          "channel": "input",
          "fields": {
            "payload.semantic": "stop"
          }
        },
        {
          "kind": "search-page-action",
          "channel": "business",
          "fields": {
            "payload.action": "stop"
          }
        }
      ]
    },
    {
      "id": "results-a",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-bookshelf-search-bar",
        "reader-library-search-back",
        "reader-bookshelf-search-submit",
        "reader-search-public-local-result",
        "reader-search-task-trigger"
      ],
      "afterAction": "stop-a",
      "waitFor": [
        {
          "kind": "search-page-projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.projection": "results",
            "payload.searchActive": false,
            "payload.stopped": true,
            "payload.operation": "cancelled"
          }
        }
      ],
      "keyboard": false,
      "quietMs": 3000,
      "anyAnchor": [
        "reader-bookshelf-search-results",
        "reader-bookshelf-search-empty",
        "reader-bookshelf-search-pending"
      ],
      "stateWaitMs": 30000,
      "stateWaitSource": "entry/src/main/ets/features/search/application/SearchGateway.ts#SEARCH_SOURCE_REQUEST_TIMEOUT_MS"
    },
    {
      "id": "open-panel",
      "kind": "action",
      "op": "click",
      "from": "results-a",
      "target": "reader-search-task-trigger",
      "waitFor": [
        {
          "kind": "search-page-action",
          "channel": "business",
          "fields": {
            "payload.action": "panel-open",
            "payload.panel": "task"
          }
        }
      ]
    },
    {
      "id": "panel-open",
      "kind": "sample",
      "anchors": [],
      "afterAction": "open-panel",
      "keyboard": false,
      "waitFor": [
        {
          "kind": "search-page-action",
          "channel": "business",
          "fields": {
            "payload.action": "panel-open",
            "payload.panel": "task"
          },
          "match": "latest"
        }
      ],
      "quietMs": 500
    },
    {
      "id": "panel-back",
      "kind": "action",
      "op": "keyEvent",
      "from": "panel-open",
      "key": "Back",
      "waitFor": [
        {
          "kind": "search-page-action",
          "channel": "business",
          "fields": {
            "payload.action": "panel-dismiss",
            "payload.panel": "task"
          }
        }
      ]
    },
    {
      "id": "panel-closed",
      "kind": "sample",
      "anchors": [
        "reader-book-search-input",
        "reader-search-task-trigger",
        "reader-library-search-back",
        "reader-search-public-local-result"
      ],
      "afterAction": "panel-back",
      "waitFor": [
        {
          "kind": "search-page-action",
          "channel": "business",
          "fields": {
            "payload.action": "panel-dismiss",
            "payload.panel": "task"
          },
          "match": "latest"
        }
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "back-to-shelf",
      "kind": "action",
      "op": "keyEvent",
      "from": "panel-closed",
      "waitFor": [
        {
          "kind": "search-back-consumed"
        }
      ],
      "key": "Back"
    },
    {
      "id": "bookshelf-again",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "afterAction": "back-to-shelf",
      "waitFor": [
        {
          "kind": "search-route-released",
          "fields": {
            "payload.route": "bookshelf"
          }
        }
      ],
      "keyboard": false,
      "quietMs": 125,
      "book": true
    }
  ],
  "ownerSources": [
