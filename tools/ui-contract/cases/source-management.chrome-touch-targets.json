{
  "id": "source-management.chrome-touch-targets",
  "version": 1,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-catalog-v1",
    "description": "Open the populated public Source catalog from normal Settings. Observe the real header Back and Tools buttons, native editor and inline Import, and both fixed footer buttons with IME hidden. No action alters the catalog.",
    "publicSources": true
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-header-tools",
        "reader-source-list",
        "reader-source-search",
        "reader-source-editor",
        "reader-source-footer"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current"
          }
        }
      ],
      "quietMs": 500
    }
  ],
  "ownerSources": [
    "entry/src/main/ets/features/source/ui/SourceManagementPage.ets",
    "entry/src/main/ets/app/composition/ReaderSourceJourney.ets",
    "entry/src/main/ets/features/source/ui/SourceJourneySurface.ets",
    "entry/src/main/ets/features/source/ui/SourceManagementVerification.ts",
    "entry/src/main/ets/ui/chrome/PageBackBar.ets",
    "entry/src/main/ets/ui/controls/ReaderIconButton.ets",
    "entry/src/main/ets/ui/controls/ReaderControlSpecs.ets",
    "entry/src/main/ets/ui/controls/ReaderActionAccessibility.ets",
    "entry/src/main/ets/ui/controls/ReaderSearchField.ets",
    "entry/src/main/ets/ui/controls/ReaderButton.ets",
    "entry/src/main/ets/ui/controls/ReaderLabeledIconAction.ets"
  ],
  "assertions": [
    {
      "id": "source.route.entry",
      "evaluator": "source",
      "kind": "route",
      "expected": {
        "action": "open",
        "from": "settings",
        "to": "source",
        "anchor": "reader-source-back"
      },
      "source": "entry/src/main/ets/app/composition/ReaderSourceJourney.ets#ReaderSourceJourney",
      "required": true,
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "sample": "source-ready",
      "action": "open-sources"
    },
    {
      "id": "source.e2.header-back",
      "evaluator": "source",
      "kind": "native-control-target",
      "expected": {
        "target": "reader-source-back"
      },
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#backBar",
      "sources": [
        "native-tree",
