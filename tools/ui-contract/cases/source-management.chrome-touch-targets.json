    },
    {
      "id": "source.e2.search-import",
      "evaluator": "source",
      "kind": "native-control-target",
      "expected": {
        "target": "reader-source-search-import-button"
      },
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#importAction",
      "sources": [
