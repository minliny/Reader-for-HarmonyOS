{
  "id": "reading.control-open-motion",
  "version": 2,
  "pageId": "reading",
  "fixture": {
    "id": "public-local-reading-v1",
    "bookTitle": "Reader Phase 0 公共测试书",
    "description": "Unique public local book on the shelf; normal motion, no system overlays."
  },
  "steps": [
    {
      "id": "reading-book-entry",
      "kind": "locate",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "book": true
    },
    {
      "id": "enter-reading",
      "kind": "action",
      "op": "click",
      "target": {
        "publicBookTitle": "Reader Phase 0 公共测试书"
      },
      "from": "reading-book-entry",
      "wait": [
        "reading.ready"
      ]
    },
    {
      "id": "reading-before",
      "kind": "sample",
      "anchors": [],
      "keyboard": false,
      "anyAnchor": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ]
    },
    {
      "id": "open",
      "kind": "action",
      "op": "click",
      "target": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ],
      "from": "reading-before",
      "gesture": true,
      "wait": [
        "reading.control-requested",
        "reading.control-committed"
      ]
    },
    {
      "id": "control-open",
      "kind": "sample",
      "anchors": [
        "reader-control-motion-shell",
        "reader-control-motion-grabber",
        "reader-control-motion-dock",
        "reader-control-content-host"
      ],
      "keyboard": false
    },
    {
      "id": "dismiss",
      "kind": "action",
      "op": "keyEvent",
      "wait": [
        "reading.control-requested",
        "reading.control-committed"
      ],
      "from": "control-open"
    },
    {
      "id": "control-closed",
      "kind": "sample",
      "anchors": [],
      "keyboard": false,
      "anyAnchor": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ]
    }
  ],
  "ownerSources": [
    "entry/src/main/ets/features/reading/ui/LocalReadingExperience.ets",
    "entry/src/main/ets/features/reading/ui/ReaderControlHostSession.ts",
    "entry/src/main/ets/features/reading/ui/ReaderControlSessionState.ts",
