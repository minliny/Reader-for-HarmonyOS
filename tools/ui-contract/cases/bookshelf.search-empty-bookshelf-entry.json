{
  "id": "bookshelf.search-empty-bookshelf-entry",
  "version": 1,
  "phase": 1,
  "pageId": "bookshelf",
  "fixture": {
    "id": "public-search-empty-bookshelf-entry-v1",
    "description": "Use an isolated verified public bookshelf with no books and readable enabled public sources. Open the normal Search Books action on the empty shelf. Capture the native input overlay with the system IME and use ordinary Back first to hide the IME, then to return to the same empty shelf. This case does not submit a query, alter books or sources, or require any source provider traffic.",
    "publicSources": true
  },
  "steps": [
    {
      "id": "empty-shelf-before",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-empty-scroll",
        "reader-bookshelf-empty-title",
        "reader-bookshelf-import-entry",
        "reader-bookshelf-empty-search-entry",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "quietMs": 125
    },
    {
      "id": "open-search",
      "kind": "action",
      "op": "click",
      "target": {
        "id": "reader-bookshelf-empty-search-entry",
        "ancestors": [
          "reader-bookshelf-empty-scroll"
        ]
      },
      "from": "empty-shelf-before",
      "waitFor": [
        {
          "kind": "search-open-accepted",
          "channel": "business",
          "fields": {
            "payload.entry": "empty-shelf"
          },
          "match": "latest"
        }
      ]
    },
    {
      "id": "entry-projection",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-empty-scroll",
        "reader-bookshelf-empty-title",
        "reader-book-search-input",
        "reader-library-search-back",
        "reader-bookshelf-search-field",
        "reader-bookshelf-search-submit"
      ],
      "keyboard": true,
      "quietMs": 125,
      "focus": "reader-book-search-input",
      "afterAction": "open-search",
      "waitFor": [
        {
          "kind": "search-surface-settled",
          "channel": "business",
          "fields": {
            "payload.mode": "input"
          },
          "match": "latest"
        },
        {
          "kind": "search-page-projection",
          "channel": "business",
          "fields": {
            "payload.projection": "initial"
          },
          "match": "latest"
        }
      ]
    },
    {
      "id": "back-ime",
      "kind": "action",
      "op": "keyEvent",
      "key": "Back",
      "from": "entry-projection"
    },
    {
      "id": "input-ime-hidden",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-empty-scroll",
        "reader-bookshelf-empty-title",
        "reader-book-search-input",
        "reader-library-search-back",
        "reader-bookshelf-search-field",
        "reader-bookshelf-search-submit"
      ],
      "keyboard": false,
      "quietMs": 125,
      "afterAction": "back-ime"
    },
    {
      "id": "back-to-shelf",
      "kind": "action",
      "op": "keyEvent",
      "key": "Back",
      "from": "input-ime-hidden",
      "waitFor": [
        {
          "kind": "search-back-consumed",
          "channel": "business"
        }
      ]
    },
    {
      "id": "empty-shelf-returned",
      "kind": "sample",
      "anchors": [
        "reader-bookshelf-empty-scroll",
        "reader-bookshelf-empty-title",
        "reader-bookshelf-import-entry",
        "reader-bookshelf-empty-search-entry",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "quietMs": 125,
      "afterAction": "back-to-shelf",
      "waitFor": [
        {
          "kind": "search-route-released",
          "channel": "business",
          "fields": {
            "payload.route": "bookshelf"
          },
          "match": "latest"
        }
      ]
    }
  ],
