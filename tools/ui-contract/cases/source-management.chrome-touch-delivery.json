{
  "id": "source-management.chrome-touch-delivery",
  "version": 2,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-chrome-touch-v1",
    "description": "Open the populated public Source catalogue from normal Settings. Measure the four real chrome buttons and test their centers in the first opening. Reopen from the returned Settings page and touch the upper edge of each same native control. Ordinary Back releases Tools and the JSON import dialog. No file selection or source operation.",
    "publicSources": true
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "sample",
      "afterAction": "open-settings",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "afterAction": "open-sources",
