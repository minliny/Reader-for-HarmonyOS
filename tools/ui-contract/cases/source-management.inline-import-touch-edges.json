{
  "id": "source-management.inline-import-touch-edges",
  "version": 2,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-inline-import-touch-edges-v1",
    "description": "Open the normal populated public Source catalog from Settings. Measure the full native 44vp inline import response, then touch its four cardinal edges outside the button paint and its center inside the paint. Each touch opens the real book-source JSON dialog. Use system Back to return to the same untouched Source opening. Never select or import any document.",
    "publicSources": true
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-header-tools",
        "reader-source-list",
        "reader-source-search",
        "reader-source-editor",
        "reader-source-footer"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current"
          }
        }
      ],
      "quietMs": 500
    },
    {
      "id": "tap-inline-import-top",
      "kind": "action",
      "op": "click",
      "from": "source-ready",
      "target": "reader-source-search-import-button",
      "tapEdge": "top"
    },
    {
      "id": "inline-import-dialog-top",
      "kind": "sample",
      "afterAction": "tap-inline-import-top",
      "anchors": [
        "reader-source-inline-import-dialog"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "back-inline-import-top",
      "kind": "action",
      "op": "keyEvent",
      "from": "inline-import-dialog-top",
      "key": "Back"
    },
    {
      "id": "inline-import-returned-top",
      "kind": "sample",
      "afterAction": "back-inline-import-top",
      "anchors": [
        "reader-source-back",
        "reader-source-list",
        "reader-source-search"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "tap-inline-import-bottom",
      "kind": "action",
      "op": "click",
      "from": "inline-import-returned-top",
      "target": "reader-source-search-import-button",
