{
  "id": "bookshelf.public-book-reading",
  "version": 1,
  "phase": 2,
  "pageId": "bookshelf",
  "fixture": {
    "id": "public-local-reading-v1",
    "bookTitle": "Reader Phase 0 公共测试书",
    "description": "Use the normal bookshelf and open the uniquely identified public local book from its ordinary book card."
  },
  "steps": [
    {
      "id": "bookshelf-ready",
      "kind": "sample",
      "anchors": [
        "reader-app-route-stack",
        "reader-bookshelf-search-bar",
        "reader-bookshelf-search-entry"
      ],
      "book": true,
      "keyboard": false
    },
    {
      "id": "enter-reading",
      "kind": "action",
      "op": "click",
      "from": "bookshelf-ready",
      "target": {"publicBookTitle": "Reader Phase 0 公共测试书"},
      "waitFor": [
        {"kind": "reading.ready", "channel": "business", "fields": {"payload.localBook": true}}
      ]
    },
    {
      "id": "reading-ready",
      "kind": "sample",
      "afterAction": "enter-reading",
      "anchors": ["reader-reading-stage"],
      "anyAnchor": ["reader-reading-interaction-host-continuous", "reader-reading-interaction-host-paged"],
      "keyboard": false,
      "quietMs": 250,
      "waitFor": [
        {"kind": "reading.ready", "channel": "business", "fields": {"payload.localBook": true}}
      ]
    }
  ],
  "assertions": [
    {
      "id": "bookshelf.header.search-visible",
      "evaluator": "layout",
      "kind": "visibleFraction",
      "source": "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets#searchBar",
      "required": true,
      "sources": ["native-tree", "window-metrics"],
      "sample": "bookshelf-ready",
      "a": "reader-bookshelf-search-entry",
      "basis": "rectangular",
      "expected": {"minFraction": 1, "enabled": true}
    },
    {
      "id": "bookshelf.header.search-contained",
      "evaluator": "layout",
      "kind": "contain",
      "source": "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets#searchBar",
      "required": true,
      "sources": ["native-tree", "window-metrics"],
      "sample": "bookshelf-ready",
      "a": "reader-bookshelf-search-entry",
      "b": "reader-bookshelf-search-bar",
      "expected": {"maxOverflowVp": 0},
      "tolerancePx": 1
    }
  ],
  "ownerSources": [
    "entry/src/main/ets/pages/Index.ets",
    "entry/src/main/ets/app/navigation/ReaderRouteStackSurface.ets",
    "entry/src/main/ets/features/search/ui/ReaderLibrarySearchSurface.ets",
    "entry/src/main/ets/features/bookshelf/ui/BookshelfPage.ets",
    "entry/src/main/ets/features/reading/ui/LocalReadingExperience.ets",
    "entry/src/main/ets/app/diagnostics/ReaderUIVerificationProbe.ts"
  ]
}
