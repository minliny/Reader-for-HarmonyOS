{
  "id": "source-management.layout-expanded",
  "version": 4,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-row-font-boundary-v1",
    "description": "Use an ordinary expanded Reader window at an actual width of at least 600vp with the single disabled public row fixture imported normally into an otherwise empty public catalog. The native font readback must show the actual system scale from 1 to 2. Observe the fixed labels and the current first source category and Detect text, then open and dismiss the normal source group selector.",
    "publicSources": true
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-content",
        "reader-source-search",
        "reader-source-editor",
        "reader-source-stats",
        "reader-source-category-filter",
        "reader-source-status-filter",
        "reader-source-group-filter",
        "reader-source-filter-block",
        "reader-source-text-row-category",
        "reader-source-text-row-detect"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.count": 1,
            "payload.projected": 1
          }
        },
        {
          "kind": "source.toggle",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.phase": "ready",
            "payload.enabled": false
          }
        },
        {
          "kind": "source.text-layout",
          "channel": "business"
        }
      ],
      "quietMs": 500
    },
    {
      "id": "open-group",
      "kind": "action",
      "op": "click",
      "from": "source-ready",
      "target": "reader-source-group-trigger",
      "waitFor": [
        {
          "kind": "source.overlay",
          "fields": {
            "payload.phase": "open",
            "payload.overlay": "group"
          }
        }
      ],
      "gesture": true
    },
    {
      "id": "group-open",
      "kind": "sample",
      "anchors": [
        "reader-source-group-panel"
      ],
      "keyboard": false,
      "afterAction": "open-group",
      "quietMs": 500
    },
    {
      "id": "back-group",
      "kind": "action",
      "op": "keyEvent",
      "from": "group-open",
      "waitFor": [
        {
          "kind": "source.overlay",
          "fields": {
            "payload.phase": "dismiss",
            "payload.overlay": "group"
          }
        }
      ],
      "key": "Back"
    },
    {
      "id": "group-back",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-editor",
        "reader-source-status-filter",
        "reader-source-category-filter",
        "reader-source-group-trigger",
        "reader-source-group-filter",
        "reader-source-list"
      ],
      "keyboard": false,
      "afterAction": "back-group",
      "quietMs": 500
    }
  ],
  "ownerSources": [
