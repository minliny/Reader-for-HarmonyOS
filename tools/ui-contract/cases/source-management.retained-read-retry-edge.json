{
  "id": "source-management.retained-read-retry-edge",
  "version": 1,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-retained-read-v1",
    "description": "Use the actual populated public Source catalog, return to Settings with system Back, and reopen. Only after a genuine failed fresh read with the previous rows still present, click the measured upper edge of Refresh list and verify the actual new read generation and terminal result.",
    "publicSources": true
  },
  "ownerSources": [
    "entry/src/main/ets/app/ReaderOperationFacts.ts",
    "entry/src/main/ets/app/ReaderRecoveryProjection.ts",
    "entry/src/main/ets/app/composition/ReaderSourceJourney.ets",
    "entry/src/main/ets/app/diagnostics/ReaderUIVerificationProbe.ts",
    "entry/src/main/ets/app/navigation/ReaderNavigation.ts",
    "entry/src/main/ets/features/settings/ui/SettingsPage.ets",
    "entry/src/main/ets/features/source/application/SourceGateway.ts",
    "entry/src/main/ets/features/source/application/SourceHost.ets",
    "entry/src/main/ets/features/source/application/SourceOrchestrator.ets",
    "entry/src/main/ets/features/source/presentation/SourceJourneyPresentation.ets",
    "entry/src/main/ets/features/source/ui/SourceJourneySurface.ets",
    "entry/src/main/ets/features/source/ui/SourceManagementPage.ets",
    "entry/src/main/ets/features/source/ui/SourceManagementVerification.ts",
    "entry/src/main/ets/ui/feedback/ReaderRecoveryAction.ets",
    "entry/src/main/ets/ui/foundation/ReaderMessageStyle.ets",
    "entry/src/main/ets/pages/ReaderSourceTextMetrics.ets",
    "entry/src/main/ets/ui/layout/ReaderPageScaffold.ets",
    "entry/src/main/ets/ui/patterns/ReaderBottomTabBar.ets",
    "entry/src/main/ets/ui/feedback/ReaderTransientFeedback.ts",
    "entry/src/main/ets/ui/feedback/ReaderTransientToast.ets"
  ],
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "channel": "business",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "retained-before",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-list",
        "reader-source-filter-block",
        "reader-source-footer"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current"
          }
        }
      ]
    },
    {
      "id": "return-settings",
      "kind": "action",
      "op": "keyEvent",
      "from": "retained-before",
      "key": "Back",
      "waitFor": [
        {
          "kind": "source.route",
          "channel": "business",
          "fields": {
            "payload.action": "close",
            "payload.from": "source",
            "payload.to": "settings"
          }
        }
      ]
    },
    {
      "id": "settings-return",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "return-settings"
    },
    {
      "id": "reopen-sources",
      "kind": "action",
      "op": "click",
      "from": "settings-return",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "channel": "business",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "retained-failure",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-list",
        "reader-source-filter-block",
        "reader-source-footer",
        "reader-source-retained-read-retry"
      ],
      "keyboard": false,
      "afterAction": "reopen-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.readFact": "refreshFailed",
            "payload.state": "rows"
          }
        }
      ],
      "quietMs": 500
    },
    {
      "id": "refresh-read-edge",
      "kind": "action",
      "op": "click",
      "from": "retained-failure",
      "target": "reader-source-retained-read-retry",
      "tapEdge": "top",
      "requireFullContainment": true,
      "beforeEvent": [
        {
          "kind": "source.projection",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.readFact": "refreshFailed",
            "payload.state": "rows"
          }
        }
      ],
      "waitFor": [
        {
          "kind": "source.read-retry",
          "channel": "business",
          "fields": {
            "payload.phase": "started"
          }
        }
      ]
    },
    {
      "id": "refresh-settled",
      "kind": "sample",
      "afterAction": "refresh-read-edge",
      "keyboard": false,
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list"
      ],
      "waitFor": [
        {
          "kind": "source.read-retry",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.phase": "settled"
          }
        }
      ],
      "quietMs": 750
    }
  ],
  "assertions": [
    {
      "id": "source.load.retainedReadFailure",
      "evaluator": "source",
      "kind": "retained-read-failure",
      "required": false,
      "condition": "A fresh read on reopening Source Management fails after a verified populated read in the previous opening.",
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#sourceList",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "baseline": "retained-before",
      "entryAction": "open-sources",
      "returnAction": "return-settings",
      "action": "reopen-sources",
      "sample": "retained-failure",
      "expected": {
        "readFact": "refreshFailed",
        "requireNativeTouchTarget": true
      }
    },
    {
      "id": "source.load.retainedReadRetry.edge",
      "evaluator": "source",
      "kind": "retained-read-retry",
      "required": false,
      "condition": "A fresh read on reopening Source Management fails after a verified populated read in the previous opening.",
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#sourceList",
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "baseline": "retained-failure",
      "action": "refresh-read-edge",
      "sample": "refresh-settled",
      "expected": {
        "target": "reader-source-retained-read-retry",
        "position": "top",
        "conditionAssertion": "source.load.retainedReadFailure"
      }
    }
  ],
  "structure": {
    "retained-before": "retained-before",
    "retained-failure": "retained-failure",
    "refresh-settled": "refresh-settled"
  }
}
