{
  "id": "source-management.v9-group-return",
  "version": 1,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-v9-group-return-v1",
    "description": "Use the public 18-source fixture Reader Phase 1 public tools return sources.json, preloaded in an isolated Reader instance. Select the public query, disabled status, novel type and Phase1 Return Group A before scrolling. Open More → Group management, then use System Back and prove the same list and native More focus.",
    "publicSources": true,
    "inputs": {
      "public-source-prefix": "Phase1Return"
    }
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-content",
        "reader-source-search",
        "reader-source-editor",
        "reader-source-category-filter",
        "reader-source-status-filter",
        "reader-source-group-filter",
        "reader-source-filter-block"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.queryLength": 0,
            "payload.status": "all",
            "payload.category": "all",
            "payload.groupIndex": 0,
            "payload.allGroups": true
          },
          "channel": "business",
          "match": "latest"
        }
      ],
      "quietMs": 500
    },
    {
      "kind": "action",
      "id": "focus-fixture-query",
      "op": "click",
      "from": "source-ready",
      "target": "reader-source-editor",
      "gesture": true
    },
    {
      "kind": "locate",
      "id": "fixture-query-ime",
      "anchors": [
        "reader-source-editor"
      ],
      "focus": "reader-source-editor",
      "keyboard": true,
      "afterAction": "focus-fixture-query"
    },
    {
      "kind": "action",
      "id": "select-public-fixture",
      "op": "inputText",
      "from": "fixture-query-ime",
      "target": "reader-source-editor",
      "inputRole": "public-source-prefix",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "edit",
            "payload.queryLength": 12,
            "payload.state": "rows",
            "payload.readFact": "current"
          },
          "channel": "business"
        }
      ]
    },
    {
      "kind": "locate",
      "id": "fixture-query-edited",
      "anchors": [
        "reader-source-editor"
      ],
      "focus": "reader-source-editor",
      "keyboard": true,
      "afterAction": "select-public-fixture"
    },
    {
      "kind": "action",
      "id": "leave-fixture-ime",
      "op": "keyEvent",
      "key": "Back",
      "from": "fixture-query-edited"
    },
    {
      "kind": "locate",
      "id": "query-ready",
      "afterAction": "leave-fixture-ime",
      "anchors": [
        "reader-source-status-disabled",
        "source-category-novel"
      ],
      "keyboard": false,
      "quietMs": 250
    },
    {
      "kind": "action",
      "id": "select-disabled",
      "op": "click",
      "from": "query-ready",
      "target": "reader-source-status-disabled",
      "gesture": true,
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "status",
            "payload.status": "disabled",
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.queryLength": 12
          },
          "channel": "business"
        }
      ]
    },
    {
      "kind": "locate",
      "id": "disabled",
      "afterAction": "select-disabled",
      "anchors": [
        "source-category-novel"
      ],
      "keyboard": false,
      "quietMs": 250
    },
    {
      "kind": "action",
      "id": "select-novel",
      "op": "click",
      "from": "disabled",
      "target": "source-category-novel",
      "gesture": true,
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "category",
            "payload.category": "novel",
            "payload.status": "disabled",
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.queryLength": 12
          },
          "channel": "business"
        }
      ]
    },
    {
      "kind": "locate",
      "id": "novel",
      "afterAction": "select-novel",
      "anchors": [
        "reader-source-group-trigger"
      ],
      "keyboard": false,
      "quietMs": 250
    },
    {
      "kind": "action",
      "id": "open-group",
      "op": "click",
      "from": "novel",
      "target": "reader-source-group-trigger",
      "gesture": true,
      "waitFor": [
        {
          "kind": "source.overlay",
          "fields": {
            "payload.phase": "open",
            "payload.overlay": "group"
          }
        }
      ]
    },
    {
      "kind": "sample",
      "id": "group-open",
      "afterAction": "open-group",
      "anchors": [
        "reader-source-group-panel",
        "reader-source-group-option-2"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "kind": "action",
      "id": "select-group",
      "op": "click",
      "from": "group-open",
      "target": {
        "id": "reader-source-group-option-2",
        "ancestors": [
          "reader-source-group-panel"
        ]
      },
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "group",
            "payload.groupIndex": 2,
            "payload.allGroups": false,
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.queryLength": 12
          },
          "channel": "business"
        },
        {
          "kind": "source.overlay",
          "fields": {
            "payload.phase": "dismiss",
            "payload.overlay": "group"
          }
        }
      ]
    },
    {
      "kind": "sample",
      "id": "filtered",
      "afterAction": "select-group",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-header-tools",
        "reader-source-list",
        "reader-source-content",
        "reader-source-editor",
        "reader-source-filter-block",
        "reader-source-status-filter",
        "reader-source-category-filter",
        "reader-source-group-trigger",
        "reader-source-group-filter"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "scroll-list",
      "kind": "action",
      "op": "swipe",
      "from": "filtered",
      "target": "reader-source-list",
      "waitFor": [
        {
          "kind": "source.scroll",
          "fields": {
            "payload.trigger": "settled"
          }
        }
      ],
      "path": {
        "from": [
          0.48,
          0.78
        ],
        "to": [
          0.48,
          0.25
        ],
        "speed": 1100
      }
    },
    {
      "kind": "sample",
      "id": "scrolled",
      "afterAction": "scroll-list",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-header-tools",
        "reader-source-list",
        "reader-source-header-tools-button"
      ],
      "keyboard": false,
      "quietMs": 500
    },
    {
      "id": "open-more",
      "kind": "action",
      "op": "click",
      "from": "scrolled",
      "target": {
        "id": "reader-source-header-tools-button",
        "ancestors": [
          "reader-source-header-tools"
        ]
      }
    },
    {
      "id": "more-open",
      "kind": "sample",
      "anchors": [
        "reader-source-v9-more-menu",
        "reader-source-v9-open-groups"
      ],
      "keyboard": false,
      "afterAction": "open-more"
    },
    {
      "id": "open-groups",
      "kind": "action",
      "op": "click",
      "from": "more-open",
      "target": {
        "id": "reader-source-v9-open-groups",
        "ancestors": [
          "reader-source-v9-more-menu"
        ]
      },
      "waitFor": [
        {
          "kind": "source.v9-list-transition",
          "channel": "business",
          "fields": {
            "payload.view": "groups",
            "payload.phase": "enter"
          }
        }
      ]
    },
    {
      "id": "v9-child",
      "kind": "sample",
      "anchors": [
        "reader-source-v9-groups",
        "reader-source-v9-group-back"
      ],
      "keyboard": false,
      "afterAction": "open-groups"
    },
    {
      "id": "v9-back",
      "kind": "action",
      "op": "keyEvent",
      "key": "Back",
      "from": "v9-child",
      "waitFor": [
        {
          "kind": "source.v9-list-transition",
          "channel": "business",
          "fields": {
            "payload.view": "groups",
            "payload.phase": "return"
          }
        }
      ]
    },
    {
      "id": "restored",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-header-tools-button"
      ],
      "keyboard": false,
      "afterAction": "v9-back",
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "fields": {
            "payload.trigger": "v9-return",
            "payload.state": "rows",
            "payload.readFact": "current"
          }
        },
        {
          "kind": "source.scroll",
          "channel": "business",
          "fields": {
            "payload.trigger": "v9-list-return"
          }
        }
      ],
      "quietMs": 500
    }
  ],
  "assertions": [
    {
      "id": "source.route.entry",
      "evaluator": "source",
      "kind": "route",
      "expected": {
