{
  "id": "source-management.v9-batch-return",
  "version": 1,
  "phase": 1,
  "pageId": "source-management",
  "fixture": {
    "id": "public-source-v9-batch-return-v1",
    "description": "Use the preloaded isolated public catalogue with enough novel rows to scroll. Enter in-place batch management from its actual footer button, use System Back, and prove the same filtered row, exact offset and original footer focus. Do not select or write any sources.",
    "publicSources": true
  },
  "steps": [
    {
      "id": "bookshelf",
      "kind": "locate",
      "anchors": [
        "reader-main-tab-settings",
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false
    },
    {
      "id": "open-settings",
      "kind": "action",
      "op": "click",
      "from": "bookshelf",
      "target": "reader-main-tab-settings"
    },
    {
      "id": "settings",
      "kind": "locate",
      "anchors": [
        "reader-settings-source-management"
      ],
      "keyboard": false,
      "afterAction": "open-settings"
    },
    {
      "id": "open-sources",
      "kind": "action",
      "op": "click",
      "from": "settings",
      "target": "reader-settings-source-management",
      "waitFor": [
        {
          "kind": "source.route",
          "fields": {
            "payload.action": "open",
            "payload.from": "settings",
            "payload.to": "source"
          }
        }
      ]
    },
    {
      "id": "source-ready",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-content",
        "reader-source-search",
        "reader-source-editor",
        "reader-source-category-filter",
        "reader-source-status-filter",
        "reader-source-group-filter",
        "reader-source-filter-block",
        "source-category-novel"
      ],
      "keyboard": false,
      "afterAction": "open-sources",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.category": "all",
            "payload.status": "all",
            "payload.groupIndex": 0,
            "payload.allGroups": true,
            "payload.queryLength": 0
          },
          "channel": "business",
          "match": "latest"
        }
      ],
      "quietMs": 500
    },
    {
      "id": "select-novel",
      "kind": "action",
      "op": "click",
      "from": "source-ready",
      "target": "source-category-novel",
      "waitFor": [
        {
          "kind": "source.projection",
          "fields": {
            "payload.trigger": "category",
            "payload.category": "novel",
            "payload.state": "rows",
            "payload.readFact": "current",
            "payload.status": "all",
            "payload.groupIndex": 0,
            "payload.allGroups": true,
            "payload.queryLength": 0
          },
          "channel": "business"
        }
      ],
      "gesture": true
    },
    {
      "id": "filtered",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-content",
        "reader-source-search",
        "reader-source-editor",
        "reader-source-category-filter",
        "reader-source-status-filter",
        "reader-source-group-filter",
        "reader-source-filter-block",
        "source-category-novel"
      ],
      "keyboard": false,
      "afterAction": "select-novel",
      "quietMs": 500
    },
    {
      "id": "scroll-list",
      "kind": "action",
      "op": "swipe",
      "from": "filtered",
      "target": "reader-source-list",
      "waitFor": [
        {
          "kind": "source.scroll",
          "fields": {
            "payload.trigger": "settled"
          }
        }
      ],
      "path": {
        "from": [
          0.48,
          0.78
        ],
        "to": [
          0.48,
          0.25
        ],
        "speed": 1100
      }
    },
    {
      "id": "scrolled",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-footer-tools-button"
      ],
      "keyboard": false,
      "afterAction": "scroll-list",
      "quietMs": 500
    },
    {
      "id": "open-batch",
      "kind": "action",
      "op": "click",
      "from": "scrolled",
      "target": {
        "id": "reader-source-footer-tools-button",
        "ancestors": [
          "reader-source-footer"
        ]
      },
      "waitFor": [
        {
          "kind": "source.v9-list-transition",
          "channel": "business",
          "fields": {
            "payload.view": "batch",
            "payload.phase": "enter"
          }
        }
      ]
    },
    {
      "id": "v9-child",
      "kind": "sample",
      "anchors": [
        "reader-source-v9-batch-dock",
        "reader-source-list"
      ],
      "keyboard": false,
      "afterAction": "open-batch"
    },
    {
      "id": "v9-back",
      "kind": "action",
      "op": "keyEvent",
      "key": "Back",
      "from": "v9-child",
      "waitFor": [
        {
          "kind": "source.v9-list-transition",
          "channel": "business",
          "fields": {
            "payload.view": "batch",
            "payload.phase": "return"
          }
        }
      ]
    },
    {
      "id": "restored",
      "kind": "sample",
      "anchors": [
        "reader-source-back",
        "reader-source-footer",
        "reader-source-list",
        "reader-source-footer-tools-button"
      ],
      "keyboard": false,
      "afterAction": "v9-back",
      "waitFor": [
        {
          "kind": "source.projection",
          "channel": "business",
          "fields": {
            "payload.trigger": "v9-return",
            "payload.state": "rows",
            "payload.readFact": "current"
          }
        },
        {
          "kind": "source.scroll",
          "channel": "business",
          "fields": {
            "payload.trigger": "v9-list-return"
          }
        }
      ],
      "quietMs": 500
    }
  ],
  "assertions": [
    {
      "id": "source.route.entry",
      "evaluator": "source",
      "kind": "route",
      "expected": {
        "action": "open",
        "from": "settings",
        "to": "source",
        "anchor": "reader-source-back"
      },
      "source": "entry/src/main/ets/app/composition/ReaderSourceJourney.ets#ReaderSourceJourney",
      "required": true,
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "sample": "source-ready",
      "action": "open-sources"
    },
    {
      "id": "source.filter.novel-before-footer-tools",
      "evaluator": "source",
      "kind": "filter-selection",
      "sample": "filtered",
      "baseline": "source-ready",
      "action": "select-novel",
      "expected": {
        "trigger": "category",
        "field": "category",
        "value": "novel",
        "nativeSelection": true
      },
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#rebuildSourceProjection",
      "required": true,
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ]
    },
    {
      "id": "source.v9.batch.return-position",
      "evaluator": "source",
      "kind": "v9-list-return",
      "expected": {
        "view": "batch",
        "proof": "position",
        "tolerancePx": 1
      },
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#completeV9ListReturn",
      "required": true,
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "action": "v9-back",
      "sample": "restored",
      "baseline": "scrolled",
      "departAction": "open-batch",
      "toolsSample": "v9-child"
    },
    {
      "id": "source.v9.batch.return-focus",
      "evaluator": "source",
      "kind": "v9-list-return",
      "expected": {
        "view": "batch",
        "proof": "focus",
        "tolerancePx": 1
      },
      "source": "entry/src/main/ets/features/source/ui/SourceManagementPage.ets#onToolsEntryFocused",
      "required": true,
      "sources": [
        "native-tree",
        "window-metrics",
        "app-owner"
      ],
      "action": "v9-back",
      "sample": "restored",
      "baseline": "scrolled",
      "departAction": "open-batch",
      "toolsSample": "v9-child"
    }
  ],
  "ownerSources": [
    "entry/src/main/ets/features/source/ui/SourceManagementPage.ets",
    "entry/src/main/ets/features/source/ui/SourceJourneySurface.ets",
    "entry/src/main/ets/features/source/ui/SourceManagementVerification.ts",
    "entry/src/main/ets/features/source/presentation/SourceManagementScrollState.ts",
    "entry/src/main/ets/ui/chrome/PageBackBar.ets",
    "entry/src/main/ets/app/composition/ReaderSourceJourney.ets",
    "entry/src/main/ets/app/navigation/ReaderNavigation.ts",
    "entry/src/main/ets/ui/controls/ReaderButton.ets"
  ],
  "structure": {
    "source-ready": "source-ready",
    "filtered": "filtered",
    "scrolled": "scrolled",
    "v9-child": "v9-child",
    "restored": "restored"
  }
}
