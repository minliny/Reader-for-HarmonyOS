{
  "id": "reading.control-directory-chapter-select",
  "version": 2,
  "phase": 1,
  "pageId": "reading",
  "fixture": {
    "id": "public-local-reading-directory-chapter-v1",
    "bookTitle": "Reader Phase 1 公共长目录",
    "description": "Open Directory directly, hide the native IME and select a chapter while retaining the original owner."
  },
  "steps": [
    {
      "id": "reading-book-entry",
      "kind": "locate",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "book": true
    },
    {
      "id": "enter-reading",
      "kind": "action",
      "op": "click",
      "from": "reading-book-entry",
      "target": {
        "publicBookTitle": "Reader Phase 1 公共长目录"
      },
      "waitFor": [
        {
          "kind": "reading.ready",
          "fields": {
            "payload.localBook": true,
            "payload.reduceMotion": false,
            "payload.chapterIndex": 0
          }
        }
      ]
    },
    {
      "id": "reading-before",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "enter-reading",
      "quietMs": 500,
      "anyAnchor": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ]
    },
    {
      "id": "open",
      "kind": "action",
      "op": "click",
      "from": "reading-before",
      "target": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ],
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        }
      ],
      "gesture": true
    },
    {
      "id": "open-state",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "open",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        }
      ]
    },
    {
      "id": "enter-directory",
      "kind": "action",
      "op": "click",
      "from": "open-state",
      "target": "reader-control-entry-directory",
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        }
      ]
    },
    {
      "id": "enter-directory-state",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "enter-directory",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        }
      ]
    },
    {
      "id": "focus-directory-editor",
      "kind": "action",
      "op": "click",
      "from": "enter-directory-state",
      "target": {
        "id": "reader-control-directory-query-directory",
        "ancestors": [
          "reader-control-module-directory"
        ]
      },
      "waitFor": [
        {
          "kind": "reading.control-layer",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.origin": "directory",
            "payload.active": true,
            "payload.inputKind": "inlineEditor",
            "payload.location.form": "full",
            "payload.location.directoryTab": "directory"
          }
        }
      ]
    },
    {
      "id": "directory-editor-ime",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage",
        "reader-control-module-directory",
        "reader-control-directory-query-directory"
      ],
      "keyboard": true,
      "focus": "reader-control-directory-query-directory",
      "afterAction": "focus-directory-editor",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "reading.control-layer",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.origin": "directory",
            "payload.active": true,
            "payload.inputKind": "inlineEditor",
            "payload.location.form": "full",
            "payload.location.directoryTab": "directory"
          }
        }
      ],
      "nativeImeKey": "huawei-directory-hide"
    },
    {
      "id": "directory-soft-ime-hide",
      "kind": "action",
      "op": "tapImeHide",
      "from": "directory-editor-ime",
      "target": "reader-control-directory-query-directory"
    },
    {
      "id": "directory-editor-ime-hidden",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage",
        "reader-control-directory-chapter:1"
      ],
      "keyboard": false,
      "afterAction": "directory-soft-ime-hide",
      "quietMs": 500
    },
    {
      "id": "select-directory-chapter",
      "kind": "action",
      "op": "click",
      "from": "directory-editor-ime-hidden",
      "target": "reader-control-directory-chapter:1",
      "beforeEvent": [
        {
          "kind": "reading.ready",
          "channel": "business",
          "match": "latest",
          "fields": {
            "payload.localBook": true,
            "payload.chapterIndex": 0
          }
        }
      ],
      "waitFor": [
        {
          "kind": "reading.control-effect",
          "channel": "business",
          "fields": {
            "payload.kind": "directory-selection",
            "payload.phase": "selection-admitted"
          }
        }
      ]
    },
    {
      "id": "selected-reading",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "select-directory-chapter",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "reading.control-effect",
          "channel": "business",
          "fields": {
            "payload.kind": "directory-selection",
            "payload.phase": "selection-committed"
          }
        },
        {
          "kind": "reading.control-transition-committed",
          "channel": "business",
          "fields": {
            "payload.direction": "dismiss",
            "payload.target.level": "hidden"
          }
        }
      ]
    }
  ],
  "ownerSources": [
    "entry/src/main/ets/features/reading/ui/ReaderControlPanel.ets",
    "entry/src/main/ets/features/reading/ui/LocalReadingExperience.ets",
    "entry/src/main/ets/features/reading/ui/ReaderControlSessionState.ts",
