{
  "id": "reading.control-replace-temporary",
  "version": 2,
  "phase": 1,
  "pageId": "reading",
  "fixture": {
    "id": "public-local-reading-v1",
    "bookTitle": "Reader Phase 0 公共测试书",
    "description": "Open Replace directly and verify its temporary rule editor opens and closes in the same reader session."
  },
  "steps": [
    {
      "id": "reading-book-entry",
      "kind": "locate",
      "anchors": [
        "reader-bookshelf-search-entry"
      ],
      "keyboard": false,
      "book": true
    },
    {
      "id": "enter-reading",
      "kind": "action",
      "op": "click",
      "from": "reading-book-entry",
      "target": {
        "publicBookTitle": "Reader Phase 0 公共测试书"
      },
      "waitFor": [
        {
          "kind": "reading.ready",
          "fields": {
            "payload.localBook": true,
            "payload.reduceMotion": false
          }
        }
      ]
    },
    {
      "id": "reading-before",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "enter-reading",
      "quietMs": 500,
      "anyAnchor": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ]
    },
    {
      "id": "open",
      "kind": "action",
      "op": "click",
      "from": "reading-before",
      "target": [
        "reader-reading-interaction-host-continuous",
        "reader-reading-interaction-host-paged"
      ],
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        }
      ],
      "gesture": true
    },
    {
      "id": "open-state",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "open",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        }
      ]
    },
    {
      "id": "enter-replace",
      "kind": "action",
      "op": "click",
      "from": "open-state",
      "target": "reader-control-entry-replace",
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        }
      ]
    },
    {
      "id": "enter-replace-state",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "enter-replace",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "reading.control-transition-committed"
        }
      ]
    },
    {
      "id": "open-layer",
      "kind": "action",
      "op": "click",
      "from": "enter-replace-state",
      "target": "reader-control-replace-tool-add",
      "waitFor": [
        {
          "kind": "reading.control-layer",
          "fields": {
            "payload.origin": "replace",
            "payload.active": true
          }
        }
      ],
      "gesture": true
    },
    {
      "id": "open-layer-state",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "open-layer",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "reading.control-layer",
          "fields": {
            "payload.origin": "replace",
            "payload.active": true
          }
        }
      ]
    },
    {
      "id": "close-layer",
      "kind": "action",
      "op": "keyEvent",
      "from": "open-layer-state",
      "waitFor": [
        {
          "kind": "reading.control-layer",
          "fields": {
            "payload.origin": "replace",
            "payload.active": false
          }
        }
      ]
    },
    {
      "id": "close-layer-state",
      "kind": "sample",
      "anchors": [
        "reader-reading-stage"
      ],
      "keyboard": false,
      "afterAction": "close-layer",
      "quietMs": 500,
      "waitFor": [
        {
          "kind": "reading.control-layer",
          "fields": {
            "payload.origin": "replace",
            "payload.active": false
          }
        }
      ]
    }
  ],
