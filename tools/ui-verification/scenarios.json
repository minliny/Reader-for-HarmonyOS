      "mode": "normal",
      "scene": "normal-entry",
      "width": 366,
      "readyIdPrefix": "reader.bookshelf.cover:",
      "readyIdIncludes": ":shelf:",
      "budgetMs": 30000,
      "expect": {
        "nodes": [
          {
            "idPrefix": "reader.bookshelf.cover:",
            "idIncludes": ":shelf:",
            "visible": true,
            "first": true
          }
        ]
      },
      "actions": [
        {
          "op": "click",
          "idPrefix": "reader.bookshelf.cover:",
          "idIncludes": ":shelf:",
          "first": true,
          "waitFor": {
            "id": "reader-journey-reading-surface",
            "visible": true
          }
        },
        {
          "op": "click",
          "id": "reader-journey-reading-surface",
          "waitFor": {
            "id": "reader-journey-chapter-title",
            "visible": true
          },
          "expect": {
            "nodes": [
              {
                "id": "reader-journey-chapter-title",
                "visible": true,
                "textNonEmpty": true
              }
            ]
          }
        },
        {
          "op": "capture",
          "id": "reader-journey-chapter-title",
          "as": "before"
        },
        {
          "op": "click",
          "id": "reader-journey-next-chapter",
          "requireEnabled": true,
          "waitFor": {
            "id": "reader-journey-chapter-title",
            "visible": false
          }
        },
        {
          "op": "click",
          "id": "reader-journey-reading-surface",
          "waitFor": {
            "id": "reader-journey-chapter-title",
            "visible": true
          },
          "expect": {
            "nodes": [
              {
                "id": "reader-journey-chapter-title",
                "textNotEqualsCapture": "before"
              }
            ]
          }
        },
        {
          "op": "capture",
          "id": "reader-journey-chapter-title",
          "as": "after"
        },
        {
          "op": "click",
          "id": "reader-journey-exit-reading",
          "waitFor": {
            "id": "reader-journey-reading-surface",
            "absent": true
          }
        },
        {
          "op": "click",
          "idPrefix": "reader.bookshelf.cover:",
          "idIncludes": ":shelf:",
          "first": true,
          "waitFor": {
            "id": "reader-journey-reading-surface",
            "visible": true
          }
        },
        {
          "op": "click",
          "id": "reader-journey-reading-surface",
          "waitFor": {
            "id": "reader-journey-chapter-title",
            "visible": true
          },
          "expect": {
            "nodes": [
              {
                "id": "reader-journey-chapter-title",
                "visible": true,
                "textEqualsCapture": "after"
