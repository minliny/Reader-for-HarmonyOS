{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reader.contracts/platform-host-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "hosts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hostId",
          "refId",
          "owner",
          "sources",
          "intent",
          "identity",
          "returnContext",
          "resultPolicy",
          "backPolicy",
          "stalePolicy",
          "status"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "hostId": {
            "type": "string",
            "minLength": 1
          },
          "refId": {
            "type": "string",
            "pattern": "^platform\\."
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "returnContext": {
            "type": "string",
            "minLength": 1
          },
          "resultPolicy": {
            "type": "array",
            "items": {
              "enum": ["completed", "cancelled", "error"]
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "backPolicy": {
            "enum": [
              "unknown",
              "platform-first",
              "application-first",
              "host-specific"
            ]
          },
          "stalePolicy": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "resolved",
              "partial",
              "unresolved"
            ]
          },
          "knownGap": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "partial",
                    "unresolved"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "knownGap"
              ],
              "properties": { "knownGap": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    }
  }
}
