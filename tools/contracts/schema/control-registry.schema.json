{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reader.contracts/control-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "controls"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "controlId",
          "owner",
          "sources",
          "states",
          "hitTarget",
          "accessibleNameSource",
          "status"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "controlId": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "hitTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "height",
              "unit",
              "status"
            ],
            "properties": {
              "width": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "height": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "unit": {
                "const": "vp"
              },
              "status": {
                "enum": [
                  "measured",
                  "spec",
                  "unverified"
                ]
              }
            }
          },
          "accessibleNameSource": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "spec",
              "manual",
              "partial"
            ]
          },
          "knownGap": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "partial"
                }
              }
            },
            "then": {
              "required": [
                "knownGap"
              ],
              "properties": { "knownGap": { "type": "string", "minLength": 1 } }
            }
          }
        ]
      }
    }
  }
}
