{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reader.contracts/contract-map.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "contracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId",
          "plane",
          "owner",
          "sources",
          "machineSource",
          "status",
          "consumedBy",
          "referenceRule",
          "evidenceBoundary"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "contractId": {
            "type": "string",
            "minLength": 1
          },
          "plane": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4",
              "P5",
              "P6"
            ]
          },
          "machineSource": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "status": {
            "enum": [
              "mature",
              "partial",
              "manual",
              "missing"
            ]
          },
          "consumedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "referenceRule": {
            "type": "string",
            "minLength": 1
          },
          "evidenceBoundary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
