{
  "schema": 1,
  "boundary": "All Index ReaderRoute members, including product-disabled routes; finite actual source entries and common-host delegation, not device acceptance.",
  "routes": [
    {
      "route": "bookshelf",
      "category": "mainTab",
      "bindings": [
        {
          "entry": "pages/Index.ets#Index#bookshelfShellContent",
          "hostMethod": "features/shell/MainTabShell.ets#MainTabShell#build",
          "host": "ReaderPageScaffold",
          "variant": "mainTab",
          "contentEntries": [
            "features/bookshelf/BookshelfPage.ets#BookshelfPage#build",
            "features/bookshelf/BookshelfEmptyPage.ets#BookshelfEmptyPage#build",
            "features/bookshelf/BookshelfStatusContent.ets#BookshelfStatusContent#build"
          ]
        }
      ]
    },
    {
      "route": "discover",
      "category": "mainTab",
      "bindings": [
        {
          "entry": "features/discover/DiscoverPage.ets#DiscoverPage#build",
          "hostMethod": "features/shell/MainTabShell.ets#MainTabShell#build",
          "host": "ReaderPageScaffold",
          "variant": "mainTab"
        }
      ]
    },
    {
      "route": "rss",
      "category": "mainTab",
      "bindings": [
        {
          "entry": "features/rss/RssPage.ets#RssPage#build",
          "hostMethod": "features/shell/MainTabShell.ets#MainTabShell#build",
          "host": "ReaderPageScaffold",
          "variant": "mainTab"
        }
      ]
    },
    {
      "route": "detail",
      "category": "detail",
      "bindings": [
        {
          "entry": "features/bookshelf/LocalBookDetail.ets#LocalBookDetail#build",
          "hostMethod": "features/bookshelf/LocalBookDetail.ets#LocalBookDetail#detailPage",
          "host": "ReaderPageScaffold",
          "variant": "this.book.contentKind === 'manga' ? 'mangaDetail' : 'detail'"
        }
      ]
    },
    {
      "route": "reading",
      "category": "reader",
      "bindings": [
        {
          "entry": "features/shell/ReaderShell.ets#ReaderShell#build",
          "hostMethod": "features/shell/ReaderShell.ets#ReaderShell#build",
          "host": "ReaderPageScaffold",
          "variant": "reader",
          "inputFacts": { "readingContentKind": "this.contentKind", "pageVisible": "this.visible" }
        }
      ]
    },
    {
      "route": "directory",
      "category": "directory",
      "bindings": [
        {
          "entry": "features/bookshelf/BookDirectoryPage.ets#BookDirectoryPage#build",
          "hostMethod": "features/bookshelf/BookDirectoryPage.ets#BookDirectoryPage#standardPage",
          "host": "ReaderPageScaffold",
          "variant": "directory"
        },
        {
          "entry": "features/bookshelf/BookDirectoryPage.ets#BookDirectoryPage#build",
          "hostMethod": "features/bookshelf/BookDirectoryPage.ets#BookDirectoryPage#mangaPage",
          "host": "ReaderPageScaffold",
          "variant": "mangaDirectory"
        }
      ]
    },
    {
      "route": "search",
