  "actors": [
    {
      "component": "features/common/ReaderDialogSurface.ets#ReaderDialogSurface",
      "kind": "businessWindow",
      "reason": "Existing dialogs keep their explicit modal boundary.",
      "contract": "tools/test-json-import-dialog-real.mjs"
    },
    {
      "component": "features/reading/SourceSwitchPanel.ets#SourceSwitchPanel",
      "kind": "businessWindow",
      "reason": "Source-switch transaction UI has its own identity/lifecycle contract.",
      "contract": "tools/test-source-switch-index-owner-sdk.mjs"
    },
    {
      "component": "features/common/ReaderRecoveryNotice.ets#ReaderRecoveryNotice",
      "kind": "nonmodalFeedback",
      "reason": "One intrinsic recovery notice; route/runtime and generation actions have actual SDK consumer evidence.",
      "contract": "tools/test-index-native-alert-consumers.mjs"
    },
    {
      "component": "features/common/ReaderLayoutDebugOverlay.ets#ReaderLayoutDebugOverlay",
      "kind": "runtimeDebug",
      "reason": "Explicit debug geometry guide is not an app page.",
      "contract": "tools/test-developer-mode-settings.mjs"
    },
    {
      "component": "app/ArkWebExecutionHost.ets#ArkWebExecutionHost",
      "kind": "executionHost",
      "reason": "Controller lifecycle host, never reading-body rendering.",
      "contract": "tools/test-arkweb-network-policy.mjs"
    },
    {
      "component": "features/common/ReaderTransientToast.ets#ReaderTransientToast",
      "kind": "transientFeedback",
      "reason": "Existing app-owned short-feedback host is not a page frame.",
      "contract": "tools/test-index-native-alert-consumers.mjs"
    },
    {
      "component": "features/bookshelf/BookshelfNavigationTransition.ets#BookshelfNavigationTransition",
      "kind": "transition",
      "reason": "Retained cover transition overlays pages without owning their frame.",
      "contract": "tools/test-book-opening-timeline.mjs"
    },
    {
      "component": "features/search/ReaderLibrarySearchSurface.ets#ReaderLibrarySearchSurface",
      "kind": "embeddedSurface",
      "reason": "Library header/history overlay has an explicit results Builder slot that must remain traversable.",
      "contract": "tools/test-library-search-surface-binding.mjs",
      "slots": [
        "results"
      ]
    },
    {
      "component": "features/bookshelf/LocalImportDialog.ets#LocalImportDialog",
      "kind": "businessWindow",
      "reason": "Existing local-import selection/progress/result dialog retains its specific bounded composition and operation lifecycle.",
      "contract": "tools/test-bounded-local-import-composition.mjs"
    }
  ],
  "standalone": [
    {
      "component": "features/bookshelf/BookDirectoryPage.ets#BookDirectoryPage",
      "props": {
        "contentKind": "text"
      },
      "reason": "The original bounded text fallback and manga page both retain a common frame."
