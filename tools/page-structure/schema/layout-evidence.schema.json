{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pageId",
    "command",
    "inputs",
    "widths",
    "fontScales",
    "results",
    "targets",
    "budgets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "pageId": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "cases"
      ],
      "properties": {
        "entry": {
          "enum": [
            "tools/test-source-management-layout.mjs",
            "tools/page-structure/source-e2-evidence.mjs"
          ]
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "matrix",
              "complete-targets"
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "widths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "fontScales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "nativeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "sourceE2ReceiptGroup": {
      "$ref": "#/properties/nativeEvidence"
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "E2",
        "E3"
      ],
      "properties": {
        "E2": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "E3": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "controlRef",
          "width",
          "fontScale",
          "visual",
          "response"
        ],
        "properties": {
          "controlRef": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fontScale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "visual": {
            "anyOf": [
              {
                "$ref": "#/definitions/size"
              },
              {
                "type": "null"
              }
            ]
          },
          "response": {
            "anyOf": [
              {
                "$ref": "#/definitions/size"
              },
              {
                "type": "null"
              }
            ]
          },
          "minimum": {
            "$ref": "#/definitions/size"
          },
          "basis": {
            "enum": [
              "exact-sdk-size",
              "native-constraint-minimum",
              "percentage-parent-minimum"
            ]
          },
          "sourceRecords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          }
        },
        "anyOf": [
          {
            "properties": {
              "visual": {
                "$ref": "#/definitions/size"
              }
            }
          },
          {
            "required": [
              "minimum"
            ],
            "properties": {
              "minimum": {
                "$ref": "#/definitions/size"
              }
            }
          }
        ]
      }
    },
    "budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "width",
          "fontScale",
          "availableWidth",
          "requiredWidth",
          "availableHeight",
          "requiredHeight",
          "rowForm",
          "measurementKind"
        ],
        "properties": {
          "region": {
            "enum": [
              "row",
              "chip",
              "footer"
            ]
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fontScale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "availableWidth": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "requiredWidth": {
            "type": "number",
            "minimum": 0
          },
          "availableHeight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "requiredHeight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rowForm": {
            "enum": [
              "single-line",
              "two-line",
              "overflow-menu",
              "detail-entry",
              "stacked",
              "wrap"
            ]
          },
          "measurementKind": {
            "enum": [
              "sdk",
              "native"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "nativeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "pageId",
        "measurementProvider",
        "inputs",
        "widths",
        "fontScales",
        "samples"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "measurementProvider": {
          "enum": [
            "reader-native-text-node",
            "reader-native-page-capture"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "widths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "fontScales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "width",
              "fontScale",
              "requiredWidth",
              "requiredHeight"
            ],
            "properties": {
              "region": {
                "enum": [
                  "row",
                  "chip",
                  "footer"
                ]
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "fontScale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "requiredWidth": {
                "type": "number",
                "minimum": 0
              },
              "requiredHeight": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
