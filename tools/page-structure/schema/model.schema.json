{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "0.2"
    },
    "prototypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "headerRole": {
            "enum": [
              "Home",
              "Back",
              "Contextual",
              "None"
            ]
          },
          "headerPresentations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Fixed",
                "Floating",
                "ScrollAway",
                "None"
              ]
            }
          },
          "queryPlacements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Inline",
                "HeaderSlot",
                "Overlay",
                "None"
              ]
            }
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "type": "string",
            "enum": [
              "detailed",
              "grammar"
            ]
          },
          "when": {
            "$ref": "#/definitions/when"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "compositionVariants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "when",
                "headerRole",
                "regions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "$ref": "#/definitions/when"
                },
                "headerRole": {
                  "enum": [
                    "Home",
                    "Back",
                    "Contextual",
                    "None"
                  ]
                },
                "regions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          }
        },
        "required": [
          "id",
          "depth",
          "when",
          "regions",
          "headerRole",
          "headerPresentations",
          "queryPlacements"
        ],
        "additionalProperties": false
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "route",
              "scaffold",
              "informationArchitecture",
              "header",
              "scroll",
              "content",
              "query",
              "footer",
              "overlay",
              "states",
              "visual",
              "interaction",
              "adaptation",
              "accessibility",
              "measurement",
              "dataLifecycle"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "requiredFacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "index",
          "requiredFacts"
        ],
        "additionalProperties": false
      },
      "minItems": 16,
      "uniqueItems": true
    },
    "decisions": {
      "type": "object",
      "properties": {
        "header": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "when": {
                    "$ref": "#/definitions/when"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "when",
                  "result"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rules",
            "default"
          ],
          "additionalProperties": false
        },
        "query": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "when": {
                    "$ref": "#/definitions/when"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "when",
                  "result"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rules",
            "default"
          ],
          "additionalProperties": false
        },
        "primaryAction": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "when": {
                    "$ref": "#/definitions/when"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "when",
                  "result"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rules",
            "default"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "header",
        "query",
        "primaryAction"
      ],
      "additionalProperties": false
    },
    "illegalCombinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-\\d{2}$"
          },
          "layer": {
            "type": "string",
            "enum": [
              "route",
              "scaffold",
              "informationArchitecture",
              "header",
              "scroll",
              "content",
              "query",
              "footer",
              "overlay",
              "states",
              "visual",
              "interaction",
              "adaptation",
              "accessibility",
              "measurement",
              "dataLifecycle"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "checkMode": {
            "type": "string",
            "enum": [
              "automatic",
              "manual"
            ]
          }
        },
        "required": [
          "id",
          "layer",
          "description",
          "checkMode"
        ],
        "additionalProperties": false
      },
      "minItems": 16,
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[SBE]\\d+$"
          },
          "layer": {
            "type": "string",
            "enum": [
              "route",
              "scaffold",
              "informationArchitecture",
              "header",
              "scroll",
              "content",
              "query",
              "footer",
              "overlay",
              "states",
              "visual",
              "interaction",
              "adaptation",
              "accessibility",
              "measurement",
              "dataLifecycle"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "Blocker",
              "Major",
              "Minor",
              "Info"
            ]
          },
          "exceptionAllowed": {
            "type": "boolean"
          },
          "checkMode": {
            "type": "string",
            "enum": [
              "automatic",
              "manual"
            ]
          }
        },
        "required": [
          "id",
          "layer",
          "description",
          "severity",
          "exceptionAllowed",
          "checkMode"
        ],
        "additionalProperties": false
      },
      "minItems": 22,
      "uniqueItems": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PASS",
          "FAIL",
          "EXCEPTION",
          "NOT_RUN"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    },
    "structureSelectors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "object", "minProperties": 1 }
    },
    "structureFoundations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
    },
    "structureRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "basis", "requires", "checks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layer": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 },
          "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "object" } }
        }
      }
    },
    "scenarioObligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "states", "actions"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "states": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "actions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "null"] } },
          "conditions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
          "conditionalEndpoints": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "assertion"],
              "properties": {
                "version": { "type": "integer", "minimum": 1 },
                "assertion": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "receiptCoverageReferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId", "routeContractRef", "claim", "basisInput", "cases", "remaining"],
        "properties": {
          "pageId": { "type": "string", "minLength": 1 },
          "routeContractRef": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "pattern": "^invariants\\.[a-zA-Z0-9_-]+$" },
          "basisInput": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path"],
            "properties": {
              "kind": { "enum": ["target-inventory", "layout-matrix"] },
              "path": { "type": "string", "pattern": "^tools/page-structure/[a-zA-Z0-9_-]+\\.json$" }
            }
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["caseId", "assertions", "ownerSources", "scope"],
              "properties": {
                "caseId": { "$ref": "#/definitions/receiptAdmissionCaseId" },
                "assertions": { "$ref": "#/definitions/receiptAdmissionAssertions" },
                "ownerSources": { "$ref": "#/definitions/receiptAdmissionOwners" },
                "targetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "gestureIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
                "scope": { "type": "string", "minLength": 1 }
              }
            }
          },
          "remaining": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "receiptAdmissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pageId",
          "routeContractRef",
          "claim"
        ],
        "oneOf": [
          {
            "required": ["caseId", "assertions", "ownerSources"],
            "properties": { "caseId": {}, "assertions": {}, "ownerSources": {}, "cases": false, "matrix": false, "interactions": false }
          },
          { "required": ["cases"], "properties": { "cases": {}, "matrix": false, "interactions": false }, "maxProperties": 4 },
          {
            "required": ["cases", "matrix"],
            "properties": {
              "pageId": { "const": "source-management" },
              "routeContractRef": { "const": "nav.source" },
              "claim": { "const": "invariants.E3" },
              "cases": {},
              "matrix": {}
            },
            "maxProperties": 5
          },
          {
            "required": ["cases", "interactions"],
            "properties": {
              "pageId": { "const": "source-management" },
              "routeContractRef": { "const": "nav.source" },
              "claim": { "const": "invariants.E2" }
            },
            "maxProperties": 5
          }
        ],
        "properties": {
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "routeContractRef": {
            "type": "string",
            "minLength": 1
          },
          "caseId": {
            "$ref": "#/definitions/receiptAdmissionCaseId"
          },
          "claim": {
            "type": "string",
            "pattern": "^(layers|invariants)\\.[a-zA-Z0-9_-]+$"
          },
          "assertions": {
            "$ref": "#/definitions/receiptAdmissionAssertions"
          },
          "ownerSources": {
            "$ref": "#/definitions/receiptAdmissionOwners"
          },
          "matrix": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/sourceE3MatrixCell" }
          },
          "interactions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inventorySha256", "cells"],
            "properties": {
              "inventorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "cells": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/definitions/sourceE2InteractionCell" }
              }
            }
          },
          "cases": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["caseId", "assertions", "ownerSources"],
              "properties": {
                "caseId": { "$ref": "#/definitions/receiptAdmissionCaseId" },
                "assertions": { "$ref": "#/definitions/receiptAdmissionAssertions" },
                "ownerSources": { "$ref": "#/definitions/receiptAdmissionOwners" }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "modelVersion",
    "prototypes",
    "layers",
    "decisions",
    "illegalCombinations",
    "invariants",
    "results"
  ],
  "additionalProperties": false,
  "definitions": {
    "sourceE2InteractionCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "widthVp", "fontScale", "checks"],
      "properties": {
        "id": { "$ref": "#/definitions/receiptAdmissionCaseId" },
        "widthVp": { "type": "number", "exclusiveMinimum": 0 },
        "fontScale": { "type": "number", "exclusiveMinimum": 0 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caseId", "assertionId", "subject", "kind"],
            "properties": {
              "caseId": { "$ref": "#/definitions/receiptAdmissionCaseId" },
              "assertionId": { "$ref": "#/definitions/receiptAdmissionCaseId" },
              "subject": { "$ref": "#/definitions/receiptAdmissionCaseId" },
              "kind": {
                "enum": ["target-area", "center", "top", "right", "bottom", "left", "disabled", "outside-dismiss", "focus", "gesture"]
              }
            }
          }
        }
      }
    },
    "sourceE3MatrixCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widthVp", "heightVp", "fontScale", "orientation", "samples"],
      "properties": {
        "widthVp": { "type": "number", "exclusiveMinimum": 0 },
        "heightVp": { "type": "number", "exclusiveMinimum": 0 },
        "fontScale": { "type": "number", "exclusiveMinimum": 0 },
        "orientation": { "enum": ["portrait", "landscape"] },
        "samples": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caseId", "sampleId", "scope", "textAssertions"],
            "properties": {
              "caseId": { "$ref": "#/definitions/receiptAdmissionCaseId" },
              "sampleId": { "type": "string", "minLength": 1 },
              "scope": {
                "enum": [
                  "default", "expanded", "status-filter", "category-filter", "group-menu", "row-actions",
                  "read-empty", "read-failed", "retained-read-failed", "operation-status", "operation-recovery"
                ]
              },
              "textAssertions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "roles"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "roles": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "receiptAdmissionCaseId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:-]+$"
    },
    "receiptAdmissionAssertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sampleId"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sampleId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "receiptAdmissionOwners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^entry/src/main/ets/" }
    },
    "when": {
      "type": "object",
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "root",
            "secondary",
            "detail",
            "modal",
            "reader"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "browse",
            "search",
            "select",
            "read",
            "inspect",
            "form"
          ]
        },
        "content": {
          "type": "string",
          "enum": [
            "collection",
            "document",
            "form",
            "canvas"
          ]
        },
        "queryPriority": {
          "type": "string",
          "enum": [
            "none",
            "secondary",
            "primary",
            "complex"
          ]
        },
        "queryComplexity": {
          "type": "string",
          "enum": [
            "simple",
            "complex"
          ]
        },
        "queryFrequency": {
          "type": "string",
          "enum": [
            "frequent",
            "rare"
          ]
        },
        "collectionLength": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ]
        },
        "navigationPersistence": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "none"
          ]
        },
        "alternateNavigation": {
          "type": "boolean"
        },
        "contentImmersive": {
          "type": "boolean"
        },
        "titleCanExit": {
          "type": "boolean"
        },
        "primaryActionScope": {
          "type": "string",
          "enum": [
            "none",
            "global",
            "perItem",
            "navigation"
          ]
        },
        "selectionMode": {
          "type": "string",
          "enum": [
            "none",
            "single",
            "multi"
          ]
        },
        "stateSet": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "messageSet": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "transient",
              "recovery",
              "pageState",
              "confirm",
              "task"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "platformSet": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "filePicker",
              "loginWeb",
              "nativeAlert",
              "share",
              "mediaSession",
              "externalOpen",
              "permission",
              "backgroundTask"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "widthClass": {
          "type": "string",
          "enum": [
            "compact",
            "regular",
            "expanded"
          ]
        },
        "fontScale": {
          "type": "number",
          "minimum": 1,
          "maximum": 3.2
        },
        "queryHeightClass": {
          "type": "string",
          "enum": [
            "sufficient",
            "constrained"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
