{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "0.2"
    },
    "prototypes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "headerRole": {
            "enum": [
              "Home",
              "Back",
              "Contextual",
              "None"
            ]
          },
          "headerPresentations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Fixed",
                "Floating",
                "ScrollAway",
                "None"
              ]
            }
          },
          "queryPlacements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Inline",
                "HeaderSlot",
                "Overlay",
                "None"
              ]
            }
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "type": "string",
            "enum": [
              "detailed",
              "grammar"
            ]
          },
          "when": {
            "$ref": "#/definitions/when"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "compositionVariants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "when",
                "headerRole",
                "regions"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "when": {
                  "$ref": "#/definitions/when"
                },
                "headerRole": {
                  "enum": [
                    "Home",
                    "Back",
                    "Contextual",
                    "None"
                  ]
                },
                "regions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true,
                  "minItems": 1
                }
              }
            }
          }
        },
        "required": [
          "id",
          "depth",
          "when",
          "regions",
          "headerRole",
          "headerPresentations",
          "queryPlacements"
        ],
        "additionalProperties": false
      },
      "minItems": 6,
      "uniqueItems": true
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "route",
              "scaffold",
              "informationArchitecture",
              "header",
              "scroll",
              "content",
              "query",
              "footer",
              "overlay",
              "states",
              "visual",
              "interaction",
              "adaptation",
              "accessibility",
              "measurement",
              "dataLifecycle"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "requiredFacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "index",
          "requiredFacts"
        ],
        "additionalProperties": false
      },
      "minItems": 16,
      "uniqueItems": true
    },
    "decisions": {
      "type": "object",
      "properties": {
        "header": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "when": {
                    "$ref": "#/definitions/when"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "when",
                  "result"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rules",
            "default"
          ],
          "additionalProperties": false
        },
        "query": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "when": {
                    "$ref": "#/definitions/when"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "when",
                  "result"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rules",
            "default"
          ],
          "additionalProperties": false
        },
        "primaryAction": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "when": {
                    "$ref": "#/definitions/when"
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "when",
                  "result"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rules",
            "default"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "header",
        "query",
        "primaryAction"
      ],
      "additionalProperties": false
    },
    "illegalCombinations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-\\d{2}$"
          },
          "layer": {
            "type": "string",
            "enum": [
              "route",
              "scaffold",
              "informationArchitecture",
              "header",
              "scroll",
              "content",
              "query",
              "footer",
              "overlay",
              "states",
              "visual",
              "interaction",
              "adaptation",
              "accessibility",
              "measurement",
              "dataLifecycle"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "checkMode": {
            "type": "string",
            "enum": [
              "automatic",
              "manual"
            ]
          }
        },
        "required": [
          "id",
          "layer",
          "description",
          "checkMode"
        ],
        "additionalProperties": false
      },
      "minItems": 16,
      "uniqueItems": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[SBE]\\d+$"
          },
          "layer": {
            "type": "string",
            "enum": [
              "route",
              "scaffold",
              "informationArchitecture",
              "header",
              "scroll",
              "content",
              "query",
              "footer",
              "overlay",
              "states",
              "visual",
              "interaction",
              "adaptation",
              "accessibility",
              "measurement",
              "dataLifecycle"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "Blocker",
              "Major",
              "Minor",
              "Info"
            ]
          },
          "exceptionAllowed": {
            "type": "boolean"
          },
          "checkMode": {
            "type": "string",
            "enum": [
              "automatic",
              "manual"
            ]
          }
        },
        "required": [
          "id",
          "layer",
          "description",
          "severity",
          "exceptionAllowed",
          "checkMode"
        ],
        "additionalProperties": false
      },
      "minItems": 22,
      "uniqueItems": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "PASS",
          "FAIL",
          "EXCEPTION",
          "NOT_RUN"
        ]
      },
      "minItems": 4,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "modelVersion",
    "prototypes",
    "layers",
    "decisions",
    "illegalCombinations",
    "invariants",
    "results"
  ],
  "additionalProperties": false,
  "definitions": {
    "when": {
      "type": "object",
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "root",
            "secondary",
            "detail",
            "modal",
            "reader"
          ]
        },
        "purpose": {
          "type": "string",
          "enum": [
            "browse",
            "search",
            "select",
            "read",
            "inspect",
            "form"
          ]
        },
        "content": {
          "type": "string",
          "enum": [
            "collection",
            "document",
            "form",
            "canvas"
          ]
        },
        "queryPriority": {
          "type": "string",
          "enum": [
            "none",
            "secondary",
            "primary",
            "complex"
          ]
        },
        "queryComplexity": {
          "type": "string",
          "enum": [
            "simple",
            "complex"
          ]
        },
        "queryFrequency": {
          "type": "string",
          "enum": [
            "frequent",
            "rare"
          ]
        },
        "collectionLength": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ]
        },
        "navigationPersistence": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "none"
          ]
        },
        "alternateNavigation": {
          "type": "boolean"
        },
        "contentImmersive": {
          "type": "boolean"
        },
        "titleCanExit": {
          "type": "boolean"
        },
        "primaryActionScope": {
          "type": "string",
          "enum": [
            "none",
            "global",
            "perItem",
            "navigation"
          ]
        },
        "selectionMode": {
          "type": "string",
          "enum": [
            "none",
            "single",
            "multi"
          ]
        },
        "stateSet": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "messageSet": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "transient",
              "recovery",
              "pageState",
              "confirm",
              "task"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "platformSet": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "filePicker",
              "loginWeb",
              "nativeAlert",
              "share",
              "mediaSession",
              "externalOpen",
              "permission",
              "backgroundTask"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "widthClass": {
          "type": "string",
          "enum": [
            "compact",
            "regular",
            "expanded"
          ]
        },
        "fontScale": {
          "type": "number",
          "minimum": 1,
          "maximum": 3.2
        },
        "queryHeightClass": {
          "type": "string",
          "enum": [
            "sufficient",
            "constrained"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
