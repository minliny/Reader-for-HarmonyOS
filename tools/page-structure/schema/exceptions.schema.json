{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "modelVersion": {
      "const": "0.2"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "pageId": {
            "type": "string",
            "minLength": 1
          },
          "invariantId": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "compensatingControl": {
            "type": "string",
            "minLength": 1
          },
          "sinceVersion": {
            "type": "string",
            "minLength": 1
          },
          "expiresAtOrReviewTrigger": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "source",
                    "test",
                    "demo",
                    "device",
                    "user"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "FAIL",
                    "EXCEPTION",
                    "NOT_RUN"
                  ]
                }
              },
              "required": [
                "kind",
                "path",
                "result"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "pageId",
          "invariantId",
          "owner",
          "reason",
          "compensatingControl",
          "sinceVersion",
          "expiresAtOrReviewTrigger",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "modelVersion",
    "exceptions"
  ],
  "additionalProperties": false
}
