  "layers": [
    {
      "id": "route",
      "index": 1,
      "requiredFacts": [
        "parentRoutes",
        "parentCaptured",
        "entrySources",
        "backPolicy",
        "retention",
        "restorePolicy",
        "systemBackOwner",
        "platformHostRefs",
        "status",
        "unresolvedRefs"
      ]
    },
    {
      "id": "scaffold",
      "index": 2,
      "requiredFacts": [
        "prototype",
        "regions"
      ]
    },
    {
      "id": "informationArchitecture",
      "index": 3,
      "requiredFacts": [
        "blockOrder",
        "firstScreenBudget",
        "budgetStatus"
      ]
    },
    {
      "id": "header",
      "index": 4,
      "requiredFacts": [
        "role",
        "presentation",
        "composition",
        "surface",
        "height",
        "safeAreaOwner",
        "actions"
      ]
    },
    {
      "id": "scroll",
