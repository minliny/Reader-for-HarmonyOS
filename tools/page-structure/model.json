        "generation",
        "serialization",
        "stalePolicy",
        "projectionConsistency",
        "confirmedRefreshPolicy",
        "operationIds"
      ]
    }
  ],
  "decisions": {
    "header": {
      "rules": [
        {
          "when": {
            "purpose": "read"
          },
          "result": "None"
        },
        {
          "when": {
            "navigationPersistence": "required"
          },
          "result": "Fixed"
        },
        {
          "when": {
            "navigationPersistence": "optional",
            "contentImmersive": false,
            "titleCanExit": true
          },
          "result": "ScrollAway"
        },
        {
          "when": {
            "navigationPersistence": "optional",
            "contentImmersive": true,
            "titleCanExit": true
          },
          "result": "ScrollAway"
        },
        {
          "when": {
            "navigationPersistence": "optional",
            "contentImmersive": true,
            "titleCanExit": false
          },
          "result": "Floating"
        },
        {
          "when": {
            "navigationPersistence": "none",
            "alternateNavigation": true
          },
          "result": "None"
        }
      ],
      "default": "Fixed"
    },
    "query": {
      "rules": [
        {
          "when": {
            "queryPriority": "none"
          },
          "result": "None"
        },
        {
          "when": {
            "queryPriority": "primary",
            "queryHeightClass": "constrained"
          },
          "result": "Inline"
        },
        {
          "when": {
            "queryPriority": "primary"
          },
          "result": "HeaderSlot"
        },
        {
          "when": {
            "queryComplexity": "complex",
            "queryFrequency": "rare"
          },
          "result": "Overlay"
        },
        {
          "when": {
            "queryPriority": "complex"
          },
          "result": "Overlay"
        },
        {
          "when": {
            "queryPriority": "secondary"
          },
          "result": "Inline"
        }
      ],
      "default": "UNRESOLVED"
    },
    "primaryAction": {
      "rules": [
        {
          "when": {
            "primaryActionScope": "perItem"
          },
          "result": "Row"
        },
        {
          "when": {
            "primaryActionScope": "global"
          },
          "result": "Footer"
        },
        {
          "when": {
            "primaryActionScope": "navigation"
          },
          "result": "Header"
        },
        {
          "when": {
            "primaryActionScope": "none"
          },
          "result": "None"
        }
      ],
      "default": "UNRESOLVED"
    }
  },
  "illegalCombinations": [
    {
      "id": "G-01",
      "layer": "query",
      "description": "同一查询同时出现HeaderSlot与Inline",
