    {
      "id": "G-15",
      "layer": "dataLifecycle",
      "description": "已确认写后刷新失败重发写",
      "checkMode": "manual"
    },
    {
      "id": "G-16",
      "layer": "interaction",
      "description": "控件缺状态集或命中区",
      "checkMode": "automatic"
    }
  ],
