export class ScreenGraphRegistry {
  readonly document: ScreenGraphDocument
  private readonly routesById: Map<string, ScreenGraphRouteNode> = new Map<string, ScreenGraphRouteNode>()
  private readonly componentTypes: Set<string> = new Set<string>(SCREEN_GRAPH_COMPONENT_TYPES)
  private readonly eventTypes: Set<string> = new Set<string>(SCREEN_GRAPH_UI_EVENT_TYPES)

  private constructor(document: ScreenGraphDocument) {
    this.document = document
    this.validateAndIndex()
  }

  static loadCanonical(): ScreenGraphRegistry {
    return ScreenGraphRegistry.fromJSON(ScreenGraphCanonicalAsset.json)
  }

  static fromJSON(json: string): ScreenGraphRegistry {
    const parsed: object = JSON.parse(json) as object
    if (parsed === null || Array.isArray(parsed)) throw new Error('screen graph root must be an object')
    return new ScreenGraphRegistry(parsed as ScreenGraphDocument)
  }

  route(routeId: RouteId): ScreenGraphRouteNode | undefined {
    return this.routesById.get(routeId)
  }

  resolve(routeId: RouteId): ScreenGraphRouteNode {
    const visited: Set<string> = new Set<string>()
    let cursor: string = routeId
    while (true) {
      if (visited.has(cursor)) throw new Error('screen graph alias cycle: ' + routeId)
      visited.add(cursor)
      const route: ScreenGraphRouteNode | undefined = this.routesById.get(cursor)
      if (route === undefined) throw new Error('screen graph route not found: ' + cursor)
      if (route.aliasFor === null) return route
      cursor = route.aliasFor
    }
  }

  variants(routeId: RouteId, resolveAliases: boolean = true): ScreenGraphVariant[] {
    if (resolveAliases) return this.resolve(routeId).variants
    const route: ScreenGraphRouteNode | undefined = this.route(routeId)
    if (route === undefined) throw new Error('screen graph route not found: ' + routeId)
    return route.variants
  }

  variant(routeId: RouteId, variantId: string, resolveAliases: boolean = true): ScreenGraphVariant {
    const variants: ScreenGraphVariant[] = this.variants(routeId, resolveAliases)
    const match: ScreenGraphVariant | undefined = variants.find((variant: ScreenGraphVariant) => variant.variantId === variantId)
    if (match === undefined) throw new Error('screen graph variant not found: ' + routeId + '/' + variantId)
    return match
  }

  private validateAndIndex(): void {
    if (this.document.schemaVersion !== '1.2.0') throw new Error('screen graph unsupported schemaVersion')
    if (!Array.isArray(this.document.routes) || this.document.routes.length !== SCREEN_GRAPH_ROUTE_IDS.length) {
      throw new Error('screen graph RouteId count drift')
    }
    if (!Array.isArray(this.document.componentCatalog) || this.document.componentCatalog.length !== SCREEN_GRAPH_COMPONENT_TYPES.length) {
      throw new Error('screen graph ComponentType count drift')
    }
    for (let index: number = 0; index < SCREEN_GRAPH_ROUTE_IDS.length; index += 1) {
      const route: ScreenGraphRouteNode = this.document.routes[index]
      if (route.routeId !== SCREEN_GRAPH_ROUTE_IDS[index]) throw new Error('screen graph RouteId set/order drift')
      if (this.routesById.has(route.routeId)) throw new Error('screen graph duplicate route: ' + route.routeId)
      this.routesById.set(route.routeId, route)
    }
    for (let index: number = 0; index < SCREEN_GRAPH_COMPONENT_TYPES.length; index += 1) {
      if (this.document.componentCatalog[index].type !== SCREEN_GRAPH_COMPONENT_TYPES[index]) {
        throw new Error('screen graph ComponentType set/order drift')
      }
    }

    let variantCount: number = 0
    let componentCount: number = 0
    let bindingCount: number = 0
    let stateEventEvidenceCount: number = 0
    const walk = (components: ScreenGraphComponentNode[], ids: Set<string>): void => {
      if (!Array.isArray(components)) throw new Error('screen graph components must be an array')
      for (const component of components) {
        if (!this.componentTypes.has(component.type)) throw new Error('screen graph unknown ComponentType: ' + component.type)
        if (ids.has(component.id)) throw new Error('screen graph duplicate component id: ' + component.id)
        ids.add(component.id)
        componentCount += 1
        if (!Array.isArray(component.bindings)) throw new Error('screen graph bindings must be an array')
        for (const binding of component.bindings) {
          if (!this.eventTypes.has(binding.event)) throw new Error('screen graph unknown UiEvent: ' + binding.event)
          bindingCount += 1
        }
        if (!Array.isArray(component.stateEventEvidence)) throw new Error('screen graph state event evidence must be an array')
        for (const evidence of component.stateEventEvidence) {
          if (!this.eventTypes.has(evidence.event)) throw new Error('screen graph unknown state UiEvent evidence: ' + evidence.event)
          stateEventEvidenceCount += 1
        }
        walk(component.children, ids)
      }
    }
    for (const route of this.document.routes) {
      if (!Array.isArray(route.variants)) throw new Error('screen graph variants must be an array')
      const variantIds: Set<string> = new Set<string>()
      variantCount += route.variants.length
      for (const variant of route.variants) {
        if (variantIds.has(variant.variantId)) throw new Error('screen graph duplicate variant: ' + route.routeId)
        variantIds.add(variant.variantId)
        walk(variant.components, new Set<string>())
      }
    }
    if (variantCount !== ScreenGraphCanonicalAsset.variantCount) throw new Error('screen graph variant count drift')
    if (componentCount !== ScreenGraphCanonicalAsset.componentCount) throw new Error('screen graph component count drift')
    if (bindingCount !== ScreenGraphCanonicalAsset.bindingCount) throw new Error('screen graph binding count drift')
    if (stateEventEvidenceCount !== ScreenGraphCanonicalAsset.stateEventEvidenceCount) throw new Error('screen graph state event evidence count drift')
    for (const route of this.document.routes) {
      if (route.aliasFor !== null) {
        const resolved: ScreenGraphRouteNode = this.resolve(route.routeId)
        if (resolved.status !== 'direct') throw new Error('screen graph alias does not resolve to direct route')
      }
    }
  }
}
