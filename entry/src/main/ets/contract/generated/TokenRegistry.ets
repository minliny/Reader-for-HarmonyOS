  static byName(name: string): TokenEntry | undefined {
    for (const t of TokenRegistry.ALL) {
      if (t.name === name) return t;
    }
    return undefined;
  }

  static byCategory(category: TokenCategory): TokenEntry[] {
    return TokenRegistry.ALL.filter((t) => t.category === category);
  }
}
