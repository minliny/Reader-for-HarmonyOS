+describe("synchronous native admission diagnostics", () => {
+  test("peeks immediately, preserves native code and never accepts or retries rejected commands", async () => {
+    for (const detail of [
+      { code: "BUSY", nativeCode: 9, reason: "runtime request or terminal budget is occupied" },
+      { code: "RESOURCE_EXHAUSTED", nativeCode: 10, reason: "command exceeds the wire byte limit" },
+    ]) {
+      const calls: string[] = [];
+      const error = Object.assign(new Error("Reader-Core command was not admitted"), { code: detail.code });
+      const native = Object.assign(new ReceiptNativeReaderCore(), {
+        sendCommand: (): void => { calls.push("send"); throw error; },
+        lastError: (): { code: number; message: string } => {
+          calls.push("lastError"); return { code: detail.nativeCode, message: detail.reason };
+        },
+      });
+      const runtime = new ReaderCoreRuntime(native);
+      let caught: unknown;
+      try { runtime.send("runtime.ping", { privateToken: "do-not-expose" }, 37); } catch (value) { caught = value; }
+      expect(caught).toBe(error);
+      expect(error.code).toBe(detail.code);
+      expect(error.message).toBe(`Reader-Core command was not admitted: ${detail.reason}`);
+      expect(error.message).not.toContain("do-not-expose");
+      expect(calls).toEqual(["send", "lastError"]);
+      await expect(runtime.waitForResult(37)).rejects.toThrow("request was not admitted by this SDK runtime");
+      expect(native.readTimeouts).toEqual([]);
+      expect(native.acknowledged).toEqual([]);
