+#[test]
+fn book_search_large_host_result_budget_rejection_does_not_publish_books() {
+    let sink = Arc::new(ReceiptSink::default());
+    let runtime = Runtime::new(sink.clone());
+    runtime.enable_event_acknowledgements().unwrap();
+    // Keep two already-delivered requests unconsumed and reserve their full
+    // budgets. This models a slow consumer without allocating 256 MiB.
+    for id in [1001, 1002] {
+        runtime
+            .send(Command::new(id, "capacity.held", serde_json::json!({})))
+            .unwrap();
+        wait_capacity_receipt(&sink, id, true);
+    }
+    runtime
+        .capacity
+        .reserve_result(1001, crate::capacity::MAX_SINGLE_RESULT_BYTES)
+        .unwrap();
+    runtime
+        .capacity
+        .reserve_result(
+            1002,
+            crate::capacity::MAX_SINGLE_RESULT_BYTES - crate::capacity::DEFAULT_RESULT_BYTES,
+        )
+        .unwrap();
+    let (host_receipt, operation_id) = start_capacity_search(&runtime, &sink, 21);
+    assert!(runtime.acknowledge_event(host_receipt));
+    complete_capacity_search(&runtime, 22, operation_id);
+
+    let (receipt, event) = wait_capacity_receipt(&sink, 21, true);
+    assert!(matches!(event, Event::Error { ref error, .. } if error.code == ErrorCode::Busy));
+    assert!(runtime
+        .remote_state()
+        .storage()
+        .export_snapshot(0)
+        .unwrap()
+        .source_books
+        .is_empty());
+    assert!(!runtime.delivery_contract_fault());
+    assert!(runtime.acknowledge_event(receipt));
+    for id in [1001, 1002] {
+        assert!(runtime.acknowledge_event(wait_capacity_receipt(&sink, id, true).0));
+    }
+    runtime
+        .send(Command::new(
+            23,
+            methods::SEARCH_BOOK_LIST,
+            serde_json::json!({}),
+        ))
+        .unwrap();
+    let (receipt, event) = wait_capacity_receipt(&sink, 23, true);
+    assert!(matches!(event, Event::Result { .. }));
+    assert!(runtime.acknowledge_event(receipt));
+}
+
+fn wait_capacity_receipt(sink: &ReceiptSink, id: u64, terminal: bool) -> (u64, Event) {
+    let deadline = Instant::now() + Duration::from_secs(2);
+    loop {
+        if let Some(found) = sink
+            .events
+            .lock()
+            .unwrap()
+            .iter()
+            .find(|(_, event)| {
+                event_request_id(event) == Some(id)
+                    && matches!(event, Event::Result { .. } | Event::Error { .. }) == terminal
+            })
+            .cloned()
+        {
+            return found;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "missing capacity test event for {id}"
+        );
+        thread::sleep(Duration::from_millis(1));
+    }
+}
+
+fn start_capacity_search(runtime: &Runtime, sink: &ReceiptSink, id: u64) -> (u64, u64) {
+    runtime
+        .send(Command::new(
+            id,
+            methods::BOOK_SEARCH,
+            serde_json::json!({
+                "sourceId": "vtest-src",
+                "source": vertical_source(),
+                "searchRequest": { "url": "https://books.example.test/search" }
+            }),
+        ))
+        .unwrap();
+    let (receipt, event) = wait_capacity_receipt(sink, id, false);
+    let Event::HostRequest { operation_id, .. } = event else {
+        panic!("expected search Host request");
+    };
+    (receipt, operation_id)
+}
+
+fn complete_capacity_search(runtime: &Runtime, id: u64, operation_id: u64) {
+    runtime
+        .send(Command::new(
+            id,
+            methods::HOST_COMPLETE,
+            serde_json::json!({
+                "operationId": operation_id,
+                "result": {
+                    "status": 200,
+                    "headers": { "x-padding": "h".repeat(16 * 1024) },
+                    "body": serde_json::json!({ "books": [{
+                        "bookId": "large-result", "title": "t".repeat(80 * 1024), "author": "Test"
+                    }] }).to_string()
+                }
+            }),
+        ))
+        .unwrap();
