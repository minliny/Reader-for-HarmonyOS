+const { Component: HeaderComponent } = createReaderBuilderProbe(headerSource, ['trailing', 'build', 'leftInset', 'rightInset'], deps);
+for (const [width, height, left, right] of [[365, 320, 0, 0], [390, 844, 32, 24], [1280, 800, 48, 32]]) {
