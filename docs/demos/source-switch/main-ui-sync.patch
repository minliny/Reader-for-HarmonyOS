+class Header { constructor(owner, params, _storage, id) { Object.assign(this, { owner, params, id }); } }
+let activeOwner, activeId;
+const Toggle = new Proxy({ name: 'Toggle' }, { get: (target, key) => key === 'name' ? target.name : (...args) => {
