+    #[test]
+    fn source_supply_upgrade_preserves_unknown_and_compatibility_fields() {
+        let mut old = bundled(6);
+        old["customButton"] = serde_json::json!({"nested":{"future":[1,null,"kept"]}});
+        old["eventListener"] = serde_json::json!({"onRead":"synthetic callback"});
+        old["variableComment"] = "synthetic comment".into();
+        old["contentRule"] = ".compat-content".into();
+        old["sourceId"] = "synthetic-compat-id".into();
+        old["bookSourceGroup"] = "synthetic group".into();
+        old["futureNull"] = serde_json::Value::Null;
+        old["candidateWins"] = "old extension".into();
+        old["enabled"] = false.into();
+        old["enabledExplore"] = false.into();
+        old["header"] = serde_json::json!({"synthetic":"old header"});
+        old["ruleContent"]["futureNestedRule"] = "old provider rule".into();
+        old["ruleFingerprint"] = fingerprint(&old).unwrap().into();
+        let stored = parsed_candidate(old.clone());
+        let mut proposed = bundled(7);
+        proposed["ruleContent"] = serde_json::json!({"content":".new-provider-body"});
+        proposed["candidateWins"] = "new extension".into();
+        proposed["ruleFingerprint"] = fingerprint(&proposed).unwrap().into();
+        let upgraded = upgrade(parsed_candidate(proposed.clone()), &stored).unwrap().unwrap();
+        let mut expected = proposed.clone();
+        for field in ["customButton", "eventListener", "variableComment", "contentRule",
+            "sourceId", "bookSourceGroup", "futureNull", "enabled", "enabledExplore"] {
+            expected[field] = old[field].clone();
+        }
+        assert_eq!(upgraded.book_source, expected);
+        assert_eq!(upgraded.book_source["ruleContent"], proposed["ruleContent"], "provider objects are atomic");
+        assert!(upgraded.book_source.get("header").is_none(), "provider may remove its own rule field");
+        assert!(upgrade(parsed_candidate(proposed.clone()), &upgraded).unwrap().is_none(), "same version/fingerprint is read-only");
+        let mut edited = stored;
+        edited.book_source["ruleContent"]["content"] = ".user-edited".into();
+        assert!(upgrade(parsed_candidate(proposed), &edited).unwrap().is_none(), "edited rules reject whole replacement");
+    }
