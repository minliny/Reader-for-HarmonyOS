+pub(super) fn observed_format_generation(data_directory: &std::path::Path) -> Result<Option<u32>,StorageError> {
+    let path=storage_meta_path(data_directory);
+    let Ok(bytes)=std::fs::read(path) else {return Ok(None);};
+    let Ok(value)=serde_json::from_slice::<serde_json::Value>(&bytes) else {return Ok(None);};
+    let generation=value.get("dataFormatGeneration").and_then(|v|v.as_u64()).filter(|v|*v!=0);
+    if generation.is_some_and(|v|v>u64::from(STORAGE_DATA_FORMAT_GENERATION)) {
+        return Err(invalid(&format!("dataFormatTooNew.actual={}",generation.unwrap())));
+    }
+    // The supported upper bound is itself u32; conversion is safe only after
+    // rejecting every explicit larger generation, including values above u32.
+    Ok(generation.map(|value|value as u32))
+}
+
+/// Bootstrap and normal Runtime use the same owner. This entry neither creates
+/// the directory/database nor updates its sidecar. Legacy facts yield an explicit
+/// plan, never an implicit migration authorization.
+pub fn probe_storage_admission(data_directory: &std::path::Path) -> Result<StorageOpenAdmission,StorageError> {
+    let generation=observed_format_generation(data_directory)?;
+    let database=data_directory.join("reader-core.sqlite3");
+    if !database.exists() {return Ok(StorageOpenAdmission {fresh_storage:true,layout:None,requires_migration:false,explicit_migration:None,observed_data_format_generation:generation});}
+    let identity_before=database_identity(&database)?;
+    let mut conn=Connection::open_with_flags(&database,rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY).map_err(rusqlite_error)?;
+    conn.busy_timeout(std::time::Duration::from_millis(250)).map_err(rusqlite_error)?;
+    let tx=conn.transaction_with_behavior(rusqlite::TransactionBehavior::Deferred).map_err(rusqlite_error)?;
+    let version:u32=tx.pragma_query_value(None,"user_version",|r|r.get(0)).map_err(rusqlite_error)?;
+    let (mut layout,migration)=if version<SQLITE_SCHEMA_VERSION {
+        legacy_migration_preservation::validate_legacy_input(&tx,version)?;
+        (None,Some(ExplicitStorageMigration {source_schema_version:version,target_schema_version:SQLITE_SCHEMA_VERSION}))
+    } else {(Some(inspect_connection(&tx)?),None)};
+    tx.commit().map_err(rusqlite_error)?;
+    if let Some(layout)=layout.as_mut() {layout.bind_database(&database)?; if layout.database_identity.as_deref()!=Some(identity_before.as_str()) {return Err(invalid("databaseIdentityChanged"));}}
+    Ok(StorageOpenAdmission {fresh_storage:false,layout,requires_migration:migration.is_some(),explicit_migration:migration,observed_data_format_generation:generation})
+}
