+pub fn maximum_supported_schema() -> u32 { contract().layouts.iter().map(|v| v.schema_version).max().unwrap_or(0) }
+fn invalid(reason: &str) -> StorageError { StorageError::InvalidSnapshot { field: format!("storageLayout.{reason}") } }
