+//! Durable compatibility facts next to the SQLite database.
+//!
+//! `storage-meta.json` is intentionally a sibling of the database rather than a
+//! row inside it: a newer schema must remain reportable even when this binary
+//! refuses to open the database. Last-successful facts and the latest attempt
+//! are separate: a failed older executable must not rewrite the successful
+//! producer's format or build identity. SQLite and its validated layout remain
+//! authoritative; absence of this diagnostic is not evidence of an empty store.
+
+use super::{
+    rusqlite_error, SQLITE_MIN_READABLE_VERSION,
+    STORAGE_DATA_FORMAT_GENERATION,
+};
+use crate::StorageError;
+use rusqlite::{Connection, OpenFlags};
+use serde::{Deserialize, Serialize};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+pub const STORAGE_COMPATIBILITY_META_FORMAT_VERSION: u32 = 1;
+pub const STORAGE_COMPATIBILITY_META_FILE: &str = "storage-meta.json";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub enum StorageMigrationState {
+    Idle,
+    BackupPrepared,
+    Migrating,
+    Committed,
+    Blocked,
+}
+
+/// Persistent data-compatibility facts written atomically by Core.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StorageCompatibilityMeta {
+    pub format_version: u32,
+    /// Schema version actually present in the database when this record was written.
+    pub schema_version: u32,
+    pub supported_schema_version: u32,
+    pub min_readable_schema: u32,
+    pub data_format_generation: u32,
+    pub core_build_id: Option<String>,
+    pub migration_state: StorageMigrationState,
+    pub migration_source_schema: Option<u32>,
+    pub migration_target_schema: Option<u32>,
+    pub last_successful_open_at: Option<i64>,
+    pub blocked_reason: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub last_successful_open: Option<StorageSuccessfulOpen>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub last_attempt: Option<StorageOpenAttempt>,
+    #[serde(default, flatten)]
+    pub extensions: std::collections::BTreeMap<String,serde_json::Value>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StorageSuccessfulOpen {
+    pub schema_version: u32,
+    pub data_format_generation: u32,
+    pub core_build_id: Option<String>,
+    pub opened_at: i64,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct StorageOpenAttempt {
+    pub observed_schema_version: u32,
+    pub candidate_build_id: Option<String>,
+    pub attempted_at: i64,
+    pub succeeded: bool,
+    pub reason: Option<String>,
+}
+
+impl StorageCompatibilityMeta {
+    pub fn new(
+        state: StorageMigrationState,
+        schema_version: u32,
+        core_build_id: Option<String>,
+        previous: Option<&Self>,
+    ) -> Self {
+        Self {
+            format_version: STORAGE_COMPATIBILITY_META_FORMAT_VERSION,
+            schema_version,
+            supported_schema_version: super::maximum_supported_schema(),
+            min_readable_schema: SQLITE_MIN_READABLE_VERSION,
+            data_format_generation: STORAGE_DATA_FORMAT_GENERATION,
+            core_build_id,
+            migration_state: state,
+            migration_source_schema: None,
+            migration_target_schema: None,
+            last_successful_open_at: previous.and_then(|meta| meta.last_successful_open_at),
+            blocked_reason: None,
+            last_successful_open: previous.and_then(|v| v.last_successful_open.clone()),
+            last_attempt: None,
+            extensions: previous.map(|v|v.extensions.clone()).unwrap_or_default(),
+        }
+    }
+
+    pub fn blocked(
+        actual_schema: u32,
+        core_build_id: Option<String>,
+        previous: Option<&Self>,
+        reason: impl Into<String>,
+    ) -> Self {
+        let reason = reason.into();
+        let mut record = previous.cloned().unwrap_or_else(|| {
+            let mut unknown = Self::new(StorageMigrationState::Blocked, actual_schema, None, None);
+            // No successful producer facts were observed. Zero means unknown,
+            // not generation one inferred from a missing sidecar.
+            unknown.data_format_generation = 0;
+            unknown
+        });
+        if record.last_successful_open.is_none() {
+            if let Some(opened_at) = record.last_successful_open_at {
+                record.last_successful_open = Some(StorageSuccessfulOpen {
+                    schema_version:record.schema_version, data_format_generation:record.data_format_generation,
+                    core_build_id:record.core_build_id.clone(), opened_at,
+                });
+            }
+        }
+        record.migration_state = StorageMigrationState::Blocked;
+        record.blocked_reason = Some(reason.clone());
+        record.last_attempt = Some(StorageOpenAttempt { observed_schema_version:actual_schema,
+            candidate_build_id:core_build_id, attempted_at:unix_seconds(), succeeded:false, reason:Some(reason) });
+        record
+    }
+
+    pub fn successful_open(actual_schema: u32, build_id: String, previous: Option<&Self>) -> Self {
+        let now = unix_seconds();
+        let mut record = Self::new(StorageMigrationState::Idle, actual_schema, Some(build_id.clone()), previous);
+        record.last_successful_open_at = Some(now);
+        record.last_successful_open = Some(StorageSuccessfulOpen { schema_version:actual_schema,
+            data_format_generation:STORAGE_DATA_FORMAT_GENERATION, core_build_id:Some(build_id.clone()), opened_at:now });
+        record.last_attempt = Some(StorageOpenAttempt { observed_schema_version:actual_schema,
+            candidate_build_id:Some(build_id), attempted_at:now, succeeded:true, reason:None });
+        record
+    }
+}
+
+pub fn storage_meta_path(data_directory: &Path) -> PathBuf {
+    data_directory.join(STORAGE_COMPATIBILITY_META_FILE)
+}
+
+/// A missing, unreadable, or malformed record is not a database failure: it only
+/// removes the pre-open diagnostic. The database itself remains authoritative.
+pub fn read_storage_meta(data_directory: &Path) -> Option<StorageCompatibilityMeta> {
+    let bytes = std::fs::read(storage_meta_path(data_directory)).ok()?;
+    let meta: StorageCompatibilityMeta = serde_json::from_slice(&bytes).ok()?;
+    (meta.format_version == STORAGE_COMPATIBILITY_META_FORMAT_VERSION).then_some(meta)
+}
+
+/// Write the record atomically: temp file in the same directory, file sync,
+/// rename, then directory sync on Unix. A crash never leaves a partial record.
+pub fn write_storage_meta(
+    data_directory: &Path,
+    meta: &StorageCompatibilityMeta,
+) -> Result<PathBuf, StorageError> {
+    std::fs::create_dir_all(data_directory).map_err(|error| meta_error("create directory", error))?;
+    let mut path = storage_meta_path(data_directory);
+    // Preserve an unrecognized/corrupt existing record byte-for-byte. It may
+    // contain a newer producer's facts this binary cannot decode. Diagnostics
+    // for this attempt go to a separate atomically replaced file.
+    if path.exists() && read_storage_meta(data_directory).is_none() {
+        path=data_directory.join("storage-open-attempt.json");
+    }
+    let nonce = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_nanos())
+        .unwrap_or_default();
+    let temporary = data_directory.join(format!(
+        ".{STORAGE_COMPATIBILITY_META_FILE}.{}.{nonce}.tmp",
+        std::process::id()
+    ));
+    let bytes = serde_json::to_vec_pretty(meta)
+        .map_err(|error| meta_error("serialize compatibility record", error))?;
+    let result = (|| {
+        let mut options = std::fs::OpenOptions::new();
+        options.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.mode(0o600);
+        }
+        let mut file = options
+            .open(&temporary)
+            .map_err(|error| meta_error("create temporary compatibility record", error))?;
+        file.write_all(&bytes)
+            .map_err(|error| meta_error("write compatibility record", error))?;
+        file.sync_all()
+            .map_err(|error| meta_error("sync compatibility record", error))?;
+        drop(file);
+        std::fs::rename(&temporary, &path)
+            .map_err(|error| meta_error("publish compatibility record", error))?;
+        #[cfg(unix)]
+        std::fs::File::open(data_directory)
+            .and_then(|directory| directory.sync_all())
+            .map_err(|error| meta_error("sync compatibility directory", error))?;
+        Ok(path.clone())
+    })();
+    if result.is_err() {
+        let _ = std::fs::remove_file(&temporary);
+    }
+    result
+}
+
+/// Read `PRAGMA user_version` without running migrations. A missing database is
+/// `None`; callers may treat other probe failures as "let the real open decide".
+pub fn probe_schema_version(database: &Path) -> Result<Option<u32>, StorageError> {
+    if !database.exists() {
+        return Ok(None);
+    }
+    let connection = Connection::open_with_flags(database, OpenFlags::SQLITE_OPEN_READ_ONLY)
+        .map_err(rusqlite_error)?;
+    connection
+        .busy_timeout(Duration::from_millis(250))
+        .map_err(rusqlite_error)?;
+    let version = connection
+        .query_row("PRAGMA user_version", [], |row| row.get::<_, u32>(0))
+        .map_err(rusqlite_error)?;
+    connection
+        .close()
+        .map_err(|(_, error)| rusqlite_error(error))?;
+    Ok(Some(version))
+}
+
+pub fn unix_seconds() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|duration| duration.as_secs() as i64)
+        .unwrap_or(0)
+}
+
+fn meta_error(action: &str, error: impl std::fmt::Display) -> StorageError {
+    StorageError::InvalidSnapshot {
+        field: format!("{action}: {error}"),
+    }
+}
