+/// Missing additive facts may come from an older caller's shape. An explicit
+/// conflicting value is not an omission and cannot be acknowledged as a save.
+fn missing_original_extensions(
+    original: &std::collections::BTreeMap<String, serde_json::Value>,
+    proposed: &std::collections::BTreeMap<String, serde_json::Value>,
+) -> Result<bool, StorageError> {
+    let mut missing = false;
+    for (key, value) in original {
+        match proposed.get(key) {
+            Some(next) if next != value => return Err(invalid("unknownOriginalSyncFacts")),
+            None => missing = true,
+            _ => {}
+        }
+    }
+    Ok(missing)
+}
+
+/// All durable state replacements retain unknown facts at their original
+/// owner. Never move an old operation's facts into a new operation, even when
+/// the old operation is terminal. The usual, complete shape stays borrowed:
+/// journals may contain tens of megabytes of ciphertext.
+fn state_update_preserving_unknown_facts<'a>(
+    original: &LibrarySyncStateV1,
+    proposed: &'a LibrarySyncStateV1,
+) -> Result<std::borrow::Cow<'a, LibrarySyncStateV1>, StorageError> {
+    let mut missing = missing_original_extensions(&original.extensions, &proposed.extensions)?;
+    if let Some(old) = &original.active {
+        let old_log_unknown = old.log.as_ref().is_some_and(|log| !log.extensions.is_empty());
+        match proposed.active.as_ref().filter(|next| next.operation_id == old.operation_id) {
+            Some(next) => {
+                missing |= missing_original_extensions(&old.extensions, &next.extensions)?;
+                if old_log_unknown {
+                    let old_log = old.log.as_ref().unwrap();
+                    let next_log = next.log.as_ref().filter(|log| log.channel_id == old_log.channel_id)
+                        .ok_or_else(|| invalid("unknownOriginalSyncFacts"))?;
+                    missing |= missing_original_extensions(&old_log.extensions, &next_log.extensions)?;
+                }
+            }
+            None if !old.extensions.is_empty() || old_log_unknown => {
+                return Err(invalid("unknownOriginalSyncFacts"));
+            }
+            None => {}
+        }
+    }
+    if !missing { return Ok(std::borrow::Cow::Borrowed(proposed)); }
+    let mut preserved = proposed.clone();
+    preserved.extensions.extend(original.extensions.clone());
+    if let (Some(old), Some(next)) = (&original.active, &mut preserved.active) {
+        if old.operation_id == next.operation_id {
+            next.extensions.extend(old.extensions.clone());
+            if let (Some(old_log), Some(next_log)) = (&old.log, &mut next.log) {
+                next_log.extensions.extend(old_log.extensions.clone());
+            }
+        }
+    }
+    Ok(std::borrow::Cow::Owned(preserved))
+}
