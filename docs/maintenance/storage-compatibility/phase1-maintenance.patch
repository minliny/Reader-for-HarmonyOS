+    /// Single-statement legacy writers still require a transaction-bound
+    /// layout check: a process mutex alone cannot fence another SQLite writer.
+    fn with_layout_write<T>(&self, write: impl FnOnce(&Connection) -> Result<T,StorageError>) -> Result<T,StorageError> {
+        let mut conn=self.lock()?;
+        let tx=conn.transaction_with_behavior(TransactionBehavior::Immediate).map_err(rusqlite_error)?;
+        self.assert_layout_current(&tx)?;
+        let value=write(&tx)?;
+        tx.commit().map_err(rusqlite_error)?;
+        Ok(value)
+    }
