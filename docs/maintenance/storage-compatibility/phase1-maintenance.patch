+    for (name,event) in [("insert","INSERT"),("update","UPDATE OF payload")] {
+        let name=format!("directory_local_readability_rules_{name}");
+        additions.push((name.clone(),format!("CREATE TRIGGER {name} AFTER {event} ON cache WHEN substr(NEW.key,1,27)='reading.directory.rules.v2:' BEGIN DELETE FROM cache WHERE key='reading.directory.facts.v2:5:local:'||substr(NEW.key,27+instr(substr(NEW.key,28),':')+1) AND CASE WHEN json_valid(payload) THEN json_extract(payload,'$.adapterVersion') END='local-txt-readable-v1'; END")));
+    }
+    for (name,sql) in additions {expected.insert(format!("trigger:{name}"),SchemaObject {kind:"trigger".into(),table:"cache".into(),sql:normalized_sql(&sql)});}
+    Ok(expected)
+}
