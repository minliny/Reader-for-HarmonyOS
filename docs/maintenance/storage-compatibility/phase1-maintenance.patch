+//! Preserve original facts before the unchanged historical v8/v9 DDL runs.
+//! An absent historical source identity remains unresolved; current shelf
+//! membership is not sufficient evidence to invent the original edit owner.
+use super::*;
+use rusqlite::types::ValueRef;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+const TABLE: &str = "reader_legacy_fact_archive_v1";
+pub(super) fn is_optional_archive(table: &str) -> bool { table == TABLE }
+const DDL: &str = "CREATE TABLE IF NOT EXISTS reader_legacy_fact_archive_v1(migration INTEGER NOT NULL,kind TEXT NOT NULL,original_key TEXT NOT NULL,payload_sha256 TEXT NOT NULL,raw_payload TEXT NOT NULL,recovery_state TEXT NOT NULL CHECK(recovery_state='awaitingOriginalAttribution'),PRIMARY KEY(migration,kind,original_key,payload_sha256));";
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct LegacyMigrationFact {
+    pub migration: u32, pub kind: String, pub original_key: String,
+    pub payload_sha256: String, pub raw_payload: String, pub recovery_state: String,
+}
+
+#[derive(Serialize)]
+#[serde(tag="sqlType", content="value", rename_all="camelCase")]
+enum OriginalValue { Null, Integer(i64), RealBits(u64), Text(Vec<u8>), Blob(Vec<u8>) }
+
+fn archive_rows(conn: &Connection, migration: u32, kind: &str, query: &str, key_column: &str) -> Result<(), StorageError> {
+    let mut stmt = conn.prepare(query).map_err(rusqlite_error)?;
+    let names=stmt.column_names().iter().map(|v|v.to_string()).collect::<Vec<_>>();
+    let key_index=names.iter().position(|v|v==key_column).ok_or_else(|| StorageError::InvalidSnapshot { field:"legacyFact.key".into() })?;
+    let mut rows=stmt.query([]).map_err(rusqlite_error)?;
+    let mut installed=false;
+    while let Some(row)=rows.next().map_err(rusqlite_error)? {
+        let mut raw=Vec::with_capacity(names.len());
+        for (index,name) in names.iter().enumerate() {
+            let value=match row.get_ref(index).map_err(rusqlite_error)? {
+                ValueRef::Null=>OriginalValue::Null, ValueRef::Integer(v)=>OriginalValue::Integer(v),
+                ValueRef::Real(v)=>OriginalValue::RealBits(v.to_bits()),
+                ValueRef::Text(v)=>OriginalValue::Text(v.to_vec()), ValueRef::Blob(v)=>OriginalValue::Blob(v.to_vec()),
+            };
+            raw.push((name,value));
+        }
+        let payload=serde_json::to_string(&raw).map_err(|_|StorageError::InvalidSnapshot { field:"legacyFact.encoding".into() })?;
+        let key=serde_json::to_string(&raw[key_index]).map_err(|_|StorageError::InvalidSnapshot { field:"legacyFact.keyEncoding".into() })?;
+        let hash=format!("{:x}",Sha256::digest(payload.as_bytes()));
+        if !installed { conn.execute_batch(DDL).map_err(rusqlite_error)?; installed=true; }
+        conn.execute("INSERT OR IGNORE INTO reader_legacy_fact_archive_v1(migration,kind,original_key,payload_sha256,raw_payload,recovery_state) VALUES(?1,?2,?3,?4,?5,'awaitingOriginalAttribution')",params![migration,kind,key,hash,payload]).map_err(rusqlite_error)?;
+    }
+    Ok(())
+}
+
+pub(super) fn before_v8(conn: &Connection) -> Result<(), StorageError> {
+    let tx=conn.unchecked_transaction().map_err(rusqlite_error)?;
+    archive_rows(&tx,8,"contentEdit","SELECT * FROM content_edits ORDER BY edit_id","edit_id")?;
+    tx.execute_batch(SCHEMA_V8_DDL).map_err(rusqlite_error)?;
+    tx.pragma_update(None,"user_version",8).map_err(rusqlite_error)?;
+    tx.commit().map_err(rusqlite_error)
+}
+pub(super) fn before_v9(conn: &Connection) -> Result<(), StorageError> {
+    let tx=conn.unchecked_transaction().map_err(rusqlite_error)?;
+    archive_rows(&tx,9,"bookMetadata","SELECT * FROM books WHERE book_id NOT IN (SELECT book_id FROM bookshelf WHERE source_id='local' UNION SELECT book_id FROM chapter_cache WHERE source_id='local') ORDER BY book_id","book_id")?;
+    tx.execute_batch(SCHEMA_V9_DDL).map_err(rusqlite_error)?;
+    tx.pragma_update(None,"user_version",9).map_err(rusqlite_error)?;
+    tx.commit().map_err(rusqlite_error)
+}
+
+pub(super) fn validate_legacy_input(conn: &Connection, version: u32) -> Result<(), StorageError> {
+    let reference=Connection::open_in_memory().map_err(rusqlite_error)?;
+    SqliteStorage::create_reference_schema_at(&reference,version)?;
+    super::storage_layout::compare_reference_schema(conn,&reference)
+}
+
+pub(super) fn validate_optional_archive(conn: &Connection) -> Result<(),StorageError> {
+    let exists:bool=conn.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE name=?1)",[TABLE],|r|r.get(0)).map_err(rusqlite_error)?;
+    if !exists {return Ok(());}
+    let unreviewed:bool=conn.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE tbl_name=?1 AND type!='table' AND sql IS NOT NULL)",[TABLE],|r|r.get(0)).map_err(rusqlite_error)?;
+    if unreviewed {return Err(StorageError::InvalidSnapshot {field:"legacyFact.unreviewedDependency".into()});}
+    let reference=Connection::open_in_memory().map_err(rusqlite_error)?;
+    reference.execute_batch(DDL).map_err(rusqlite_error)?;
+    super::storage_layout::compare_reference_schema(conn,&reference)
+}
+
+impl SqliteStorage {
+    /// Original facts remain queryable without assigning a guessed source or
+    /// importing them into another book. They survive ordinary snapshot restore.
+    pub fn legacy_migration_facts(&self) -> Result<Vec<LegacyMigrationFact>, StorageError> {
+        let conn=self.lock()?;
+        let exists:bool=conn.query_row("SELECT EXISTS(SELECT 1 FROM sqlite_schema WHERE type='table' AND name=?1)",[TABLE],|r|r.get(0)).map_err(rusqlite_error)?;
+        if !exists {return Ok(vec![]);}
+        let mut stmt=conn.prepare("SELECT migration,kind,original_key,payload_sha256,raw_payload,recovery_state FROM reader_legacy_fact_archive_v1 ORDER BY migration,kind,original_key,payload_sha256").map_err(rusqlite_error)?;
+        let rows=stmt.query_map([],|r|Ok(LegacyMigrationFact {migration:r.get(0)?,kind:r.get(1)?,original_key:r.get(2)?,payload_sha256:r.get(3)?,raw_payload:r.get(4)?,recovery_state:r.get(5)?})).map_err(rusqlite_error)?;
+        rows.map(|r|r.map_err(rusqlite_error)).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn legacy() -> (std::path::PathBuf,std::path::PathBuf) {
+        let dir=std::env::temp_dir().join(format!("reader-legacy-preserve-{}",crate::library_identity::new_id().unwrap()));std::fs::create_dir(&dir).unwrap();
+        let path=dir.join("reader-core.sqlite3");let conn=Connection::open(&path).unwrap();
+        SqliteStorage::create_reference_schema_at(&conn,7).unwrap();drop(conn);(dir,path)
+    }
+    #[test]
+    fn legacy_edits_are_retained_before_source_migration() {
+        let (dir,path)=legacy();let conn=Connection::open(&path).unwrap();
+        conn.execute("INSERT INTO content_edits(edit_id,book_id,chapter_index,edited_content,edited_at) VALUES(7,'ambiguous-book',3,'原始编辑🦀',123)",[]).unwrap();drop(conn);
+        assert!(SqliteStorage::open(&path).is_err());
+        let store=SqliteStorage::open_with_explicit_upgrade(&path,7).unwrap();let facts=store.legacy_migration_facts().unwrap();
+        assert_eq!(facts.len(),1);assert_eq!(facts[0].kind,"contentEdit");assert_eq!(facts[0].recovery_state,"awaitingOriginalAttribution");
+        let raw:serde_json::Value=serde_json::from_str(&facts[0].raw_payload).unwrap();
+        assert!(raw.as_array().unwrap().iter().any(|row| row[0]=="edited_content" && row[1]["value"]==serde_json::json!("原始编辑🦀".as_bytes())));
+        assert_eq!(store.lock().unwrap().query_row("SELECT count(*) FROM content_edits",[],|r|r.get::<_,u32>(0)).unwrap(),0);
+        drop(store);assert_eq!(SqliteStorage::open(&path).unwrap().legacy_migration_facts().unwrap(),facts);std::fs::remove_dir_all(dir).unwrap();
+    }
+    #[test]
+    fn ambiguous_books_remain_recoverable() {
+        let (dir,path)=legacy();let conn=Connection::open(&path).unwrap();
+        let original="{\"bookId\":\"ambiguous\",\"name\":\"原书名\",\"unrecognized\":{\"raw\":17}}";
+        conn.execute("INSERT INTO books(book_id,book_json) VALUES('ambiguous',?1)",[original]).unwrap();drop(conn);
+        let store=SqliteStorage::open_with_explicit_upgrade(&path,7).unwrap();let facts=store.legacy_migration_facts().unwrap();
+        assert_eq!(facts.len(),1);assert_eq!(facts[0].kind,"bookMetadata");
+        let raw:serde_json::Value=serde_json::from_str(&facts[0].raw_payload).unwrap();assert!(raw.as_array().unwrap().iter().any(|row|row[0]=="book_json" && row[1]["value"]==serde_json::json!(original.as_bytes())));
+        drop(store);std::fs::remove_dir_all(dir).unwrap();
+    }
+}
