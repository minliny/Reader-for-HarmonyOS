+// Normalize only unquoted SQL spelling/spacing/comments. Quoted payloads and
+// identifiers remain byte-exact; no SQL from the inspected database is executed.
+fn normalized_sql(sql: &str) -> String {
+    let mut chars = sql.chars().peekable();
+    let mut out = String::new();
+    let mut quoted: Option<char> = None;
+    while let Some(c) = chars.next() {
+        if let Some(q) = quoted {
+            out.push(c);
+            if c == q {
+                if chars.peek() == Some(&q) { out.push(chars.next().unwrap()); }
+                else { quoted = None; }
+            }
+        } else if matches!(c, '\'' | '"' | '`') { quoted = Some(c); out.push(c); }
+        else if c == '-' && chars.peek() == Some(&'-') {
+            chars.next(); for next in chars.by_ref() { if next == '\n' { break; } }
+        } else if c == '/' && chars.peek() == Some(&'*') {
+            chars.next(); while let Some(next) = chars.next() { if next == '*' && chars.peek() == Some(&'/') { chars.next(); break; } }
+        } else if !c.is_whitespace() { out.extend(c.to_lowercase()); }
+    }
+    out
+}
+fn schema_objects(conn: &Connection) -> Result<Schema, StorageError> {
+    let mut stmt = conn.prepare("SELECT type,name,tbl_name,sql FROM sqlite_schema WHERE name NOT LIKE 'sqlite_%' AND sql IS NOT NULL ORDER BY type,name").map_err(rusqlite_error)?;
+    let rows = stmt.query_map([], |r| {
+        let kind:String=r.get(0)?;
+        let name:String=r.get(1)?;
+        Ok((format!("{kind}:{name}"), SchemaObject {
+            kind, table:r.get(2)?, sql:normalized_sql(&r.get::<_,String>(3)?),
+        }))
+    }).map_err(rusqlite_error)?;
+    rows.map(|r| r.map_err(rusqlite_error)).collect()
+}
+pub(super) fn compare_reference_schema(actual: &Connection, reference: &Connection) -> Result<(),StorageError> {
