+/// Inspect within the caller's read transaction. Exact known definitions protect
+/// constraints, indexes and persisted trigger/UDF dependencies, not just names.
+pub(super) fn inspect_connection(conn: &Connection) -> Result<StorageLayoutContext, StorageError> {
+    let version: u32 = conn.pragma_query_value(None, "user_version", |r| r.get(0)).map_err(rusqlite_error)?;
+    let spec = contract().layouts.iter().find(|s| s.schema_version == version && s.read && s.write)
+        .ok_or_else(|| if version > maximum_supported_schema() { StorageError::SchemaTooNew { actual:version, supported:maximum_supported_schema() } } else { invalid("explicitMigrationRequired") })?;
+    let cookie: u32 = conn.pragma_query_value(None, "schema_version", |r| r.get(0)).map_err(rusqlite_error)?;
+    let actual = schema_objects(conn)?;
+    let reference = expected_schema(version)?;
+    legacy_migration_preservation::validate_optional_archive(conn)?;
+    validate_extension_dependencies(conn, &actual, &reference)?;
+    let legacy_mismatches=schema_mismatches(&actual,&reference);
+    let directory_policy_id=if legacy_mismatches.is_empty() {"reader-directory-broad-v1"} else {
+        let visible=directory_visible_content_v2(&reference)?;
+        let visible_mismatches=schema_mismatches(&actual,&visible);
+        if !visible_mismatches.is_empty() {
+            // Report every schema difference for both known policies in one
+            // bounded metadata diagnostic, without user rows or SQL payloads.
+            return Err(invalid(&format!("definitionMismatch.broadV1=[{}].visibleV2=[{}]",legacy_mismatches.join(","),visible_mismatches.join(","))));
+        }
+        "reader-directory-visible-content-v2"
+    }.to_string();
+    if !contract().accepted_directory_policies.contains(&directory_policy_id) {return Err(invalid("directoryPolicyNotInContract"));}
+    let mut digest = Sha256::new();
+    for (name, object) in &actual {
+        for part in [&object.kind, name, &object.table, &object.sql] { digest.update((part.len() as u64).to_le_bytes()); digest.update(part.as_bytes()); }
+    }
+    let fingerprint=format!("{:x}",digest.finalize());
+    let context = StorageLayoutContext {
+        schema_version:version, layout_id:spec.layout_id.clone(), schema_cookie:cookie,
+        schema_fingerprint:fingerprint.clone(), admitted_schema_fingerprint:fingerprint,
+        directory_policy_id:directory_policy_id.clone(), admitted_directory_policy_id:directory_policy_id,
+        sync_epoch_owner: match spec.sync_epoch_owner.as_str() { "none"=>SyncEpochOwner::None,"state"=>SyncEpochOwner::StateRow,"clock"=>SyncEpochOwner::Clock,_=>return Err(invalid("contractEpochOwner")) },
+        sync_protocol_versions:spec.sync_protocol_versions.clone(), sync_log_receipts:spec.sync_log_receipts,
+        admitted_cookie:cookie, database_identity:None, admitted_database_identity:None,
+    };
+    if context.has_sync() { library_sync_storage::validate_layout_state(conn, &context)?; }
+    let header=library_identity::header(conn)?.ok_or_else(||invalid("libraryIdentityMissing"))?;
+    if [&header.0,&header.1].iter().any(|v|v.len()!=32 || !v.bytes().all(|b|b.is_ascii_hexdigit())) {return Err(invalid("libraryIdentityShape"));}
+    context.assert_current(conn)?;
+    Ok(context)
+}
