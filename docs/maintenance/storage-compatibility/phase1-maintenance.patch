+/// An unknown domain is independent only when deleting an owned row cannot
+/// cascade into it. Use SQLite's resolved FK metadata, including quoted names,
+/// rather than inferring dependencies from SQL text. Any chain into an owned
+/// table necessarily has a direct edge detected while visiting all extensions.
+fn validate_extension_dependencies(conn: &Connection, actual: &Schema, expected: &Schema) -> Result<(), StorageError> {
+    for (name, object) in actual {
+        if object.kind != "table" || expected.contains_key(name) {
+            continue;
+        }
+        let mut statement = conn.prepare(&format!("PRAGMA foreign_key_list({})", quote_sql_identifier(&object.table))).map_err(rusqlite_error)?;
+        let targets = statement.query_map([], |row| row.get::<_, String>(2)).map_err(rusqlite_error)?;
+        for target in targets {
+            let target = target.map_err(rusqlite_error)?;
+            if expected.values().any(|owned| owned.kind == "table" && owned.table.eq_ignore_ascii_case(&target)) {
+                return Err(invalid(&format!("unreviewedForeignKey.{name}->{target}")));
+            }
+        }
+    }
+    Ok(())
+}
