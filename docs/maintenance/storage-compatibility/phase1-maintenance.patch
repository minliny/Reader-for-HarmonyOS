+fn schema_mismatches(actual:&Schema, expected:&Schema) -> Vec<String> {
+    let mut mismatches=Vec::new();
+    for (name,object) in expected {if actual.get(name)!=Some(object) {mismatches.push(format!("definition:{name}"));}}
+    for (name,object) in actual {
+        if name.split_once(':').is_some_and(|(_,name)|name.starts_with("library_sync_")) && !expected.contains_key(name) {
+            mismatches.push(format!("unexpectedSync:{name}"));
+        } else if !expected.contains_key(name)
+            && (object.kind == "trigger" || (expected.contains_key(&format!("table:{}",object.table))
+                && matches!(object.kind.as_str(),"index"|"view"))) {
+            mismatches.push(format!("unreviewedDependency:{name}"));
+        }
+    }
+    mismatches
+}
