+/// No Runtime, writer, migration, recovery, sidecar or pragma setter is used.
+/// The read transaction includes WAL commits and holds one schema/state snapshot.
+pub fn probe_storage_layout(path: &std::path::Path) -> Result<StorageLayoutContext, StorageError> {
+    let identity_before=database_identity(path)?;
+    let mut conn = Connection::open_with_flags(path, rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY).map_err(rusqlite_error)?;
+    conn.busy_timeout(std::time::Duration::from_millis(250)).map_err(rusqlite_error)?;
+    let tx = conn.transaction_with_behavior(rusqlite::TransactionBehavior::Deferred).map_err(rusqlite_error)?;
+    let mut context = inspect_connection(&tx)?;
+    tx.commit().map_err(rusqlite_error)?;
+    context.bind_database(path)?;
+    if context.database_identity.as_deref()!=Some(identity_before.as_str()) {return Err(invalid("databaseIdentityChanged"));}
+    Ok(context)
+}
