+fn directory_broad_reference(reference: &Schema) -> Result<Schema,StorageError> {
+    let mut broad=reference.clone();
+    let predicate=" WHEN NEW.source_id IS NOT OLD.source_id OR NEW.book_id IS NOT OLD.book_id OR NEW.chapter_index IS NOT OLD.chapter_index OR NEW.title IS NOT OLD.title OR NEW.url IS NOT OLD.url OR NEW.content IS NOT OLD.content OR NEW.content_format_version IS NOT OLD.content_format_version ";
+    let visible=format!("afterupdateonchapter_cache{}begin",normalized_sql(predicate));
+    for name in ["directory_guard_chapter_cache_update","directory_guard_chapter_cache_update_old"] {
+        let object=broad.get_mut(&format!("trigger:{name}")).ok_or_else(||invalid("directoryReferenceMissing"))?;
+        if !object.sql.contains(&visible) {return Err(invalid("maintenanceDirectoryReferenceChanged"));}
+        object.sql=object.sql.replace(&visible,"afterupdateonchapter_cachebegin");
+    }
+    for name in ["directory_local_readability_guard","directory_local_readability_rules_insert","directory_local_readability_rules_update"] {broad.remove(&format!("trigger:{name}"));}
+    if directory_visible_content_v2(&broad)? != *reference {return Err(invalid("maintenanceDirectoryReferenceChanged"));}
+    Ok(broad)
