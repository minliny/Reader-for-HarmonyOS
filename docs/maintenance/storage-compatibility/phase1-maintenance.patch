+impl StorageLayoutContext {
+    pub fn has_sync(&self) -> bool { self.sync_epoch_owner != SyncEpochOwner::None }
+    pub fn has_sync_log_receipts(&self) -> bool { self.sync_log_receipts }
+
+    pub(super) fn bind_database(&mut self, path: &std::path::Path) -> Result<(),StorageError> {
+        let identity=database_identity(path)?;
+        self.database_identity=Some(identity.clone()); self.admitted_database_identity=Some(identity); Ok(())
+    }
+    pub(super) fn assert_database(&self, path: &std::path::Path) -> Result<(),StorageError> {
+        if self.admitted_database_identity.as_deref()!=Some(database_identity(path)?.as_str())
+            || self.database_identity!=self.admitted_database_identity {return Err(invalid("databaseIdentityChanged"));}
+        Ok(())
+    }
+
+    /// Call after beginning the transaction: the schema read pins the same SQLite
+    /// snapshot as the operation. No repeated full-schema hashing is necessary.
+    pub fn assert_current(&self, conn: &Connection) -> Result<(), StorageError> {
+        let spec=contract().layouts.iter().find(|v|v.schema_version==self.schema_version).ok_or_else(||invalid("unvalidatedContext"))?;
+        let owner=match spec.sync_epoch_owner.as_str() {"none"=>SyncEpochOwner::None,"state"=>SyncEpochOwner::StateRow,"clock"=>SyncEpochOwner::Clock,_=>return Err(invalid("contractEpochOwner"))};
+        if self.admitted_cookie!=self.schema_cookie || self.schema_fingerprint!=self.admitted_schema_fingerprint
+            || self.directory_policy_id!=self.admitted_directory_policy_id || !contract().accepted_directory_policies.contains(&self.directory_policy_id)
+            || self.layout_id!=spec.layout_id || self.sync_epoch_owner!=owner
+            || self.sync_protocol_versions!=spec.sync_protocol_versions || self.sync_log_receipts!=spec.sync_log_receipts {return Err(invalid("unvalidatedContext"));}
+        let version: u32 = conn.pragma_query_value(None, "user_version", |r| r.get(0)).map_err(rusqlite_error)?;
+        let cookie: u32 = conn.pragma_query_value(None, "schema_version", |r| r.get(0)).map_err(rusqlite_error)?;
+        if version != self.schema_version || cookie != self.schema_cookie {
+            return Err(invalid("changedAfterAdmission"));
+        }
+        Ok(())
+    }
+}
+
+fn database_identity(path: &std::path::Path) -> Result<String,StorageError> {
+    let canonical=std::fs::canonicalize(path).map_err(|_|invalid("databaseIdentityUnavailable"))?;
+    let metadata=std::fs::metadata(&canonical).map_err(|_|invalid("databaseIdentityUnavailable"))?;
+    let mut hash=Sha256::new(); hash.update(canonical.to_string_lossy().as_bytes());
+    #[cfg(unix)] {use std::os::unix::fs::MetadataExt; hash.update(metadata.dev().to_le_bytes());hash.update(metadata.ino().to_le_bytes());}
+    #[cfg(not(unix))] {hash.update(format!("{:?}",metadata.created().map_err(|_|invalid("databaseIdentityUnavailable"))?).as_bytes());}
+    Ok(format!("{:x}",hash.finalize()))
+}
