{"content":[{"type":"text","text":"const imgIcon = \"https://www.figma.com/api/mcp/asset/6192da66-3298-412b-8e32-69f1f99ce5e0.svg\";\nconst imgIcon1 = \"https://www.figma.com/api/mcp/asset/5be71d01-089f-4a9b-8676-d4670a5444ca.svg\";\nconst imgIcon2 = \"https://www.figma.com/api/mcp/asset/c5ad4719-e2b7-4ccb-830b-07dd62ffea75.svg\";\nconst imgIcon3 = \"https://www.figma.com/api/mcp/asset/68c8c42e-f9a2-479a-b13a-247623c456ed.svg\";\nconst imgIcon4 = \"https://www.figma.com/api/mcp/asset/7d1fba3c-511d-4dc5-9fde-5e796858e4f8.svg\";\nconst imgIcon5 = \"https://www.figma.com/api/mcp/asset/a25a2cdf-525d-4938-894a-0f395a2d4393.svg\";\nconst imgIcon6 = \"https://www.figma.com/api/mcp/asset/1785be79-2f9f-430f-aa85-8bd168c0a383.svg\";\nconst imgIcon7 = \"https://www.figma.com/api/mcp/asset/064af913-53f1-4c2e-9962-cc38e9202084.svg\";\n\ntype PageReaderModuleSettingsProps = {\n  className?: string;\n  viewport?: \"Phone\";\n};\n\nfunction PageReaderModuleSettings({ className, viewport = \"Phone\" }: PageReaderModuleSettingsProps) {\n  return (\n    <div className={className || \"h-[844px] overflow-clip relative w-[390px]\"} data-node-id=\"942:70\">\n      <div className=\"absolute bg-gradient-to-b border border-[#c1c7cd] border-solid from-[#fff9f2] h-[844px] left-0 overflow-clip rounded-[34px] to-[#f6ebdf] top-0 via-[#fbf1e7] via-[72%] w-[390px]\" data-node-id=\"924:3\" data-name=\"Main Content - 阅读设置（Reading Settings）\">\n        <div className=\"absolute bg-gradient-to-b from-[#fbf4e9] h-[842px] left-0 overflow-clip to-[#efe2d0] top-0 w-[388px]\" data-node-id=\"924:4\" data-name=\"Article - 阅读正文\">\n          <div className=\"absolute content-stretch flex flex-col h-[722px] items-start left-[32px] overflow-clip top-[72px] w-[324px]\" data-node-id=\"924:7\" data-name=\"Article - 正文排版层\">\n            <div className=\"relative shrink-0 w-full\" data-node-id=\"924:8\" data-name=\"Heading 1\">\n              <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-center relative size-full\">\n                <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Bold'] font-bold leading-[28.75px] relative shrink-0 text-[#2b241d] text-[23px] text-center whitespace-nowrap\" data-node-id=\"924:9\">\n                  雨夜\n                </p>\n              </div>\n            </div>\n            <div className=\"relative shrink-0 w-full\" data-node-id=\"924:29\" data-name=\"Paragraph:margin\">\n              <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start pt-[24px] relative size-full\">\n                <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Regular'] font-normal indent-[36px] leading-[0] relative shrink-0 text-[#2b241d] text-[18px] w-[324px]\" data-node-id=\"924:12\">\n                  <span className=\"leading-[35.28px]\">雨声在窗外连成一片，像</span>\n                  <span className=\"[text-decoration-skip-ink:none] [text-underline-position:from-font] decoration-from-font decoration-solid leading-[35.28px] underline\">无数细小的针</span>\n                  <span className=\"leading-[35.28px]\">，密密地刺在玻璃上，汇成一层朦胧的水幕，将城市的灯光晕成模糊的光团。</span>\n                </p>\n              </div>\n            </div>\n            <div className=\"relative shrink-0 w-full\" data-node-id=\"924:30\" data-name=\"Paragraph:margin\">\n              <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start pt-[16px] relative size-full\">\n                <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Regular'] font-normal indent-[36px] leading-[0] relative shrink-0 text-[#2b241d] text-[18px] w-[324px]\" data-node-id=\"924:15\">\n                  <span className=\"leading-[35.28px]\">他站在窗前，手里握着那封被雨水润湿的信。纸页边角微微卷起，字迹却依旧清晰，像某个</span>\n                  <span className=\"[text-decoration-skip-ink:none] [text-underline-position:from-font] decoration-from-font decoration-solid leading-[35.28px] underline\">迟到许久的答案</span>\n                  <span className=\"leading-[35.28px]\">终于抵达。</span>\n                </p>\n              </div>\n            </div>\n            <div className=\"relative shrink-0 w-full\" data-node-id=\"924:31\" data-name=\"Paragraph:margin\">\n              <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start pt-[16px] relative size-full\">\n                <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Regular'] font-normal indent-[36px] leading-[0] relative shrink-0 text-[#2b241d] text-[18px] w-[324px]\" data-node-id=\"924:18\">\n                  <span className=\"leading-[35.28px]\">这座城市在夜里显得格外安静，街道尽头偶尔有车灯掠过，又很快被雨幕吞没，只留下</span>\n                  <span className=\"[text-decoration-skip-ink:none] [text-underline-position:from-font] decoration-from-font decoration-solid leading-[35.28px] underline\">短暂而摇晃的光</span>\n                  <span className=\"leading-[35.28px]\">。</span>\n                </p>\n              </div>\n            </div>\n            <div className=\"relative shrink-0 w-full\" data-node-id=\"924:32\" data-name=\"Paragraph:margin\">\n              <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start pt-[16px] relative size-full\">\n                <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Regular'] font-normal indent-[36px] leading-[35.28px] relative shrink-0 text-[#2b241d] text-[18px] w-[324px]\" data-node-id=\"924:21\">\n                  他曾经以为自己已经习惯等待，习惯在没有回音的日子里把所有疑问折起来，塞进抽屉最深处。\n                </p>\n              </div>\n            </div>\n            <div className=\"relative shrink-0 w-full\" data-node-id=\"924:33\" data-name=\"Paragraph:margin\">\n              <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start pt-[16px] relative size-full\">\n                <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Regular'] font-normal indent-[36px] leading-[35.28px] relative shrink-0 text-[#2b241d] text-[18px] w-[324px]\" data-node-id=\"924:24\">\n                  可真正看到信上那行字时，他才发现那些被压下去的情绪并没有消失，只是一直在暗处积蓄，等着这一刻重新涌上来。\n                </p>\n              </div>\n            </div>\n            <div className=\"h-[68px] relative shrink-0 w-[324px]\" data-node-id=\"924:26\" data-name=\"Paragraph\">\n              <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start py-[16px] relative size-full\">\n                <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Regular'] font-normal indent-[36px] leading-[35.28px] relative shrink-0 text-[#2b241d] text-[18px] whitespace-nowrap\" data-node-id=\"924:27\">\n                  远处的灯光像被雾气揉碎，\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"absolute bg-[rgba(255,250,244,0.98)] border border-[rgba(180,166,151,0.34)] border-solid gap-x-[8px] gap-y-[8px] grid-cols-[____44px_170px_62px_34px] grid-rows-[_52px] inline-grid left-[14px] min-h-[54px] px-[13px] py-px rounded-[24px] top-[18px]\" data-node-id=\"924:37\" data-name=\"Section\">\n          <div className=\"col-1 justify-self-stretch min-h-[42px] relative row-1 self-center shrink-0\" data-node-id=\"924:38\" data-name=\"Button - 返回\">\n            <div className=\"bg-clip-padding border-0 border-[transparent] border-solid grid grid-cols-[_44px] grid-rows-[_42px] min-h-[inherit] relative size-full\">\n              <div className=\"col-1 justify-self-center relative row-1 self-center shrink-0 size-[24px]\" data-node-id=\"924:39\" data-name=\"Icon\">\n                <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgIcon} />\n              </div>\n            </div>\n          </div>\n          <div className=\"col-2 h-[45px] justify-self-stretch relative row-1 self-center shrink-0\" data-node-id=\"924:44\" data-name=\"Text\">\n            <div className=\"bg-clip-padding border-0 border-[transparent] border-solid gap-x-[6px] gap-y-[6px] grid grid-cols-[_170px] grid-rows-[__22px_17px] overflow-clip relative rounded-[inherit] size-full\">\n              <div className=\"col-1 justify-self-stretch relative row-1 self-stretch shrink-0\" data-node-id=\"924:45\" data-name=\"Bold Text\">\n                <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start overflow-clip relative rounded-[inherit] size-full\">\n                  <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Bold'] font-bold leading-[normal] relative shrink-0 text-[#332c25] text-[16px] whitespace-nowrap\" data-node-id=\"924:46\">\n                    长夜余火\n                  </p>\n                </div>\n              </div>\n              <div className=\"col-1 justify-self-stretch relative row-2 self-stretch shrink-0\" data-node-id=\"924:48\" data-name=\"Small\">\n                <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start overflow-clip relative rounded-[inherit] size-full\">\n                  <p className=\"[word-break:break-word] font-['Noto_Serif_SC:Regular'] font-normal leading-[normal] relative shrink-0 text-[#5b5046] text-[12px] whitespace-nowrap\" data-node-id=\"924:49\">\n                    第 32 章 雨夜 · 优书网\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n          <div className=\"col-3 justify-self-stretch min-h-[42px] relative row-1 self-center shrink-0\" data-node-id=\"924:51\" data-name=\"Button\">\n            <div className=\"bg-clip-padding border-0 border-[transparent] border-solid grid grid-cols-[_62px] grid-rows-[__22.50px_19.50px] min-h-[inherit] relative size-full\">\n              <div className=\"col-1 justify-self-center relative row-1 self-center shrink-0 size-[20px]\" data-node-id=\"924:52\" data-name=\"Icon\">\n                <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgIcon1} />\n              </div>\n              <p className=\"[word-break:break-word] col-1 font-['Noto_Sans_SC:Bold'] font-bold justify-self-center leading-[normal] relative row-2 self-center shrink-0 text-[#332c25] text-[12px] text-center whitespace-nowrap\" data-node-id=\"924:58\">\n                换源\n              </p>\n            </div>\n          </div>\n          <div className=\"col-4 justify-self-stretch min-h-[42px] relative row-1 self-center shrink-0\" data-node-id=\"924:60\" data-name=\"Button - 更多\">\n            <div className=\"bg-clip-padding border-0 border-[transparent] border-solid grid grid-cols-[_34px] grid-rows-[_42px] min-h-[inherit] relative size-full\">\n              <div className=\"col-1 justify-self-center relative row-1 self-center shrink-0 size-[20px]\" data-node-id=\"924:61\" data-name=\"Icon\">\n                <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgIcon2} />\n              </div>\n            </div>\n          </div>\n        </div>\n        <div className=\"absolute bg-[rgba(255,250,244,0.98)] border border-[rgba(180,166,151,0.34)] border-solid h-[330px] left-[12px] overflow-clip rounded-[24px] top-[494px] w-[364px]\" data-node-id=\"924:66\" data-name=\"Container\">\n          <div className=\"absolute bg-[#b9ad9f] h-[4px] left-[134px] rounded-[999px] top-[9px] w-[42px]\" data-node-id=\"924:67\" data-name=\"Button - 展开完整控制页\" />\n          <div className=\"absolute border border-[rgba(180,166,151,0.34)] border-solid gap-x-[4px] gap-y-[4px] grid grid-cols-[_264px] grid-rows-[__160px_0px] h-[190px] left-[12px] overflow-clip px-[11px] py-[13px] rounded-[8px] top-[28px] w-[286px]\" data-node-id=\"924:69\" data-name=\"Section - 阅读设置\">\n            <div aria-hidden className=\"absolute bg-[rgba(255,252,248,0.62)] inset-0 pointer-events-none rounded-[8px]\" />\n            <div className=\"col-1 justify-self-stretch relative row-1 self-stretch shrink-0\" data-node-id=\"924:70\" data-name=\"Container\">\n              <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col gap-[7px] items-start pb-[8px] pt-[7px] px-[8px] relative size-full\">\n                <div className=\"h-[47px] relative shrink-0 w-full\" data-node-id=\"924:71\" data-name=\"Container\">\n                  <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col gap-[5px] items-start relative size-full\">\n                    <div className=\"h-[12px] relative shrink-0 w-full\" data-node-id=\"924:72\" data-name=\"Bold Text\">\n                      <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start relative size-full\">\n                        <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Medium'] font-medium leading-[12px] relative shrink-0 text-[#5b5046] text-[10px] whitespace-nowrap\" data-node-id=\"924:73\">\n                          屏幕方向\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"bg-[rgba(238,230,219,0.56)] h-[30px] relative rounded-[8px] shrink-0 w-full\" data-node-id=\"924:75\" data-name=\"屏幕方向\">\n                      <div className=\"bg-clip-padding border-0 border-[transparent] border-solid gap-x-[2px] gap-y-[2px] grid grid-cols-[______79.33px_79.33px_79.34px_0px_0px_0px] grid-rows-[_24px] p-[3px] relative size-full\">\n                        <div className=\"bg-[rgba(255,252,248,0.74)] col-1 justify-self-stretch min-h-[24px] relative rounded-[6px] row-1 self-stretch shrink-0\" data-node-id=\"924:76\" data-name=\"Button\">\n                          <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-center justify-center min-h-[inherit] overflow-clip px-[3px] relative rounded-[inherit] size-full\">\n                            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[normal] relative shrink-0 text-[#2f6373] text-[9px] text-center whitespace-nowrap\" data-node-id=\"924:77\">\n                              跟随系统\n                            </p>\n                          </div>\n                        </div>\n                        <div className=\"col-2 justify-self-stretch min-h-[24px] relative rounded-[6px] row-1 self-stretch shrink-0\" data-node-id=\"924:79\" data-name=\"Button\">\n                          <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-center justify-center min-h-[inherit] overflow-clip px-[3px] relative rounded-[inherit] size-full\">\n                            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Medium'] font-medium leading-[normal] relative shrink-0 text-[#5b5046] text-[9px] text-center whitespace-nowrap\" data-node-id=\"924:80\">\n                              竖屏\n                            </p>\n                          </div>\n                        </div>\n                        <div className=\"col-3 justify-self-stretch min-h-[24px] relative rounded-[6px] row-1 self-stretch shrink-0\" data-node-id=\"924:82\" data-name=\"Button\">\n                          <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-center justify-center min-h-[inherit] overflow-clip px-[3px] relative rounded-[inherit] size-full\">\n                            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Medium'] font-medium leading-[normal] relative shrink-0 text-[#5b5046] text-[9px] text-center whitespace-nowrap\" data-node-id=\"924:83\">\n                              横屏\n                            </p>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"h-[47px] relative shrink-0 w-full\" data-node-id=\"924:85\" data-name=\"Container\">\n                  <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col gap-[5px] items-start relative size-full\">\n                    <div className=\"h-[12px] relative shrink-0 w-full\" data-node-id=\"924:86\" data-name=\"Bold Text\">\n                      <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-start relative size-full\">\n                        <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Medium'] font-medium leading-[12px] relative shrink-0 text-[#5b5046] text-[10px] whitespace-nowrap\" data-node-id=\"924:87\">\n                          翻页样式\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"bg-[rgba(238,230,219,0.56)] h-[30px] relative rounded-[8px] shrink-0 w-full\" data-node-id=\"924:89\" data-name=\"翻页样式\">\n                      <div className=\"bg-clip-padding border-0 border-[transparent] border-solid gap-x-[2px] gap-y-[2px] grid grid-cols-[______46.80px_46.80px_46.80px_46.80px_46.80px_0px] grid-rows-[_24px] p-[3px] relative size-full\">\n                        <div className=\"col-1 justify-self-stretch min-h-[24px] relative rounded-[6px] row-1 self-stretch shrink-0\" data-node-id=\"924:90\" data-name=\"Button\">\n                          <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-center justify-center min-h-[inherit] overflow-clip px-[3px] relative rounded-[inherit] size-full\">\n                            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Medium'] font-medium leading-[normal] relative shrink-0 text-[#5b5046] text-[9px] text-center whitespace-nowrap\" data-node-id=\"924:91\">\n                              覆盖\n                            </p>\n                          </div>\n                        </div>\n                        <div className=\"col-2 justify-self-stretch min-h-[24px] relative rounded-[6px] row-1 self-stretch shrink-0\" data-node-id=\"924:93\" data-name=\"Button\">\n                          <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-center justify-center min-h-[inherit] overflow-clip px-[3px] relative rounded-[inherit] size-full\">\n                            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Medium'] font-medium leading-[normal] relative shrink-0 text-[#5b5046] text-[9px] text-center whitespace-nowrap\" data-node-id=\"924:94\">\n                              滑动\n                            </p>\n                          </div>\n                        </div>\n                        <div className=\"col-3 justify-self-stretch min-h-[24px] relative rounded-[6px] row-1 self-stretch shrink-0\" data-node-id=\"924:96\" data-name=\"Button\">\n                          <div className=\"bg-clip-padding border-0 border-[transparent] border-solid content-stretch flex flex-col items-center justify-center min-h-[inherit] overflow-clip px-[3px] relative rounded-[inherit] size-full\">\n                            <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Medium'] font-medium leading-[normal] relative shrink-0 text-[#5b5046] text-[9px] text-center whitespace-nowrap\" data-node-id=\"924:97\">\n                              仿真\n                            </p>\n                          </div>\n                        </div>\n                        <div className=\"col-4 justify-self-stretch min-h-[24px] relative rounded-[6px] row-1 self-stretch shrink-0\" data-node-id=\"924:99\" data-name=\"Button\