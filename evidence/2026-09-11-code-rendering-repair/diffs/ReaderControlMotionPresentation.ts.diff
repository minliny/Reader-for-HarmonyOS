+interface ReaderControlMotionPathEntry<T> { inputs: number[]; path: string; shape: T; }
+/** Cache custom unions/exclusions without changing their overflow or winding. */
+export class ReaderControlMotionPathCache<T> {
+  private entries: Map<string, ReaderControlMotionPathEntry<T>> = new Map();
+  private makePath: (path: string) => T;
+  constructor(makePath: (path: string) => T) { this.makePath = makePath; }
+  sample(key: string, inputs: number[], buildPath: () => string): T {
+    const cached = this.entries.get(key);
+    if (cached !== undefined && cached.inputs.length === inputs.length &&
+      inputs.every((value: number, index: number): boolean => value === cached.inputs[index])) return cached.shape;
+    return this.store(key, inputs, buildPath());
+  }
+  fromPath(key: string, path: string): T { return this.store(key, [], path); }
+  private store(key: string, inputs: number[], path: string): T {
+    const cached = this.entries.get(key);
+    const shape = cached !== undefined && cached.path === path ? cached.shape : this.makePath(path);
+    if (!this.entries.has(key) && this.entries.size >= 32) this.entries.clear();
+    this.entries.set(key, { inputs, path, shape });
+    return shape;
+  }
+}
